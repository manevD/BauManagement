@using BauManagement.Components.Account.Shared
@using BauManagement.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICurrentCompanyContext CurrentCompany
@inject SubscriptionService SubscriptionService
@inject NavigationManager NavigationManager

@if (isLoading)
{
    <div class="subscription-loading">
        <div class="subscription-loading-spinner"></div>
        <div>Bitte laden...</div>
    </div>
}
else if (isBlocked)
{
    <div class="subscription-blocked">

        <div class="subscription-blocked-card">

            <div class="subscription-blocked-icon">
                <i class="bi bi-lock-fill"></i>
            </div>

            <h2>
                Abonnement nicht aktiv
            </h2>

            <p>
                Das Abonnement Ihres Unternehmens ist derzeit nicht aktiv.
                Bitte wenden Sie sich an den Administrator Ihres Unternehmens.
            </p>

        </div>

    </div>
}
else
{
    <AuthorizeRouteView RouteData="RouteData"
                        DefaultLayout="DefaultLayout">

        <NotAuthorized>
            <RedirectToLogin />
        </NotAuthorized>

    </AuthorizeRouteView>
}


@code {

    [Parameter]
    public RouteData RouteData { get; set; } = default!;

    [Parameter]
    public Type? DefaultLayout { get; set; }


    private bool isLoading = true;

    private bool isBlocked = false;


    protected override async Task OnParametersSetAsync()
    {
        await CheckSubscriptionAsync();
    }


    private async Task CheckSubscriptionAsync()
    {
        isLoading = true;
        isBlocked = false;

        try
        {
            // ---------------------------------------------------------
            // Benutzer holen
            // ---------------------------------------------------------

            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user = authState.User;


            // Nicht eingeloggt
            if (user.Identity?.IsAuthenticated != true)
            {
                return;
            }


            // ---------------------------------------------------------
            // Aktuellen Pfad ermitteln
            // ---------------------------------------------------------

            var currentPath =
                NavigationManager
                    .ToBaseRelativePath(
                        NavigationManager.Uri)
                    .Trim('/');


            // ---------------------------------------------------------
            // Mitarbeiter darf Company NICHT öffnen
            // ---------------------------------------------------------

            if (currentPath.Equals(
                    "company",
                    StringComparison.OrdinalIgnoreCase))
            {
                if (user.IsInRole("Mitarbeiter"))
                {
                    isBlocked = true;
                    return;
                }

                // Admin / Owner darf Company öffnen
                return;
            }


            // ---------------------------------------------------------
            // Company ID holen
            // ---------------------------------------------------------

            Guid? companyId;

            try
            {
                companyId =
                    await CurrentCompany
                        .GetCompanyIdAsync();
            }
            catch
            {
                companyId = null;
            }


            // ---------------------------------------------------------
            // Keine Company
            // ---------------------------------------------------------

            if (!companyId.HasValue)
            {
                isBlocked = true;

                // Mitarbeiter bleibt auf Block Page
                if (user.IsInRole("Mitarbeiter"))
                {
                    return;
                }

                // Admin / Owner
                NavigationManager.NavigateTo(
                    "/company",
                    replace: true);

                return;
            }


            // ---------------------------------------------------------
            // Subscription prüfen
            // ---------------------------------------------------------

            var result =
                await SubscriptionService
                    .CanUseApplicationAsync(
                        companyId.Value);


            // ---------------------------------------------------------
            // Subscription aktiv
            // ---------------------------------------------------------

            if (result.IsAllowed)
            {
                isBlocked = false;
                return;
            }


            // ---------------------------------------------------------
            // Subscription NICHT aktiv
            // ---------------------------------------------------------

            isBlocked = true;


            // ---------------------------------------------------------
            // MITARBEITER
            // ---------------------------------------------------------
            // Keine Weiterleitung.
            // Nur Block Page.
            // ---------------------------------------------------------

            if (user.IsInRole("Mitarbeiter"))
            {
                return;
            }


            // ---------------------------------------------------------
            // ADMIN / OWNER
            // ---------------------------------------------------------
            // Zur Company-Seite.
            // Dort kann ein Paket ausgewählt werden.
            // ---------------------------------------------------------

            NavigationManager.NavigateTo(
                "/company",
                replace: true);

            return;
        }
        catch
        {
            // Bei Fehler ebenfalls blockieren
            isBlocked = true;

            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user = authState.User;


            // Mitarbeiter bleibt auf Block Page
            if (user.IsInRole("Mitarbeiter"))
            {
                return;
            }


            // Admin / Owner
            NavigationManager.NavigateTo(
                "/company",
                replace: true);
        }
        finally
        {
            isLoading = false;
        }
    }
}