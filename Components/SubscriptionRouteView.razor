@using BauManagement.Components.Account.Shared
@using BauManagement.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICurrentCompanyContext CurrentCompany
@inject SubscriptionService SubscriptionService
@inject NavigationManager NavigationManager

@if (isLoading)
{
    <div class="subscription-loading">
        <div class="subscription-loading-spinner"></div>
        <div>Bitte laden...</div>
    </div>
}
else
{
    <AuthorizeRouteView RouteData="RouteData"
                        DefaultLayout="DefaultLayout">
        <NotAuthorized>
            <RedirectToLogin />
        </NotAuthorized>
    </AuthorizeRouteView>
}

@code {

    [Parameter]
    public RouteData RouteData { get; set; } = default!;

    [Parameter]
    public Type? DefaultLayout { get; set; }

    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        await CheckSubscriptionAsync();
    }

    private async Task CheckSubscriptionAsync()
    {
        isLoading = true;

        try
        {
            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user = authState.User;

            // ----------------------------------------------------
            // NICHT EINGELOGGT
            // ----------------------------------------------------

            if (user.Identity?.IsAuthenticated != true)
            {
                return;
            }


            // ----------------------------------------------------
            // COMPANY PAGE IMMER ERLAUBEN
            // ----------------------------------------------------

            var currentPath =
                NavigationManager
                    .ToBaseRelativePath(NavigationManager.Uri)
                    .Trim('/');

            if (currentPath.Equals(
                    "company",
                    StringComparison.OrdinalIgnoreCase))
            {
                return;
            }


            // ----------------------------------------------------
            // COMPANY ERMITTELN
            // ----------------------------------------------------

            Guid? companyId = null;

            try
            {
                companyId =
                    await CurrentCompany
                        .GetCompanyIdAsync();
            }
            catch
            {
                companyId = null;
            }


            // ----------------------------------------------------
            // KEINE COMPANY
            // ----------------------------------------------------

            if (!companyId.HasValue)
            {
                NavigationManager.NavigateTo(
                    "/company",
                    replace: true);

                return;
            }


            // ----------------------------------------------------
            // SUBSCRIPTION PRÜFEN
            // ----------------------------------------------------

            var result =
                await SubscriptionService
                    .CanUseApplicationAsync(
                        companyId.Value);


            // ----------------------------------------------------
            // ALLES OK
            // ----------------------------------------------------

            if (result.IsAllowed)
            {
                return;
            }


            // ----------------------------------------------------
            // SUBSCRIPTION NICHT AKTIV
            //
            // WICHTIG:
            // Egal ob Admin, Chef oder Mitarbeiter.
            // ALLE werden blockiert.
            // ----------------------------------------------------

            NavigationManager.NavigateTo(
                "/company",
                replace: true);

            return;
        }
        catch
        {
            // ----------------------------------------------------
            // SICHERHEIT:
            // Wenn Subscription nicht geprüft werden kann,
            // keinen Zugriff auf die Anwendung erlauben.
            // ----------------------------------------------------

            try
            {
                NavigationManager.NavigateTo(
                    "/company",
                    replace: true);
            }
            catch
            {
                // ignore
            }
        }
        finally
        {
            isLoading = false;
        }
    }
}