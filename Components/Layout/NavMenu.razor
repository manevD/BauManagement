
@implements IDisposable

@using Microsoft.AspNetCore.Components.Authorization

@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <i class="bi bi-building me-2"></i>
            BauManagement
        </a>
    </div>
</div>

<input type="checkbox"
       title="Navigation menu"
       class="navbar-toggler" />

<div class="nav-scrollable"
     onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="nav flex-column">

        <AuthorizeView>
            <Authorized>

                @if (context.User.IsInRole("Mitarbeiter"))
                {
                    @* =========================================
                       MITARBEITER
                       ========================================= *@

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="meine-einsaetze">
                            <i class="bi bi-calendar-check nav-icon me-2"></i>
                            Meine Einsätze
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="tasks">
                            <i class="bi bi-check2-square nav-icon me-2"></i>
                            Aufgaben
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="zeiterfassung">
                            <i class="bi bi-stopwatch nav-icon me-2"></i>
                            Zeiterfassung
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="mein-urlaub">
                            <i class="bi bi-calendar2-heart nav-icon me-2"></i>
                            Urlaub
                        </NavLink>
                    </div>
                }
                else
                {
                    @* =========================================
                       FIRMA & ABRECHNUNG
                       ========================================= *@

                    <div class="px-4 pt-3 pb-1 small text-uppercase text-secondary fw-bold">
                        Firma & Abrechnung
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="company">
                            <i class="bi bi-building nav-icon me-2"></i>
                            Firma
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/rechnungen">
                            <i class="bi bi-journal-text nav-icon me-2"></i>
                            Rechnungsverwaltung
                        </NavLink>
                    </div>

                    @* =========================================
                       BAUSTELLEN & PLANUNG
                       ========================================= *@

                    <div class="px-4 pt-4 pb-1 small text-uppercase text-secondary fw-bold">
                        Baustellen & Planung
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="baustellen">
                            <i class="bi bi-cone-striped nav-icon me-2"></i>
                            Baustellen
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="assignments">
                            <i class="bi bi-calendar-week nav-icon me-2"></i>
                            Disposition
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="chef-kalender">
                            <i class="bi bi-calendar3 nav-icon me-2"></i>
                            Chef Kalender
                        </NavLink>
                    </div>

                    @* =========================================
                       MITARBEITER
                       ========================================= *@

                    <div class="px-4 pt-4 pb-1 small text-uppercase text-secondary fw-bold">
                        Personal
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="mitarbeiter">
                            <i class="bi bi-people nav-icon me-2"></i>
                            Mitarbeiter
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="mitarbeiter-kalender">
                            <i class="bi bi-calendar-check nav-icon me-2"></i>
                            Mitarbeiter Kalender
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="arbeitszeiten">
                            <i class="bi bi-stopwatch nav-icon me-2"></i>
                            Arbeitszeiten
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="mitarbeiter-urlaub">
                            <i class="bi bi-calendar2-heart nav-icon me-2"></i>
                            Mitarbeiter Urlaub
                        </NavLink>
                    </div>

                    @* =========================================
                       AUFGABEN
                       ========================================= *@

                    <div class="px-4 pt-4 pb-1 small text-uppercase text-secondary fw-bold">
                        Aufgaben
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="tasks">
                            <i class="bi bi-check2-square nav-icon me-2"></i>
                            Aufgabenübersicht
                        </NavLink>
                    </div>
                }

                @* =========================================
                   KONTO & APP
                   ========================================= *@

                <div class="px-4 pt-4 pb-1 small text-uppercase text-secondary fw-bold">
                    Konto
                </div>

                <div class="nav-item px-3">
                    <button type="button"
                            id="installAppBtn"
                            class="nav-link app-install-button"
                            onclick="event.stopPropagation(); pwaInstall.install()">
                        <i class="bi bi-phone-fill nav-icon me-2"></i>
                        App installieren
                    </button>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <i class="bi bi-person-fill nav-icon me-2"></i>
                        @context.User.Identity?.Name
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />

                        <input type="hidden"
                               name="ReturnUrl"
                               value="@currentUrl" />

                        <button type="submit" class="nav-link">
                            <i class="bi bi-box-arrow-right nav-icon me-2"></i>
                            Logout
                        </button>
                    </form>
                </div>

            </Authorized>

            <NotAuthorized>
                @* =========================================
                   NICHT ANGEMELDET
                   ========================================= *@

                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href=""
                             Match="NavLinkMatch.All">
                        <i class="bi bi-house-door-fill nav-icon me-2"></i>
                        Home
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <i class="bi bi-person-plus nav-icon me-2"></i>
                        Register
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <i class="bi bi-box-arrow-in-right nav-icon me-2"></i>
                        Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(
            NavigationManager.Uri);

        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(
        object? sender,
        LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
