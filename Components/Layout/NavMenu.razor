@implements IDisposable

@using Microsoft.AspNetCore.Components.Authorization

@inject NavigationManager NavigationManager

<div class="top-row">
    <a class="navbar-brand" href="">
        <span class="brand-mark">
            <i class="bi bi-buildings-fill"></i>
        </span>
        <span class="brand-text">
            <strong>BauManagement</strong>
            <small>Baustellen &amp; Personal</small>
        </span>
    </a>
</div>

<input type="checkbox"
       title="Navigation menu"
       class="navbar-toggler" />

<div class="nav-scrollable"
     onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="nav flex-column">

        <AuthorizeView>
            <Authorized>

                @if (context.User.IsInRole("Mitarbeiter"))
                {
                    @* =========================================
                       MITARBEITER
                       ========================================= *@

                    <div class="nav-section">Mein Bereich</div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="meine-einsaetze">
                            <i class="bi bi-calendar-check nav-icon"></i>
                            <span>Meine Einsätze</span>
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="tasks">
                            <i class="bi bi-check2-square nav-icon"></i>
                            <span>Aufgaben</span>
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="zeiterfassung">
                            <i class="bi bi-stopwatch nav-icon"></i>
                            <span>Zeiterfassung</span>
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="mein-urlaub">
                            <i class="bi bi-calendar2-heart nav-icon"></i>
                            <span>Urlaub</span>
                        </NavLink>
                    </div>
                }
                else
                {
                    @* =========================================
                       FIRMA & ABRECHNUNG
                       ========================================= *@

                    <div class="nav-section">Firma &amp; Abrechnung</div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="company">
                            <i class="bi bi-building nav-icon"></i>
                            <span>Firma</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="admin/rechnungen">
                            <i class="bi bi-journal-text nav-icon"></i>
                            <span>Rechnungsverwaltung</span>
                        </NavLink>
                    </div>

                    @* =========================================
                       BAUSTELLEN & PLANUNG
                       ========================================= *@

                    <div class="nav-section">Baustellen &amp; Planung</div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="baustellen">
                            <i class="bi bi-cone-striped nav-icon"></i>
                            <span>Baustellen</span>
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="assignments">
                            <i class="bi bi-calendar-week nav-icon"></i>
                            <span>Disposition</span>
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="chef-kalender">
                            <i class="bi bi-calendar3 nav-icon"></i>
                            <span>Chef Kalender</span>
                        </NavLink>
                    </div>

                    @* =========================================
                       MITARBEITER
                       ========================================= *@

                    <div class="nav-section">Personal</div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="mitarbeiter">
                            <i class="bi bi-people nav-icon"></i>
                            <span>Mitarbeiter</span>
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="mitarbeiter-kalender">
                            <i class="bi bi-calendar-check nav-icon"></i>
                            <span>Mitarbeiter Kalender</span>
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="arbeitszeiten">
                            <i class="bi bi-stopwatch nav-icon"></i>
                            <span>Arbeitszeiten</span>
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="mitarbeiter-urlaub">
                            <i class="bi bi-calendar2-heart nav-icon"></i>
                            <span>Mitarbeiter Urlaub</span>
                        </NavLink>
                    </div>

                    @* =========================================
                       AUFGABEN
                       ========================================= *@

                    <div class="nav-section">Aufgaben</div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="tasks">
                            <i class="bi bi-check2-square nav-icon"></i>
                            <span>Aufgabenübersicht</span>
                        </NavLink>
                    </div>
                }

                @* =========================================
                   KONTO & APP
                   ========================================= *@

                <div class="nav-section">Konto</div>

                <div class="nav-item">
                    <button type="button"
                            id="installAppBtn"
                            class="nav-link app-install-button"
                            onclick="event.stopPropagation(); pwaInstall.install()">
                        <i class="bi bi-phone-fill nav-icon"></i>
                        <span>App installieren</span>
                    </button>
                </div>

                <div class="nav-user">
                    <NavLink class="nav-user-link" href="Account/Manage">
                        <span class="nav-avatar">
                            @GetInitial(context.User.Identity?.Name)
                        </span>
                        <span class="nav-user-text">
                            <strong>@context.User.Identity?.Name</strong>
                            <small>Konto verwalten</small>
                        </span>
                    </NavLink>

                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />

                        <input type="hidden"
                               name="ReturnUrl"
                               value="@currentUrl" />

                        <button type="submit"
                                class="nav-logout"
                                title="Logout"
                                aria-label="Logout">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                </div>

            </Authorized>

            <NotAuthorized>
                @* =========================================
                   NICHT ANGEMELDET
                   ========================================= *@

                <div class="nav-section">Start</div>

                <div class="nav-item">
                    <NavLink class="nav-link"
                             href=""
                             Match="NavLinkMatch.All">
                        <i class="bi bi-house-door nav-icon"></i>
                        <span>Home</span>
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="Account/Register">
                        <i class="bi bi-person-plus nav-icon"></i>
                        <span>Register</span>
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="Account/Login">
                        <i class="bi bi-box-arrow-in-right nav-icon"></i>
                        <span>Login</span>
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(
            NavigationManager.Uri);

        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(
        object? sender,
        LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    private static string GetInitial(string? name)
    {
        return string.IsNullOrWhiteSpace(name)
            ? "?"
            : name.Trim()[0].ToString().ToUpperInvariant();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
