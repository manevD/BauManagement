@using BauManagement.Models
@using BauManagement.Services
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICurrentCompanyContext CurrentCompany
@inject SubscriptionService SubscriptionService
@inject NavigationManager NavigationManager

@if (isLoading)
{
    <div class="subscription-loading">
        <div class="subscription-loading-spinner"></div>
        <div>Bitte laden...</div>
    </div>
}
else if (isBlocked && !IsSubscriptionPage)
{
    <div class="subscription-blocked">

        <div class="subscription-blocked-card">

            <div class="subscription-blocked-icon">
                <i class="bi bi-lock-fill"></i>
            </div>

            <h2>
                @GetTitle()
            </h2>

            <p>
                @GetMessage()
            </p>

            <div class="subscription-blocked-actions">

                <button class="btn btn-subscription"
                        @onclick="OpenSubscription">

                    <i class="bi bi-credit-card me-2"></i>

                    Paket auswählen

                </button>

                <button class="btn btn-logout"
                        @onclick="Logout">

                    <i class="bi bi-box-arrow-right me-2"></i>

                    Abmelden

                </button>

            </div>

        </div>

    </div>
}
else
{
    @ChildContent
}

@code {

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool isLoading = true;

    private bool isBlocked;

    private SubscriptionBlockReason blockReason =
        SubscriptionBlockReason.None;

    private bool IsSubscriptionPage =>
        NavigationManager.Uri.Contains(
            "/subscription",
            StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;

        await CheckSubscriptionAsync();
    }

    private async void OnLocationChanged(
        object? sender,
        LocationChangedEventArgs e)
    {
        await CheckSubscriptionAsync();

        await InvokeAsync(StateHasChanged);
    }

    private async Task CheckSubscriptionAsync()
    {
        try
        {
            isLoading = true;

            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user = authState.User;

            /*
             * Nicht eingeloggte Benutzer werden vom
             * normalen Authentication-System behandelt.
             */
            if (user.Identity?.IsAuthenticated != true)
            {
                isBlocked = false;
                blockReason =
                    SubscriptionBlockReason.None;

                return;
            }

            Guid? companyId;

            try
            {
                companyId =
                    await CurrentCompany.GetCompanyIdAsync();
            }
            catch
            {
                /*
                 * Sicherheitsprinzip:
                 * Wenn CompanyId nicht ermittelt werden kann,
                 * gibt es keinen Zugriff.
                 */
                isBlocked = true;

                blockReason =
                    SubscriptionBlockReason.CompanyNotFound;

                return;
            }

            if (!companyId.HasValue)
            {
                isBlocked = true;

                blockReason =
                    SubscriptionBlockReason.CompanyNotFound;

                return;
            }

            /*
             * EINZIGE Subscription-Prüfung.
             */
            var result =
                await SubscriptionService
                    .CanUseApplicationAsync(companyId.Value);

            isBlocked = !result.IsAllowed;

            blockReason = result.Reason;
        }
        catch
        {
            /*
             * FAIL CLOSED
             *
             * Wenn die Subscription nicht geprüft werden kann,
             * wird der Zugriff verweigert.
             */
            isBlocked = true;

            blockReason =
                SubscriptionBlockReason.Unknown;
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetTitle()
    {
        return blockReason switch
        {
            SubscriptionBlockReason.Cancelled =>
                "Ihr Abonnement wurde gekündigt",

            SubscriptionBlockReason.Expired =>
                "Ihr Abonnement ist abgelaufen",

            SubscriptionBlockReason.TrialExpired =>
                "Ihre Testphase ist abgelaufen",

            SubscriptionBlockReason.PastDue =>
                "Zahlungsproblem mit Ihrem Abonnement",

            SubscriptionBlockReason.SubscriptionInactive =>
                "Ihr Abonnement ist nicht aktiv",

            SubscriptionBlockReason.SubscriptionExpired =>
                "Ihr Abonnement ist abgelaufen",

            SubscriptionBlockReason.CompanyNotFound =>
                "Kein aktives Firmenkonto gefunden",

            _ =>
                "Ihr Abonnement ist nicht aktiv"
        };
    }

    private string GetMessage()
    {
        return blockReason switch
        {
            SubscriptionBlockReason.Cancelled =>
                "Ihr Abonnement wurde gekündigt. Ihre Daten bleiben erhalten. Sie können jederzeit ein neues Paket auswählen.",

            SubscriptionBlockReason.Expired =>
                "Ihr Abonnement ist abgelaufen. Ihre Daten bleiben erhalten. Wählen Sie ein neues Paket, um MyBauManagement wieder zu verwenden.",

            SubscriptionBlockReason.TrialExpired =>
                "Ihre kostenlose Testphase ist abgelaufen. Wählen Sie ein Paket, um MyBauManagement weiter zu verwenden.",

            SubscriptionBlockReason.PastDue =>
                "Bei Ihrem Abonnement ist ein Zahlungsproblem aufgetreten. Bitte wählen Sie ein Paket oder aktualisieren Sie Ihre Zahlungsdaten.",

            SubscriptionBlockReason.SubscriptionInactive =>
                "Ihr Abonnement ist derzeit nicht aktiv.",

            SubscriptionBlockReason.SubscriptionExpired =>
                "Ihr Abonnement ist abgelaufen. Wählen Sie ein neues Paket, um fortzufahren.",

            SubscriptionBlockReason.CompanyNotFound =>
                "Für Ihr Benutzerkonto konnte kein gültiges Firmenkonto gefunden werden.",

            _ =>
                "Der Zugriff auf die Anwendung ist derzeit nicht möglich."
        };
    }

    private void OpenSubscription()
    {
        NavigationManager.NavigateTo(
            "/subscription");
    }

    private void Logout()
    {
        NavigationManager.NavigateTo(
            "/Account/Logout",
            forceLoad: true);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -=
            OnLocationChanged;
    }
}