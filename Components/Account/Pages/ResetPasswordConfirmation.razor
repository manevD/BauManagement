
@page "/Account/ResetPasswordConfirmation"

@layout BauManagement.Components.Layout.AuthLayout

<PageTitle>Passwort zurückgesetzt – BauManagement</PageTitle>

<div class="login-page">

    <!-- Background -->
    <div class="login-background">
        <div class="glow glow-1"></div>
        <div class="glow glow-2"></div>
        <div class="grid-lines"></div>

        <div class="construction-shape shape-left">
            <div class="crane-tower"></div>
            <div class="crane-arm"></div>
        </div>

        <div class="construction-shape shape-right">
            <div class="building building-1"></div>
            <div class="building building-2"></div>
            <div class="building building-3"></div>
        </div>
    </div>

    <div class="login-container">

        <!-- Brand -->
        <div class="login-top">
            <a href="/" class="brand-back">
                <span class="back-arrow">←</span>

                <span class="brand-name">
                    <span class="brand-orange">Bau</span>Management
                </span>
            </a>
        </div>

        <!-- Confirmation Card -->
        <div class="login-card">

            <!-- Success Icon -->
            <div class="login-logo">
                <div class="logo-inner success-logo">
                    <span class="logo-icon">
                        <i class="bi bi-check-circle"></i>
                    </span>
                </div>
            </div>

            <!-- Header -->
            <div class="login-header">
                <h1>
                    Passwort
                    <span>zurückgesetzt!</span>
                </h1>

                <p>
                    Ihr Passwort wurde erfolgreich geändert.
                    Sie können sich jetzt mit Ihrem neuen Passwort
                    bei BauManagement anmelden.
                </p>
            </div>

            <!-- Success Message -->
            <div class="success-message" role="status">
                <span class="success-message-icon">
                    <i class="bi bi-shield-check"></i>
                </span>

                <div>
                    <strong>Änderung erfolgreich</strong>
                    <p>
                        Ihr Konto ist bereit. Verwenden Sie ab jetzt
                        Ihr neues Passwort für die Anmeldung.
                    </p>
                </div>
            </div>

            <!-- Login Button -->
            <a href="/Account/Login"
               class="login-button confirmation-button">

                <span>Jetzt anmelden</span>

                <span class="button-arrow">→</span>
            </a>

            <!-- Divider -->
            <div class="login-divider">
                <span></span>
                <small>BauManagement</small>
                <span></span>
            </div>

            <!-- Home Link -->
            <div class="login-links">
                <a href="/" class="login-link">

                    <span class="link-icon">
                        <i class="bi bi-house"></i>
                    </span>

                    <span>Zurück zur Startseite</span>

                    <span class="link-arrow">→</span>
                </a>
            </div>

        </div>

        <!-- Footer -->
        <div class="login-footer">
            <span>MyBauManagement</span>
            <span>•</span>
            <span>Webolar</span>
        </div>

    </div>
</div>

<style>
    .success-logo {
        border-color: rgba(255, 122, 0, .5);
    }

    .success-logo .logo-icon {
        color: #ff7a00;
        font-size: 31px;
    }

    .success-message {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 15px;
        margin-bottom: 22px;
        background: rgba(255, 122, 0, .06);
        border: 1px solid rgba(255, 122, 0, .2);
        border-radius: 12px;
    }

    .success-message-icon {
        flex: 0 0 36px;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: rgba(255, 122, 0, .1);
        color: #ff7a00;
        font-size: 18px;
    }

    .success-message strong {
        display: block;
        margin-bottom: 4px;
        color: #f1f1f1;
        font-size: .86rem;
    }

    .success-message p {
        margin: 0;
        color: #888;
        font-size: .8rem;
        line-height: 1.55;
    }

    .confirmation-button {
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
    }

    .confirmation-button:hover {
        color: #fff;
    }
</style>
