
@page "/Account/ForgotPassword"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using BauManagement.Data

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ForgotPassword> Logger

@layout BauManagement.Components.Layout.AuthLayout

<PageTitle>Passwort vergessen – BauManagement</PageTitle>

<div class="login-page">

    <!-- Background: gleicher Stil wie Login -->
    <div class="login-background">
        <div class="glow glow-1"></div>
        <div class="glow glow-2"></div>
        <div class="grid-lines"></div>

        <div class="construction-shape shape-left">
            <div class="crane-tower"></div>
            <div class="crane-arm"></div>
        </div>

        <div class="construction-shape shape-right">
            <div class="building building-1"></div>
            <div class="building building-2"></div>
            <div class="building building-3"></div>
        </div>
    </div>

    <div class="login-container">

        <!-- Brand -->
        <div class="login-top">
            <a href="/" class="brand-back">
                <span class="back-arrow">←</span>

                <span class="brand-name">
                    <span class="brand-orange">Bau</span>Management
                </span>
            </a>
        </div>

        <!-- Card -->
        <div class="login-card">

            <!-- Logo -->
            <div class="login-logo">
                <div class="logo-inner">
                    <span class="logo-icon">
                        <i class="bi bi-key"></i>
                    </span>
                </div>
            </div>

            <!-- Header -->
            <div class="login-header">
                <h1>
                    Passwort
                    <span>vergessen?</span>
                </h1>

                <p>
                    Kein Problem! Geben Sie Ihre E-Mail-Adresse ein.
                    Wir senden Ihnen einen Link zum Zurücksetzen
                    Ihres Passworts.
                </p>
            </div>

            <!-- Error -->
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="login-error" role="alert">
                    <div class="error-icon">!</div>
                    <div>@ErrorMessage</div>
                </div>
            }

            <!-- Form -->
            <EditForm Model="Input"
                      FormName="forgot-password"
                      OnValidSubmit="OnValidSubmitAsync"
                      method="post">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary"
                                   role="alert" />

                <!-- E-Mail -->
                <div class="login-field">
                    <div class="field-icon">
                        <i class="bi bi-envelope"></i>
                    </div>

                    <div class="field-content">
                        <label for="Input.Email">
                            E-Mail-Adresse
                        </label>

                        <InputText @bind-Value="Input.Email"
                                   id="Input.Email"
                                   class="form-control"
                                   autocomplete="email"
                                   aria-required="true"
                                   placeholder="name@example.de" />
                    </div>
                </div>

                <ValidationMessage For="() => Input.Email"
                                   class="field-validation" />

                <!-- Submit -->
                <button type="submit" class="login-button">
                    <span>Reset-Link senden</span>
                    <span class="button-arrow">→</span>
                </button>

            </EditForm>

            <!-- Divider -->
            <div class="login-divider">
                <span></span>
                <small>oder</small>
                <span></span>
            </div>

            <!-- Back to login -->
            <div class="login-links">
                <a href="/Account/Login" class="login-link">
                    <span class="link-icon">
                        <i class="bi bi-arrow-left"></i>
                    </span>

                    <span>Zurück zur Anmeldung</span>

                    <span class="link-arrow">→</span>
                </a>
            </div>

        </div>

        <!-- Footer -->
        <div class="login-footer">
            <span>MyBauManagement</span>
            <span>•</span>
            <span>Webolar</span>
        </div>

    </div>
</div>

@code {
    private string? ErrorMessage;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task OnValidSubmitAsync()
    {
        ErrorMessage = null;

        var email = Input.Email.Trim();

        var user = await UserManager.FindByEmailAsync(email);

        // Aus Sicherheitsgründen nicht verraten,
        // ob ein Konto mit dieser E-Mail existiert.
        if (user is null ||
            !await UserManager.IsEmailConfirmedAsync(user))
        {
            RedirectManager.RedirectTo(
                "Account/ForgotPasswordConfirmation");

            return;
        }

        var code =
            await UserManager.GeneratePasswordResetTokenAsync(user);

        code = WebEncoders.Base64UrlEncode(
            Encoding.UTF8.GetBytes(code));

        var callbackUrl =
            NavigationManager.GetUriWithQueryParameters(
                NavigationManager.ToAbsoluteUri(
                    "Account/ResetPassword").AbsoluteUri,
                new Dictionary<string, object?>
                {
                    ["code"] = code
                });

        try
        {
            await EmailSender.SendPasswordResetLinkAsync(
                user,
                email,
                HtmlEncoder.Default.Encode(callbackUrl));
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Fehler beim Senden des Passwort-Reset-Links.");

            ErrorMessage =
                "Der Link konnte momentan nicht gesendet werden. " +
                "Bitte versuchen Sie es später erneut.";

            return;
        }

        RedirectManager.RedirectTo(
            "Account/ForgotPasswordConfirmation");
    }

    private sealed class InputModel
    {
        [Required(
            ErrorMessage =
                "Bitte geben Sie Ihre E-Mail-Adresse ein.")]
        [EmailAddress(
            ErrorMessage =
                "Bitte geben Sie eine gültige E-Mail-Adresse ein.")]
        [Display(Name = "E-Mail-Adresse")]
        public string Email { get; set; } = string.Empty;
    }
}
