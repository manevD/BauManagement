
@page "/Account/ResetPassword"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using BauManagement.Data

@inject IdentityRedirectManager RedirectManager
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<ResetPassword> Logger

@layout BauManagement.Components.Layout.AuthLayout

<PageTitle>Passwort zurücksetzen – BauManagement</PageTitle>

<div class="login-page">

    <!-- Background: gleicher Stil wie Login -->
    <div class="login-background">
        <div class="glow glow-1"></div>
        <div class="glow glow-2"></div>
        <div class="grid-lines"></div>

        <div class="construction-shape shape-left">
            <div class="crane-tower"></div>
            <div class="crane-arm"></div>
        </div>

        <div class="construction-shape shape-right">
            <div class="building building-1"></div>
            <div class="building building-2"></div>
            <div class="building building-3"></div>
        </div>
    </div>

    <div class="login-container">

        <!-- Brand -->
        <div class="login-top">
            <a href="/" class="brand-back">
                <span class="back-arrow">←</span>

                <span class="brand-name">
                    <span class="brand-orange">Bau</span>Management
                </span>
            </a>
        </div>

        <!-- Card -->
        <div class="login-card">

            <!-- Logo -->
            <div class="login-logo">
                <div class="logo-inner">
                    <span class="logo-icon">
                        <i class="bi bi-shield-lock"></i>
                    </span>
                </div>
            </div>

            <!-- Header -->
            <div class="login-header">
                <h1>
                    Passwort
                    <span>zurücksetzen</span>
                </h1>

                <p>
                    Legen Sie ein neues Passwort für Ihr Konto fest.
                    Verwenden Sie ein sicheres Passwort, das Sie
                    noch nicht für andere Dienste nutzen.
                </p>
            </div>

            <!-- Error / Status -->
            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                <div class="login-error" role="alert">
                    <div class="error-icon">!</div>
                    <div>@StatusMessage</div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(GeneralError))
            {
                <div class="login-error" role="alert">
                    <div class="error-icon">!</div>
                    <div>@GeneralError</div>
                </div>
            }

            @if (TokenInvalid)
            {
                <div class="login-links">
                    <a href="/Account/ForgotPassword" class="login-link">
                        <span class="link-icon">
                            <i class="bi bi-envelope"></i>
                        </span>

                        <span>Neuen Reset-Link anfordern</span>

                        <span class="link-arrow">→</span>
                    </a>
                </div>
            }
            else
            {
                <EditForm Model="Input"
                          FormName="reset-password"
                          OnValidSubmit="OnValidSubmitAsync"
                          method="post">

                    <DataAnnotationsValidator />

                    <ValidationSummary class="validation-summary"
                                       role="alert" />

                    <input type="hidden"
                           name="Input.Code"
                           value="@Input.Code" />

                    <!-- E-Mail -->
                    <div class="login-field">
                        <div class="field-icon">
                            <i class="bi bi-envelope"></i>
                        </div>

                        <div class="field-content">
                            <label for="Input.Email">
                                E-Mail-Adresse
                            </label>

                            <InputText @bind-Value="Input.Email"
                                       id="Input.Email"
                                       class="form-control"
                                       autocomplete="email"
                                       aria-required="true"
                                       placeholder="name@example.de" />
                        </div>
                    </div>

                    <ValidationMessage For="() => Input.Email"
                                       class="field-validation" />

                    <!-- Neues Passwort -->
                    <div class="login-field">
                        <div class="field-icon">
                            <i class="bi bi-lock"></i>
                        </div>

                        <div class="field-content">
                            <label for="Input.Password">
                                Neues Passwort
                            </label>

                            <InputText type="password"
                                       @bind-Value="Input.Password"
                                       id="Input.Password"
                                       class="form-control"
                                       autocomplete="new-password"
                                       aria-required="true"
                                       placeholder="Neues Passwort eingeben" />
                        </div>
                    </div>

                    <ValidationMessage For="() => Input.Password"
                                       class="field-validation" />

                    <!-- Passwort bestätigen -->
                    <div class="login-field">
                        <div class="field-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <div class="field-content">
                            <label for="Input.ConfirmPassword">
                                Passwort bestätigen
                            </label>

                            <InputText type="password"
                                       @bind-Value="Input.ConfirmPassword"
                                       id="Input.ConfirmPassword"
                                       class="form-control"
                                       autocomplete="new-password"
                                       aria-required="true"
                                       placeholder="Passwort erneut eingeben" />
                        </div>
                    </div>

                    <ValidationMessage For="() => Input.ConfirmPassword"
                                       class="field-validation" />

                    <!-- Submit -->
                    <button type="submit" class="login-button">
                        <span>Passwort speichern</span>
                        <span class="button-arrow">→</span>
                    </button>

                </EditForm>
            }

            <!-- Divider -->
            <div class="login-divider">
                <span></span>
                <small>oder</small>
                <span></span>
            </div>

            <!-- Back to login -->
            <div class="login-links">
                <a href="/Account/Login" class="login-link">
                    <span class="link-icon">
                        <i class="bi bi-arrow-left"></i>
                    </span>

                    <span>Zurück zur Anmeldung</span>

                    <span class="link-arrow">→</span>
                </a>
            </div>

        </div>

        <!-- Footer -->
        <div class="login-footer">
            <span>MyBauManagement</span>
            <span>•</span>
            <span>Webolar</span>
        </div>

    </div>
</div>

@code {
    private IEnumerable<IdentityError>? IdentityErrors;
    private string? GeneralError;
    private bool TokenInvalid;

    private string? StatusMessage =>
        IdentityErrors is null
            ? null
            : string.Join(" ", IdentityErrors.Select(error =>
                TranslateIdentityError(error)));

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new();

        if (string.IsNullOrWhiteSpace(Code))
        {
            TokenInvalid = true;
            GeneralError =
                "Der Link zum Zurücksetzen des Passworts ist ungültig " +
                "oder unvollständig.";
            return;
        }

        try
        {
            Input.Code = Encoding.UTF8.GetString(
                WebEncoders.Base64UrlDecode(Code));
        }
        catch (FormatException)
        {
            TokenInvalid = true;
            GeneralError =
                "Der Link zum Zurücksetzen des Passworts ist ungültig. " +
                "Bitte fordern Sie einen neuen Link an.";
        }
    }

    private async Task OnValidSubmitAsync()
    {
        GeneralError = null;
        IdentityErrors = null;

        if (string.IsNullOrWhiteSpace(Input.Code))
        {
            TokenInvalid = true;
            GeneralError =
                "Der Reset-Link ist ungültig. Bitte fordern Sie einen " +
                "neuen Link an.";
            return;
        }

        var user = await UserManager.FindByEmailAsync(
            Input.Email.Trim());

        if (user is null)
        {
            // Nicht offenlegen, ob das Konto existiert.
            RedirectManager.RedirectTo(
                "Account/ResetPasswordConfirmation");
            return;
        }

        var result = await UserManager.ResetPasswordAsync(
            user,
            Input.Code,
            Input.Password);

        if (result.Succeeded)
        {
            RedirectManager.RedirectTo(
                "Account/ResetPasswordConfirmation");
            return;
        }

        Logger.LogWarning(
            "Das Zurücksetzen des Passworts ist fehlgeschlagen.");

        IdentityErrors = result.Errors.ToList();
    }

    private static string TranslateIdentityError(IdentityError error)
    {
        return error.Code switch
        {
            "PasswordTooShort" =>
                "Das Passwort ist zu kurz.",

            "PasswordRequiresNonAlphanumeric" =>
                "Das Passwort muss mindestens ein Sonderzeichen enthalten.",

            "PasswordRequiresDigit" =>
                "Das Passwort muss mindestens eine Zahl enthalten.",

            "PasswordRequiresLower" =>
                "Das Passwort muss mindestens einen Kleinbuchstaben enthalten.",

            "PasswordRequiresUpper" =>
                "Das Passwort muss mindestens einen Großbuchstaben enthalten.",

            "PasswordRequiresUniqueChars" =>
                "Das Passwort enthält nicht genügend unterschiedliche Zeichen.",

            "InvalidToken" =>
                "Der Reset-Link ist ungültig oder abgelaufen. " +
                "Bitte fordern Sie einen neuen Link an.",

            _ => error.Description
        };
    }

    private sealed class InputModel
    {
        [Required(
            ErrorMessage = "Bitte geben Sie Ihre E-Mail-Adresse ein.")]
        [EmailAddress(
            ErrorMessage = "Bitte geben Sie eine gültige E-Mail-Adresse ein.")]
        [Display(Name = "E-Mail-Adresse")]
        public string Email { get; set; } = string.Empty;

        [Required(
            ErrorMessage = "Bitte geben Sie ein neues Passwort ein.")]
        [StringLength(
            100,
            MinimumLength = 6,
            ErrorMessage =
                "Das Passwort muss mindestens {2} und höchstens {1} Zeichen lang sein.")]
        [DataType(DataType.Password)]
        [Display(Name = "Neues Passwort")]
        public string Password { get; set; } = string.Empty;

        [Required(
            ErrorMessage = "Bitte bestätigen Sie Ihr Passwort.")]
        [DataType(DataType.Password)]
        [Compare(
            nameof(Password),
            ErrorMessage =
                "Die Passwörter stimmen nicht überein.")]
        [Display(Name = "Passwort bestätigen")]
        public string ConfirmPassword { get; set; } = string.Empty;

        [Required]
        public string Code { get; set; } = string.Empty;
    }
}
