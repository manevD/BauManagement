@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using BauManagement.Data
@using BauManagement.Models

@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject SignInManager<ApplicationUser> SignInManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject ApplicationDbContext Db

@layout BauManagement.Components.Layout.AuthLayout

<PageTitle>Firma registrieren – BauManagement</PageTitle>

<div class="register-container">

    <div class="register-heading">
        <h1>Deine Firma einrichten</h1>
        <p>In wenigen Minuten zu deiner digitalen Baustellenplanung.</p>
    </div>

    <StatusMessage Message="@Message" />

    <EditForm Model="Input"
              method="post"
              OnValidSubmit="RegisterUser"
              FormName="register"
              class="register-card">

        <DataAnnotationsValidator />

        <div class="register-card-body">

            <ValidationSummary class="text-danger validation-summary"
                               role="alert" />

            <!-- =========================================
                 1. FIRMENDATEN
                 ========================================= -->

            <section class="register-section">

                <div class="section-title">
                    <span>1</span>

                    <div>
                        <h3>Firmendaten</h3>
                        <p>Informationen zu deinem Unternehmen</p>
                    </div>
                </div>

                <div class="row g-3">

                    <div class="col-12">

                        <label class="register-label">
                            Firmenname <span>*</span>
                        </label>

                        <InputText @bind-Value="Input.CompanyName"
                                   class="form-control register-input"
                                   placeholder="z. B. Müller Bau GmbH" />

                        <ValidationMessage For="() => Input.CompanyName"
                                           class="text-danger" />

                    </div>

                    <div class="col-md-7">

                        <label class="register-label">
                            Adresse
                        </label>

                        <InputText @bind-Value="Input.Address"
                                   class="form-control register-input"
                                   placeholder="Musterstraße 12" />

                    </div>

                    <div class="col-md-2">

                        <label class="register-label">
                            PLZ
                        </label>

                        <InputText @bind-Value="Input.PostalCode"
                                   class="form-control register-input"
                                   placeholder="10115" />

                    </div>

                    <div class="col-md-3">

                        <label class="register-label">
                            Ort
                        </label>

                        <InputText @bind-Value="Input.City"
                                   class="form-control register-input"
                                   placeholder="Berlin" />

                    </div>

                    <div class="col-12">

                        <label class="register-label">
                            Telefon
                        </label>

                        <InputText @bind-Value="Input.Phone"
                                   class="form-control register-input"
                                   placeholder="+49 30 1234567" />

                    </div>

                </div>

            </section>


            <!-- =========================================
                 2. PAKET
                 ========================================= -->

            <section class="register-section">

                <div class="section-title">

                    <span>2</span>

                    <div>
                        <h3>Paket auswählen</h3>
                        <p>Wähle den passenden Tarif für dein Team</p>
                    </div>

                </div>


               <InputRadioGroup @bind-Value="Input.SubscriptionPlan">

    <div class="plan-grid">

        <!-- S -->

        <label class="plan-card @(Input.SubscriptionPlan == SubscriptionPlan.S ? "selected" : "")">

            <InputRadio Value="SubscriptionPlan.S"
                        class="plan-radio" />

            <div class="plan-content">

                <strong>S – Starter</strong>

                <div class="plan-price">
                    20 €
                    <span>/ Monat</span>
                </div>

                <div class="plan-employees">
                    Bis 5 Mitarbeiter
                </div>

            </div>

        </label>


        <!-- M -->

        <label class="plan-card @(Input.SubscriptionPlan == SubscriptionPlan.M ? "selected" : "")">

            <InputRadio Value="SubscriptionPlan.M"
                        class="plan-radio" />

            <div class="plan-content">

                <strong>M – Team</strong>

                <div class="plan-price">
                    50 €
                    <span>/ Monat</span>
                </div>

                <div class="plan-employees">
                    Bis 10 Mitarbeiter
                </div>

            </div>

        </label>


        <!-- L -->

        <label class="plan-card @(Input.SubscriptionPlan == SubscriptionPlan.L ? "selected" : "")">

            <InputRadio Value="SubscriptionPlan.L"
                        class="plan-radio" />

            <div class="plan-content">

                <strong>L – Business</strong>

                <div class="plan-price">
                    100 €
                    <span>/ Monat</span>
                </div>

                <div class="plan-employees">
                    Bis 20 Mitarbeiter
                </div>

            </div>

        </label>


        <!-- XL -->

        <label class="plan-card @(Input.SubscriptionPlan == SubscriptionPlan.XL ? "selected" : "")">

            <InputRadio Value="SubscriptionPlan.XL"
                        class="plan-radio" />

            <div class="plan-content">

                <strong>XL – Profi</strong>

                <div class="plan-price">
                    200 €
                    <span>/ Monat</span>
                </div>

                <div class="plan-employees">
                    Über 20 Mitarbeiter
                </div>

            </div>

        </label>

    </div>

</InputRadioGroup>

            </section>


            <!-- =========================================
                 3. ZAHLUNG
                 ========================================= -->

            <section class="register-section">

                <div class="section-title">

                    <span>3</span>

                    <div>
                        <h3>Zahlungsdaten</h3>
                        <p>Sichere Zahlung über Stripe</p>
                    </div>

                </div>


                <div class="stripe-box">

                    <div class="stripe-icon">
                        <i class="bi bi-lock-fill"></i>
                    </div>

                    <div class="stripe-info">

                        <strong>Sichere Zahlung mit Stripe</strong>

                        <span>
                            Deine Zahlungsdaten werden sicher über Stripe verarbeitet.
                        </span>

                    </div>

                    <div class="stripe-logo">
                        stripe
                    </div>

                </div>


                <div class="stripe-note">

                    <i class="bi bi-info-circle"></i>

                    <span>
                        Die Zahlungsabwicklung wird nach der kostenlosen
                        Testphase aktiviert.
                    </span>

                </div>

            </section>


            <!-- =========================================
                 4. ZUGANG
                 ========================================= -->

            <section class="register-section register-section-last">

                <div class="section-title">

                    <span>4</span>

                    <div>
                        <h3>Zugang erstellen</h3>
                        <p>Deine Zugangsdaten für BauManagement</p>
                    </div>

                </div>


                <div class="row g-3">

                    <div class="col-12">

                        <label class="register-label">
                            E-Mail-Adresse <span>*</span>
                        </label>

                        <InputText @bind-Value="Input.Email"
                                   id="Input.Email"
                                   class="form-control register-input"
                                   autocomplete="username"
                                   aria-required="true"
                                   placeholder="name@example.com" />

                        <ValidationMessage For="() => Input.Email"
                                           class="text-danger" />

                    </div>


                    <div class="col-md-6">

                        <label class="register-label">
                            Passwort <span>*</span>
                        </label>

                        <InputText type="password"
                                   @bind-Value="Input.Password"
                                   id="Input.Password"
                                   class="form-control register-input"
                                   autocomplete="new-password"
                                   aria-required="true"
                                   placeholder="Passwort" />

                        <ValidationMessage For="() => Input.Password"
                                           class="text-danger" />

                    </div>


                    <div class="col-md-6">

                        <label class="register-label">
                            Passwort bestätigen <span>*</span>
                        </label>

                        <InputText type="password"
                                   @bind-Value="Input.ConfirmPassword"
                                   id="Input.ConfirmPassword"
                                   class="form-control register-input"
                                   autocomplete="new-password"
                                   aria-required="true"
                                   placeholder="Passwort wiederholen" />

                        <ValidationMessage For="() => Input.ConfirmPassword"
                                           class="text-danger" />

                    </div>

                </div>

            </section>


            <!-- =========================================
                 SUBMIT
                 ========================================= -->

            <button type="submit"
                    class="register-submit">

                Firma registrieren und 14 Tage kostenlos testen

            </button>


            <p class="register-legal">

                Mit der Registrierung akzeptierst du unsere
                <a href="/agb">AGB</a>
                und
                <a href="/datenschutz">Datenschutzerklärung</a>.

            </p>


            <div class="register-login">

                <span>Bereits registriert?</span>

                <a href="Account/Login">
                    Jetzt anmelden
                </a>

            </div>

        </div>

    </EditForm>

</div>


@code {

    private IEnumerable<IdentityError>? identityErrors;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? Message =>
        identityErrors is null
            ? null
            : $"Fehler: {string.Join(", ",
                identityErrors.Select(error => error.Description))}";


    protected override void OnInitialized()
    {
        Input ??= new();
    }


    public async Task RegisterUser(EditContext editContext)
    {            var now = DateTime.UtcNow;

        var company = new Company
        {
            Id = Guid.NewGuid(),

            Name = Input.CompanyName.Trim(),

            Address = string.IsNullOrWhiteSpace(Input.Address)
                ? null
                : Input.Address.Trim(),

            PostalCode = string.IsNullOrWhiteSpace(Input.PostalCode)
                ? null
                : Input.PostalCode.Trim(),

            City = string.IsNullOrWhiteSpace(Input.City)
                ? null
                : Input.City.Trim(),

            Phone = string.IsNullOrWhiteSpace(Input.Phone)
                ? null
                : Input.Phone.Trim(),

            Email = Input.Email.Trim(),

            SubscriptionPlan = Input.SubscriptionPlan,

            TrialStartDate = now,
            TrialEndDate = now.AddDays(7),
            SubscriptionStatus = SubscriptionStatus.Trial
        };


        var user = CreateUser();

        user.CompanyId = company.Id;
        user.EmailConfirmed = true;


        await UserStore.SetUserNameAsync(
            user,
            Input.Email,
            CancellationToken.None);


        var emailStore = GetEmailStore();

        await emailStore.SetEmailAsync(
            user,
            Input.Email,
            CancellationToken.None);


        Db.Companies.Add(company);


        var result =
            await UserManager.CreateAsync(
                user,
                Input.Password);


        if (!result.Succeeded)
        {
            identityErrors = result.Errors;
            return;
        }


        Logger.LogInformation(
            "User created a new account with password.");


        var resultRole =
            await UserManager.AddToRoleAsync(
                user,
                "Admin");


        if (!resultRole.Succeeded)
        {
            throw new Exception(
                "Admin role could not be assigned: " +
                string.Join(", ",
                    resultRole.Errors.Select(e => e.Description)));
        }


        await Db.SaveChangesAsync();


        await SignInManager.SignInAsync(
            user,
            isPersistent: false);


        RedirectManager.RedirectTo(ReturnUrl);
    }


    private ApplicationUser CreateUser()
    {
        try
        {
            return Activator.CreateInstance<ApplicationUser>();
        }
        catch
        {
            throw new InvalidOperationException(
                $"Can't create an instance of '{nameof(ApplicationUser)}'. " +
                $"Ensure that '{nameof(ApplicationUser)}' is not an abstract class " +
                $"and has a parameterless constructor.");
        }
    }


    private IUserEmailStore<ApplicationUser> GetEmailStore()
    {
        if (!UserManager.SupportsUserEmail)
        {
            throw new NotSupportedException(
                "The default UI requires a user store with email support.");
        }

        return (IUserEmailStore<ApplicationUser>)UserStore;
    }


    private sealed class InputModel
    {
        [Required(ErrorMessage = "Bitte geben Sie den Firmennamen ein.")]
        [Display(Name = "Firmenname")]
        public string CompanyName { get; set; } = "";

        public string? Address { get; set; }

        public string? PostalCode { get; set; }

        public string? City { get; set; }

        public string? Phone { get; set; }

        public SubscriptionPlan SubscriptionPlan { get; set; }
            = SubscriptionPlan.S;


        [Required(ErrorMessage = "Bitte geben Sie Ihre E-Mail-Adresse ein.")]
        [EmailAddress(ErrorMessage = "Bitte geben Sie eine gültige E-Mail-Adresse ein.")]
        [Display(Name = "E-Mail-Adresse")]
        public string Email { get; set; } = "";


        [Required(ErrorMessage = "Bitte geben Sie ein Passwort ein.")]
        [StringLength(
            100,
            ErrorMessage = "Das Passwort muss mindestens {2} und maximal {1} Zeichen lang sein.",
            MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = "Passwort")]
        public string Password { get; set; } = "";


        [Required(ErrorMessage = "Bitte bestätigen Sie Ihr Passwort.")]
        [DataType(DataType.Password)]
        [Display(Name = "Passwort bestätigen")]
        [Compare(
            "Password",
            ErrorMessage = "Die Passwörter stimmen nicht überein.")]
        public string ConfirmPassword { get; set; } = "";
    }
}