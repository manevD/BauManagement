@code {

    private IEnumerable<IdentityError>? identityErrors;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? Message =>
        identityErrors is null
            ? null
            : $"Fehler: {string.Join(", ",
                identityErrors.Select(error => error.Description))}";

    protected override void OnInitialized()
    {
        Input ??= new();
    }

   
    public async Task RegisterUser(EditContext editContext)
    {
        identityErrors = null;

        // AVV-Datei vor jeglichen Änderungen prüfen.
        var avvPath = Path.Combine(
            AppContext.BaseDirectory,
            "LegalDocuments",
            "AVV",
            "AVV-v1.0.html");

        if (!File.Exists(avvPath))
        {
            Logger.LogError("Die AVV-Datei wurde nicht gefunden: {Path}", avvPath);
            identityErrors = new[]
            {
                new IdentityError
                {
                    Description = "Der AVV konnte nicht geladen werden. Bitte versuchen Sie es später erneut."
                }
            };
            return;
        }

        string avvHash;
        try
        {
            var avvBytes = await File.ReadAllBytesAsync(avvPath);
            avvHash = Convert.ToHexString(SHA256.HashData(avvBytes));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Die AVV-Datei konnte nicht gelesen oder geprüft werden.");
            identityErrors = new[]
            {
                new IdentityError
                {
                    Description = "Der AVV konnte nicht überprüft werden. Bitte versuchen Sie es später erneut."
                }
            };
            return;
        }

        var now = DateTime.UtcNow;
        ApplicationUser? createdUser = null;
        string? stripeCustomerId = null;

        try
        {
            await using var transaction = await Db.Database.BeginTransactionAsync();

            // 1. Unternehmen anlegen.
            var company = new Company
            {
                Id = Guid.NewGuid(),
                Name = Input.CompanyName.Trim(),
                Address = string.IsNullOrWhiteSpace(Input.Address) ? null : Input.Address.Trim(),
                PostalCode = string.IsNullOrWhiteSpace(Input.PostalCode) ? null : Input.PostalCode.Trim(),
                City = string.IsNullOrWhiteSpace(Input.City) ? null : Input.City.Trim(),
                Phone = string.IsNullOrWhiteSpace(Input.Phone) ? null : Input.Phone.Trim(),
                Email = Input.Email.Trim(),
                SubscriptionPlan = Input.SubscriptionPlan,
                TrialStartDate = now,
                TrialEndDate = now.AddDays(7),
                SubscriptionStatus = SubscriptionStatus.Trial,
                IsSubscriptionActive = false
            };

            Db.Companies.Add(company);
            await Db.SaveChangesAsync();

            // 2. Benutzer anlegen.
            var user = CreateUser();
            user.CompanyId = company.Id;

            await UserStore.SetUserNameAsync(user, Input.Email.Trim(), CancellationToken.None);
            var emailStore = GetEmailStore();
            await emailStore.SetEmailAsync(user, Input.Email.Trim(), CancellationToken.None);

            var userResult = await UserManager.CreateAsync(user, Input.Password);
            if (!userResult.Succeeded)
            {
                identityErrors = userResult.Errors;
                await transaction.RollbackAsync();
                Db.ChangeTracker.Clear();
                return;
            }

            // 3. Admin-Rolle zuweisen.
            var roleResult = await UserManager.AddToRoleAsync(user, "Admin");
            if (!roleResult.Succeeded)
            {
                identityErrors = roleResult.Errors;
                await transaction.RollbackAsync();
                Db.ChangeTracker.Clear();
                return;
            }

            // 4. Stripe-Kundenkonto erstellen.
            var stripeCustomer = await StripeService.CreateCustomerAsync(company, Input.Email.Trim());
            stripeCustomerId = stripeCustomer.Id;

            company.StripeCustomerId = stripeCustomer.Id;
            company.StripePriceId = StripeService.GetPriceId(company.SubscriptionPlan);

            // 5. Annahme der AVV dokumentieren.
            Db.CompanyAvvs.Add(new CompanyAvv
            {
                Id = Guid.NewGuid(),
                CompanyId = company.Id,
                Version = "1.0",
                AcceptedAtUtc = now,
                AcceptedByUserId = user.Id,
                DocumentPath = "/avv",
                DocumentHash = avvHash
            });

            // 6. Änderungen speichern und Datenbanktransaktion abschließen.
            await Db.SaveChangesAsync();
            await transaction.CommitAsync();
            createdUser = user;

            Logger.LogInformation(
                "Registrierung erfolgreich. CompanyId: {CompanyId}, UserId: {UserId}, AVV-Version: {AvvVersion}, AVV-Prüfsumme: {AvvHash}.",
                company.Id,
                user.Id,
                "1.0",
                avvHash);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Bei der Registrierung ist ein Fehler aufgetreten.");

            // Die Datenbanktransaktion wird beim Verlassen des try-Blocks freigegeben.
            // Ein bereits bei Stripe angelegter Kunde muss separat bereinigt werden.
            if (!string.IsNullOrWhiteSpace(stripeCustomerId))
            {
                try
                {
                    await StripeService.DeleteCustomerAsync(stripeCustomerId);
                    Logger.LogInformation(
                        "Der Stripe-Kunde {StripeCustomerId} wurde nach einer fehlgeschlagenen Registrierung gelöscht.",
                        stripeCustomerId);
                }
                catch (Exception stripeEx)
                {
                    Logger.LogError(
                        stripeEx,
                        "Der Stripe-Kunde {StripeCustomerId} konnte nach einer fehlgeschlagenen Registrierung nicht gelöscht werden. Eine manuelle Prüfung ist erforderlich.",
                        stripeCustomerId);
                }
            }

            identityErrors = new[]
            {
                new IdentityError
                {
                    Description = "Bei der Registrierung ist ein Fehler aufgetreten. Bitte versuchen Sie es erneut."
                }
            };

            Db.ChangeTracker.Clear();
            return;
        }

        // 7. E-Mail-Bestätigungslink erstellen und versenden.
        // Der Benutzer wird hier ausdrücklich NICHT automatisch angemeldet.
        if (createdUser is not null)
        {
            try
            {
                var token = await UserManager.GenerateEmailConfirmationTokenAsync(createdUser);

                var encodedToken = WebEncoders.Base64UrlEncode(
                    Encoding.UTF8.GetBytes(token));

                var callbackUrl = NavigationManager.GetUriWithQueryParameters(
                    "/Account/ConfirmEmail",
                    new Dictionary<string, object?>
                    {
                        ["userId"] = createdUser.Id,
                        ["code"] = encodedToken
                    });

                await EmailSender.SendConfirmationLinkAsync(
                    createdUser,
                    Input.Email.Trim(),
                    HtmlEncoder.Default.Encode(callbackUrl));

                Logger.LogInformation(
                    "E-Mail-Bestätigungslink wurde für {Email} erstellt und an den E-Mail-Dienst übergeben.",
                    Input.Email.Trim());

                NavigationManager.NavigateTo(
                    $"/Account/RegisterConfirmation?email={Uri.EscapeDataString(Input.Email.Trim())}",
                    forceLoad: true);
            }
            catch (Exception ex)
            {
                Logger.LogError(
                    ex,
                    "Registrierung erfolgreich, aber die Bestätigungs-E-Mail konnte nicht versendet werden.");

                identityErrors = new[]
                {
                    new IdentityError
                    {
                        Description = "Dein Konto wurde erstellt, aber die Bestätigungs-E-Mail konnte nicht versendet werden. Bitte prüfe die SMTP-Konfiguration oder kontaktiere den Support."
                    }
                };
            }
        }
    }
    // =============================================================
    // CREATE USER
    // =============================================================

    private ApplicationUser CreateUser()
    {
        try
        {
            return Activator.CreateInstance<ApplicationUser>();
        }
        catch
        {
            throw new InvalidOperationException(
                $"Eine Instanz von '{nameof(ApplicationUser)}' konnte nicht erstellt werden. " +
                $"Stellen Sie sicher, dass die Klasse nicht abstrakt ist und einen parameterlosen Konstruktor besitzt.");
        }
    }


    // =============================================================
    // EMAIL STORE
    // =============================================================

    private IUserEmailStore<ApplicationUser> GetEmailStore()
    {
        if (!UserManager.SupportsUserEmail)
        {
            throw new NotSupportedException(
                "Die Registrierungsoberfläche benötigt einen Benutzerspeicher mit E-Mail-Unterstützung.");
        }

        return (IUserEmailStore<ApplicationUser>)UserStore;
    }


    // =============================================================
    // INPUT MODEL
    // =============================================================

    private sealed class InputModel
    {
        [Required(
            ErrorMessage =
                "Bitte geben Sie den Firmennamen ein.")]
        [Display(Name = "Firmenname")]
        public string CompanyName { get; set; } = "";


        public string? Address { get; set; }


        public string? PostalCode { get; set; }


        public string? City { get; set; }


        public string? Phone { get; set; }


        public SubscriptionPlan SubscriptionPlan { get; set; }
            = SubscriptionPlan.S;


        [Required(
            ErrorMessage =
                "Bitte geben Sie Ihre E-Mail-Adresse ein.")]
        [EmailAddress(
            ErrorMessage =
                "Bitte geben Sie eine gültige E-Mail-Adresse ein.")]
        [Display(Name = "E-Mail-Adresse")]
        public string Email { get; set; } = "";


        [Required(
            ErrorMessage =
                "Bitte geben Sie ein Passwort ein.")]
        [StringLength(
            100,
            ErrorMessage =
                "Das Passwort muss mindestens {2} und maximal {1} Zeichen lang sein.",
            MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = "Passwort")]
        public string Password { get; set; } = "";


        [Required(
            ErrorMessage =
                "Bitte bestätigen Sie Ihr Passwort.")]
        [DataType(DataType.Password)]
        [Display(Name = "Passwort bestätigen")]
        [Compare(
            "Password",
            ErrorMessage =
                "Die Passwörter stimmen nicht überein.")]
        public string ConfirmPassword { get; set; } = "";


        [Range(typeof(bool), "true", "true",
            ErrorMessage = "Bitte stimmen Sie dem AVV zu.")]
        public bool AcceptAvv { get; set; }
    }
}