@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using BauManagement.Data
@using BauManagement.Models
@using BauManagement.Services
@using Microsoft.AspNetCore.Identity
@inject StripeService StripeService
@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject SignInManager<ApplicationUser> SignInManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject ApplicationDbContext Db

@layout BauManagement.Components.Layout.AuthLayout

<PageTitle>Firma registrieren – BauManagement</PageTitle>

<div class="register-page">

    <!-- Background -->
    <div class="register-background">
        <div class="register-glow register-glow-1"></div>
        <div class="register-glow register-glow-2"></div>
        <div class="register-grid"></div>
    </div>


    <div class="register-container">

        <!-- Top -->
        <div class="register-top">

            <a href="/" class="register-brand">
                <span class="register-brand-back">←</span>

                <span>
                    <strong><span>Bau</span>Management</strong>
                </span>
            </a>

            <div class="register-login-top">
                <span>Bereits registriert?</span>

                <a href="Account/Login">
                    Anmelden →
                </a>
            </div>

        </div>


        <!-- Header -->
        <div class="register-heading">

            <div class="register-heading-badge">
                <span class="badge-dot"></span>
                7 Tage kostenlos testen
            </div>

            <h1>
                Deine Firma.
                <span>Dein BauManagement.</span>
            </h1>

            <p>
                Erstelle deine Firma und verwalte Baustellen,
                Mitarbeiter, Aufgaben und Einsätze zentral an einem Ort.
            </p>

        </div>


        <!-- Message -->
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="register-message">
                <i class="bi bi-exclamation-circle"></i>
                <span>@Message</span>
            </div>
        }


        <EditForm Model="Input"
                  method="post"
                  OnValidSubmit="RegisterUser"
                  FormName="register">

            <DataAnnotationsValidator />


            <!-- Validation -->
            <div class="register-validation">
                <ValidationSummary />
            </div>


            <!-- =====================================================
                 1. FIRMENDATEN
                 ===================================================== -->

            <section class="register-card">

                <div class="register-section-header">

                    <div class="section-number">
                        01
                    </div>

                    <div>
                        <h2>Firmendaten</h2>
                        <p>Informationen zu deinem Unternehmen</p>
                    </div>

                </div>


                <div class="register-fields">

                    <!-- Firmenname -->
                    <div class="register-field full">

                        <label>
                            Firmenname
                            <span>*</span>
                        </label>

                        <div class="register-input-wrapper">

                            <i class="bi bi-building"></i>

                            <InputText @bind-Value="Input.CompanyName"
                                       class="form-control register-input"
                                       placeholder="z. B. Müller Bau GmbH" />

                        </div>

                        <ValidationMessage For="() => Input.CompanyName" />

                    </div>


                    <!-- Adresse -->
                    <div class="register-field address">

                        <label>Adresse</label>

                        <div class="register-input-wrapper">

                            <i class="bi bi-geo-alt"></i>

                            <InputText @bind-Value="Input.Address"
                                       class="form-control register-input"
                                       placeholder="Musterstraße 12" />

                        </div>

                    </div>


                    <!-- PLZ -->
                    <div class="register-field postal">

                        <label>PLZ</label>

                        <div class="register-input-wrapper">
                                                        <i class="bi bi-geo-alt"></i>

                            <InputText @bind-Value="Input.PostalCode"
                                       class="form-control register-input"
                                       placeholder="10115" />

                        </div>

                    </div>


                    <!-- Ort -->
                    <div class="register-field city">

                        <label>Ort</label>

                        <div class="register-input-wrapper">
                                                                                <i class="bi bi-geo-alt"></i>

                            <InputText @bind-Value="Input.City"
                                       class="form-control register-input"
                                       placeholder="Berlin" />

                        </div>

                    </div>


                    <!-- Telefon -->
                    <div class="register-field full">

                        <label>Telefon</label>

                        <div class="register-input-wrapper">

                            <i class="bi bi-telephone"></i>

                            <InputText @bind-Value="Input.Phone"
                                       class="form-control register-input"
                                       placeholder="+49 30 1234567" />

                        </div>

                    </div>

                </div>

            </section>


            <!-- =====================================================
                 2. PAKET
                 ===================================================== -->

            <section class="register-card">

                <div class="register-section-header">

                    <div class="section-number">
                        02
                    </div>

                    <div>
                        <h2>Paket auswählen</h2>
                        <p>Wähle den passenden Tarif für dein Team</p>
                    </div>

                </div>


                <InputRadioGroup @bind-Value="Input.SubscriptionPlan">

                    <div class="plan-grid">

                        <!-- S -->
                        <label class="plan-card @(Input.SubscriptionPlan == SubscriptionPlan.S ? "selected" : "")">

                            <InputRadio Value="SubscriptionPlan.S"
                                        class="plan-radio" />

                            <div class="plan-top">

                                <div class="plan-name">
                                    S
                                    <span>Starter</span>
                                </div>

                                @if (Input.SubscriptionPlan == SubscriptionPlan.S)
                                {
                                    <div class="plan-check">
                                        ✓
                                    </div>
                                }

                            </div>

                            <div class="plan-price">
                                35 €
                                <span>/ Monat</span>
                            </div>

                            <div class="plan-employees">
                                <i class="bi bi-people"></i>
                                Bis 5 Mitarbeiter
                            </div>

                        </label>


                        <!-- M -->
                        <label class="plan-card @(Input.SubscriptionPlan == SubscriptionPlan.M ? "selected" : "")">

                            <InputRadio Value="SubscriptionPlan.M"
                                        class="plan-radio" />

                            <div class="plan-top">

                                <div class="plan-name">
                                    M
                                    <span>Team</span>
                                </div>

                                @if (Input.SubscriptionPlan == SubscriptionPlan.M)
                                {
                                    <div class="plan-check">
                                        ✓
                                    </div>
                                }

                            </div>

                            <div class="plan-price">
                                70 €
                                <span>/ Monat</span>
                            </div>

                            <div class="plan-employees">
                                <i class="bi bi-people"></i>
                                Bis 10 Mitarbeiter
                            </div>

                        </label>


                        <!-- L -->
                        <label class="plan-card @(Input.SubscriptionPlan == SubscriptionPlan.L ? "selected" : "")">

                            <InputRadio Value="SubscriptionPlan.L"
                                        class="plan-radio" />

                            <div class="plan-top">

                                <div class="plan-name">
                                    L
                                    <span>Business</span>
                                </div>

                                @if (Input.SubscriptionPlan == SubscriptionPlan.L)
                                {
                                    <div class="plan-check">
                                        ✓
                                    </div>
                                }

                            </div>

                            <div class="plan-price">
                                140 €
                                <span>/ Monat</span>
                            </div>

                            <div class="plan-employees">
                                <i class="bi bi-people"></i>
                                Bis 20 Mitarbeiter
                            </div>

                        </label>


                        <!-- XL -->
                        <label class="plan-card @(Input.SubscriptionPlan == SubscriptionPlan.XL ? "selected" : "")">

                            <InputRadio Value="SubscriptionPlan.XL"
                                        class="plan-radio" />

                            <div class="plan-top">

                                <div class="plan-name">
                                    XL
                                    <span>Profi</span>
                                </div>

                                @if (Input.SubscriptionPlan == SubscriptionPlan.XL)
                                {
                                    <div class="plan-check">
                                        ✓
                                    </div>
                                }

                            </div>

                            <div class="plan-price">
                                200 €
                                <span>/ Monat</span>
                            </div>

                            <div class="plan-employees">
                                <i class="bi bi-people"></i>
                                Über 20 Mitarbeiter
                            </div>

                        </label>

                    </div>

                </InputRadioGroup>

            </section>


            <!-- =====================================================
                 3. ZAHLUNG
                 ===================================================== -->

            <section class="register-card">

                <div class="stripe-note">

                    <i class="bi bi-info-circle"></i>

                    <span>
                        Die Zahlungsabwicklung wird nach der kostenlosen
                        Testphase aktiviert.
                    </span>

                </div>

            </section>


            <!-- =====================================================
                 4. ZUGANG
                 ===================================================== -->

            <section class="register-card">

                <div class="register-section-header">

                    <div class="section-number">
                        03
                    </div>

                    <div>
                        <h2>Zugang erstellen</h2>
                        <p>Deine Zugangsdaten für BauManagement</p>
                    </div>

                </div>


                <div class="register-fields">

                    <!-- Email -->
                    <div class="register-field full">

                        <label>
                            E-Mail-Adresse
                            <span>*</span>
                        </label>

                        <div class="register-input-wrapper">

                            <i class="bi bi-envelope"></i>

                            <InputText @bind-Value="Input.Email"
                                       id="Input.Email"
                                       class="form-control register-input"
                                       autocomplete="username"
                                       aria-required="true"
                                       placeholder="name@example.com" />

                        </div>

                        <ValidationMessage For="() => Input.Email" />

                    </div>


                    <!-- Password -->
                    <div class="register-field">

                        <label>
                            Passwort
                            <span>*</span>
                        </label>

                        <div class="register-input-wrapper">

                            <i class="bi bi-lock"></i>

                            <InputText type="password"
                                       @bind-Value="Input.Password"
                                       id="Input.Password"
                                       class="form-control register-input"
                                       autocomplete="new-password"
                                       aria-required="true"
                                       placeholder="Passwort" />

                        </div>

                        <ValidationMessage For="() => Input.Password" />

                    </div>


                    <!-- Confirm -->
                    <div class="register-field">

                        <label>
                            Passwort bestätigen
                            <span>*</span>
                        </label>

                        <div class="register-input-wrapper">

                            <i class="bi bi-lock-fill"></i>

                            <InputText type="password"
                                       @bind-Value="Input.ConfirmPassword"
                                       id="Input.ConfirmPassword"
                                       class="form-control register-input"
                                       autocomplete="new-password"
                                       aria-required="true"
                                       placeholder="Passwort wiederholen" />

                        </div>

                        <ValidationMessage For="() => Input.ConfirmPassword" />

                    </div>

                </div>

            </section>


            <!-- =====================================================
                 SUBMIT
                 ===================================================== -->

            <div class="register-submit-area">

                <button type="submit"
                        class="register-submit">

                    <span>
                        Firma registrieren
                    </span>

                    <span class="submit-arrow">
                        →
                    </span>

                </button>


                <div class="trial-info">

                    <div class="trial-icon">
                        <i class="bi bi-gift"></i>
                    </div>

                    <div>
                        <strong>7 Tage kostenlos testen</strong>

                        <span>
                            Keine Zahlung während der Testphase.
                        </span>
                    </div>

                </div>

            </div>


            <!-- Legal -->
            <p class="register-legal">

                Mit der Registrierung akzeptierst du unsere
                <a href="/agb">AGB</a>
                und
                <a href="/datenschutz">Datenschutzerklärung</a>.

            </p>


            <!-- Login -->
            <div class="register-login">

                <span>Bereits registriert?</span>

                <a href="Account/Login">
                    Jetzt anmelden →
                </a>

            </div>

        </EditForm>


        <!-- Footer -->
        <div class="register-footer">

            <span>MyBauManagement</span>

            <span>•</span>

            <span>Webolar</span>

        </div>

    </div>

</div>

@code {

    private IEnumerable<IdentityError>? identityErrors;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? Message =>
        identityErrors is null
            ? null
            : $"Fehler: {string.Join(", ",
                identityErrors.Select(error => error.Description))}";

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    public async Task RegisterUser(EditContext editContext)
    {
        identityErrors = null;

        try
        {
            var now = DateTime.UtcNow;

            // =====================================================
            // 1. COMPANY ERSTELLEN
            // =====================================================

            var company = new Company
            {
                Id = Guid.NewGuid(),

                Name = Input.CompanyName.Trim(),

                Address = string.IsNullOrWhiteSpace(Input.Address)
                    ? null
                    : Input.Address.Trim(),

                PostalCode = string.IsNullOrWhiteSpace(Input.PostalCode)
                    ? null
                    : Input.PostalCode.Trim(),

                City = string.IsNullOrWhiteSpace(Input.City)
                    ? null
                    : Input.City.Trim(),

                Phone = string.IsNullOrWhiteSpace(Input.Phone)
                    ? null
                    : Input.Phone.Trim(),

                Email = Input.Email.Trim(),

                SubscriptionPlan = Input.SubscriptionPlan,

                TrialStartDate = now,

                TrialEndDate = now.AddDays(1),

                SubscriptionStatus = SubscriptionStatus.Trial,

                IsSubscriptionActive = false
            };


            // =====================================================
            // 2. USER ERSTELLEN
            // =====================================================

            var user = CreateUser();

            user.CompanyId = company.Id;

            user.EmailConfirmed = true;


            await UserStore.SetUserNameAsync(
                user,
                Input.Email,
                CancellationToken.None);


            var emailStore = GetEmailStore();

            await emailStore.SetEmailAsync(
                user,
                Input.Email,
                CancellationToken.None);


            // =====================================================
            // 3. COMPANY IN DATABASE
            // =====================================================

            Db.Companies.Add(company);


            // =====================================================
            // 4. IDENTITY USER ERSTELLEN
            // =====================================================

            var result =
                await UserManager.CreateAsync(
                    user,
                    Input.Password);


            if (!result.Succeeded)
            {
                identityErrors = result.Errors;

                return;
            }


            Logger.LogInformation(
                "User created a new account with password.");


            // =====================================================
            // 5. ADMIN ROLE
            // =====================================================

            var resultRole =
                await UserManager.AddToRoleAsync(
                    user,
                    "Admin");


            if (!resultRole.Succeeded)
            {
                identityErrors = resultRole.Errors;

                return;
            }


            // =====================================================
            // 6. STRIPE CUSTOMER
            // =====================================================

            var stripeCustomer =
                await StripeService.CreateCustomerAsync(
                    company,
                    Input.Email);


            company.StripeCustomerId =
                stripeCustomer.Id;


            // =====================================================
            // 7. STRIPE PRICE ID SPEICHERN
            // =====================================================

            company.StripePriceId =
                StripeService.GetPriceId(
                    company.SubscriptionPlan);


            // =====================================================
            // 8. DATABASE SPEICHERN
            // =====================================================

            await Db.SaveChangesAsync();


            // // =====================================================
            // // 9. STRIPE CHECKOUT SESSION
            // // =====================================================

            // var checkoutSession =
            //     await StripeService.CreateCheckoutSessionAsync(
            //         company,
            //         stripeCustomer.Id);


            // // =====================================================
            // // 10. ZUR STRIPE CHECKOUT SEITE
            // // =====================================================

            // NavigationManager.NavigateTo(
            //     StripeService.GetCheckoutUrl(checkoutSession),
            //     forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error during registration and Stripe checkout.");

            identityErrors = new[]
             {
                new IdentityError
                {
                    Description =
                        "Bei der Registrierung ist ein Fehler aufgetreten. " +
                        "Bitte versuchen Sie es erneut."
                }
            };
        }
    }


    // =============================================================
    // CREATE USER
    // =============================================================

    private ApplicationUser CreateUser()
    {
        try
        {
            return Activator.CreateInstance<ApplicationUser>();
        }
        catch
        {
            throw new InvalidOperationException(
                $"Can't create an instance of '{nameof(ApplicationUser)}'. " +
                $"Ensure that '{nameof(ApplicationUser)}' is not an abstract class " +
                $"and has a parameterless constructor.");
        }
    }


    // =============================================================
    // EMAIL STORE
    // =============================================================

    private IUserEmailStore<ApplicationUser> GetEmailStore()
    {
        if (!UserManager.SupportsUserEmail)
        {
            throw new NotSupportedException(
                "The default UI requires a user store with email support.");
        }

        return (IUserEmailStore<ApplicationUser>)UserStore;
    }


    // =============================================================
    // INPUT MODEL
    // =============================================================

    private sealed class InputModel
    {
        [Required(
            ErrorMessage =
                "Bitte geben Sie den Firmennamen ein.")]
        [Display(Name = "Firmenname")]
        public string CompanyName { get; set; } = "";


        public string? Address { get; set; }


        public string? PostalCode { get; set; }


        public string? City { get; set; }


        public string? Phone { get; set; }


        public SubscriptionPlan SubscriptionPlan { get; set; }
            = SubscriptionPlan.S;


        [Required(
            ErrorMessage =
                "Bitte geben Sie Ihre E-Mail-Adresse ein.")]
        [EmailAddress(
            ErrorMessage =
                "Bitte geben Sie eine gültige E-Mail-Adresse ein.")]
        [Display(Name = "E-Mail-Adresse")]
        public string Email { get; set; } = "";


        [Required(
            ErrorMessage =
                "Bitte geben Sie ein Passwort ein.")]
        [StringLength(
            100,
            ErrorMessage =
                "Das Passwort muss mindestens {2} und maximal {1} Zeichen lang sein.",
            MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = "Passwort")]
        public string Password { get; set; } = "";


        [Required(
            ErrorMessage =
                "Bitte bestätigen Sie Ihr Passwort.")]
        [DataType(DataType.Password)]
        [Display(Name = "Passwort bestätigen")]
        [Compare(
            "Password",
            ErrorMessage =
                "Die Passwörter stimmen nicht überein.")]
        public string ConfirmPassword { get; set; } = "";
    }
}