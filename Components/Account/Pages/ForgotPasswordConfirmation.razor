@page "/Account/ForgotPasswordConfirmation"

@layout BauManagement.Components.Layout.AuthLayout

<PageTitle>Passwort zurücksetzen – BauManagement</PageTitle>

<div class="login-page">
    <div class="login-background">
        <div class="glow glow-1"></div>
        <div class="glow glow-2"></div>
        <div class="grid-lines"></div>
    </div>

    <div class="construction-shape shape-left">
        <div class="crane-tower"></div>
        <div class="crane-arm"></div>
    </div>

    <div class="construction-shape shape-right">
        <div class="building building-1"></div>
        <div class="building building-2"></div>
        <div class="building building-3"></div>
    </div>

    <div class="login-container">
        <div class="login-top">
            <a href="/" class="brand-back">
                <span class="back-arrow">←</span>
                <span class="brand-name"><span class="brand-orange">Bau</span>Management</span>
            </a>
        </div>

        <div class="login-card">
            <div class="login-logo">
                <div class="logo-inner">
                    <span class="logo-icon">🏗️</span>
                </div>
            </div>

            <div class="login-header">
                <h1>E-Mail prüfen</h1>
                <p>Wir haben die nächsten Schritte zum Zurücksetzen deines Passworts vorbereitet.</p>
            </div>

            <div class="forgot-confirmation-message" role="status">
                <i class="bi bi-envelope-check confirmation-icon"></i>
                <div>
                    <strong>Prüfe dein E-Mail-Postfach</strong>
                    <p>
                        Wenn ein Konto mit dieser E-Mail-Adresse existiert, erhältst du eine Nachricht
                        mit einem Link zum Zurücksetzen deines Passworts.
                    </p>
                    <p>Bitte prüfe bei Bedarf auch deinen Spam-Ordner.</p>
                </div>
            </div>

            <div class="confirmation-actions">
                <a href="/Account/Login" class="login-button">
                    <span>Zur Anmeldung</span>
                    <span class="button-arrow">→</span>
                </a>

                <a href="/Account/ForgotPassword" class="login-link">
                    <i class="bi bi-arrow-repeat link-icon"></i>
                    Erneut versuchen
                </a>

                <a href="/" class="login-link">
                    <i class="bi bi-house link-icon"></i>
                    Zur Startseite
                </a>
            </div>
        </div>

        <div class="login-footer">
            <span>MyBauManagement</span>
            <span>•</span>
            <span>Webolar</span>
        </div>
    </div>
</div>

<style>
    .forgot-confirmation-message {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 16px;
        border-radius: 14px;
        margin: 22px 0;
        line-height: 1.55;
        font-size: .95rem;
        color: #b7f7d1;
        background: rgba(34, 197, 94, .10);
        border: 1px solid rgba(34, 197, 94, .28);
    }

    .forgot-confirmation-message p {
        margin: 8px 0 0;
        color: inherit;
        opacity: .9;
    }

    .confirmation-icon {
        font-size: 1.35rem;
        color: #4ade80;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .confirmation-actions {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 14px;
        margin-top: 24px;
    }

    .confirmation-actions .login-button {
        text-decoration: none;
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        box-sizing: border-box;
    }

    .confirmation-actions .login-link {
        justify-content: center;
        text-decoration: none;
    }
</style>
