@page "/Account/ConfirmEmailChange"

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using BauManagement.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ConfirmEmailChange> Logger

<PageTitle>E-Mail-Änderung bestätigen – BauManagement</PageTitle>

<div class="confirm-change-page">
    <div class="confirm-change-glow confirm-change-glow-one"></div>
    <div class="confirm-change-glow confirm-change-glow-two"></div>
    <div class="confirm-change-grid"></div>

    <div class="confirm-change-top">
        <a href="/" class="confirm-change-brand" aria-label="BauManagement Startseite">
            <span class="confirm-change-back">←</span>
            <span><strong><span class="brand-orange">Bau</span>Management</strong></span>
        </a>
        <a href="/Account/Login" class="confirm-change-login">Anmelden <span>→</span></a>
    </div>

    <main class="confirm-change-card">
        <div class="confirm-change-badge">
            <i class="bi bi-shield-check"></i>
            Konto-Sicherheit
        </div>

        @if (_isProcessing)
        {
            <div class="confirm-change-icon processing">
                <i class="bi bi-envelope-check"></i>
            </div>
            <h1>E-Mail-Adresse wird <span>bestätigt</span></h1>
            <p class="confirm-change-description">Bitte warte, während wir deine E-Mail-Änderung sicher bestätigen.</p>
        }
        else if (_success)
        {
            <div class="confirm-change-icon success">
                <i class="bi bi-check-lg"></i>
            </div>
            <h1>E-Mail-Adresse <span>bestätigt</span></h1>
            <p class="confirm-change-description">@message</p>
            <a href="/Account/Login" class="confirm-change-button">
                <i class="bi bi-box-arrow-in-right"></i>
                Zur Anmeldung
            </a>
        }
        else
        {
            <div class="confirm-change-icon error">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <h1>Bestätigung <span>nicht möglich</span></h1>
            <p class="confirm-change-description">@message</p>
            <a href="/Account/Login" class="confirm-change-secondary">
                <i class="bi bi-chevron-left"></i>
                Zurück zum Login
            </a>
        }

        <div class="confirm-change-help">
            <i class="bi bi-info-circle"></i>
            <span>Wenn du diese Änderung nicht angefordert hast, melde dich bitte bei deinem Administrator oder Support.</span>
        </div>
    </main>

    <footer class="confirm-change-footer">
        <strong>© BauManagement – Webolar</strong>
        <span>Baustellen. Mitarbeiter. Aufgaben. Alles an einem Ort.</span>
    </footer>
</div>

<style>
    .confirm-change-page {
        position: relative;
        isolation: isolate;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overflow: hidden;
        padding: 22px clamp(16px, 4vw, 52px) 30px;
        background: radial-gradient(ellipse at 15% 75%, rgba(var(--ui-brand-rgb), .16), transparent 38%),
                    radial-gradient(ellipse at 88% 28%, rgba(var(--ui-brand-rgb), .12), transparent 32%),
                    var(--ui-surface);
        color: var(--ui-ink);
    }

    .confirm-change-glow {
        position: absolute;
        z-index: -1;
        width: 330px;
        height: 330px;
        border-radius: 50%;
        filter: blur(100px);
        background: rgba(var(--ui-brand-rgb), .15);
        pointer-events: none;
    }

    .confirm-change-glow-one { top: 24%; left: -170px; }
    .confirm-change-glow-two { right: -160px; bottom: 8%; }

    .confirm-change-grid {
        position: absolute;
        z-index: -1;
        inset: 0;
        opacity: .15;
        pointer-events: none;
        background-image: linear-gradient(rgba(var(--ui-brand-rgb), .18) 1px, transparent 1px),
                          linear-gradient(90deg, rgba(var(--ui-brand-rgb), .18) 1px, transparent 1px);
        background-size: 58px 58px;
        mask-image: linear-gradient(to bottom, transparent, black 20%, black 80%, transparent);
    }

    .confirm-change-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
    }

    .confirm-change-brand {
        display: inline-flex;
        align-items: center;
        gap: 14px;
        color: var(--ui-ink);
        font-size: 22px;
        text-decoration: none;
    }

    .confirm-change-brand strong { font-weight: 800; }
    .confirm-change-brand .brand-orange { color: var(--ui-brand); }

    .confirm-change-back {
        display: grid;
        width: 44px;
        height: 44px;
        place-items: center;
        border: 1px solid rgba(var(--ui-ink-rgb), 0.16);
        border-radius: 50%;
        color: var(--ui-ink);
        font-size: 25px;
        transition: background .2s ease, border-color .2s ease;
    }

    .confirm-change-brand:hover .confirm-change-back {
        border-color: var(--ui-brand);
        background: rgba(var(--ui-brand-rgb), .12);
    }

    .confirm-change-login {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 18px;
        border: 1px solid var(--ui-brand);
        border-radius: 12px;
        color: var(--ui-brand);
        font-weight: 700;
        text-decoration: none;
    }

    .confirm-change-login:hover { background: rgba(var(--ui-brand-rgb), .1); color: var(--ui-brand-400); }

    .confirm-change-card {
        width: min(100%, 650px);
        margin: auto;
        padding: clamp(30px, 5vw, 54px);
        border: 1px solid rgba(255,255,255,.7);
        border-radius: 22px;
        background: #fff;
        color: var(--ui-ink);
        text-align: center;
        box-shadow: 0 28px 90px rgba(16, 24, 40, 0.10);
    }

    .confirm-change-badge {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 25px;
        padding: 11px 19px;
        border-radius: 999px;
        background: var(--ui-brand-50);
        color: var(--ui-brand-600);
        font-size: 14px;
        font-weight: 750;
    }

    .confirm-change-badge i { font-size: 18px; }

    .confirm-change-icon {
        display: grid;
        width: 76px;
        height: 76px;
        margin: 0 auto 22px;
        place-items: center;
        border-radius: 50%;
        font-size: 34px;
    }

    .confirm-change-icon.processing { background: var(--ui-brand-50); color: var(--ui-brand); }
    .confirm-change-icon.success { background: #ecfdf3; color: #16a34a; }
    .confirm-change-icon.error { background: #fef2f2; color: #dc2626; }

    .confirm-change-card h1 {
        margin: 0;
        color: var(--ui-ink);
        font-size: clamp(28px, 4vw, 38px);
        font-weight: 850;
        line-height: 1.18;
        letter-spacing: -.7px;
    }

    .confirm-change-card h1 span { color: var(--ui-brand); }

    .confirm-change-description {
        margin: 18px auto 28px;
        max-width: 500px;
        color: var(--ui-muted);
        font-size: 16px;
        line-height: 1.75;
        overflow-wrap: anywhere;
    }

    .confirm-change-button,
    .confirm-change-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 52px;
        padding: 14px 24px;
        border-radius: 12px;
        font-weight: 750;
        text-decoration: none;
        transition: transform .2s ease, background .2s ease;
    }

    .confirm-change-button {
        width: 100%;
        background: linear-gradient(135deg, var(--ui-brand-400), var(--ui-brand));
        color: #fff;
        box-shadow: 0 10px 22px rgba(var(--ui-brand-rgb), .2);
    }

    .confirm-change-button:hover {
        transform: translateY(-1px);
        color: var(--ui-ink);
        box-shadow: 0 14px 28px rgba(var(--ui-brand-rgb), .28);
    }

    .confirm-change-secondary {
        border: 1px solid var(--ui-line-strong);
        color: var(--ui-ink);
    }

    .confirm-change-secondary:hover { background: var(--ui-brand-50); border-color: var(--ui-brand); color: var(--ui-brand-700); }

    .confirm-change-help {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        margin-top: 30px;
        padding: 15px 16px;
        border: 1px solid #bfdbfe;
        border-radius: 12px;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: 13px;
        line-height: 1.6;
        text-align: left;
    }

    .confirm-change-help i { margin-top: 2px; font-size: 18px; }

    .confirm-change-footer {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 7px;
        margin: 0 auto;
        color: var(--ui-muted);
        font-size: 13px;
        text-align: center;
    }

    .confirm-change-footer strong { color: var(--ui-ink); }

    @@media (max-width: 560px) {
        .confirm-change-page { padding: 16px 10px 24px; }
        .confirm-change-brand { gap: 8px; font-size: 18px; }
        .confirm-change-back { width: 38px; height: 38px; font-size: 22px; }
        .confirm-change-login { padding: 10px 12px; font-size: 13px; }
        .confirm-change-card { padding: 28px 20px; border-radius: 17px; }
        .confirm-change-card h1 { font-size: 29px; }
    }
</style>

@code {
    private string? message;
    private bool _isProcessing = true;
    private bool _success;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(UserId) ||
                string.IsNullOrWhiteSpace(Email) ||
                string.IsNullOrWhiteSpace(Code))
            {
                message = "Der Bestätigungslink ist unvollständig oder ungültig. Bitte fordere einen neuen Link an.";
                _success = false;
                return;
            }

            var user = await UserManager.FindByIdAsync(UserId);
            if (user is null)
            {
                message = "Das Benutzerkonto konnte nicht gefunden werden.";
                _success = false;
                return;
            }

            var decodedCode = Encoding.UTF8.GetString(
                WebEncoders.Base64UrlDecode(Code));

            var result = await UserManager.ChangeEmailAsync(user, Email, decodedCode);
            if (!result.Succeeded)
            {
                message = "Die E-Mail-Adresse konnte nicht geändert werden. Der Link ist möglicherweise abgelaufen. Bitte fordere die Änderung erneut an.";
                _success = false;
                Logger.LogWarning(
                    "E-Mail-Änderung konnte nicht bestätigt werden. UserId: {UserId}. Fehlercodes: {ErrorCodes}",
                    UserId,
                    string.Join(", ", result.Errors.Select(e => e.Code)));
                return;
            }

            // E-Mail und Benutzername sind in dieser Anwendung identisch.
            var setUserNameResult = await UserManager.SetUserNameAsync(user, Email);
            if (!setUserNameResult.Succeeded)
            {
                message = "Die E-Mail-Adresse wurde geändert, aber der Benutzername konnte nicht aktualisiert werden. Bitte kontaktiere den Support.";
                _success = false;
                Logger.LogError(
                    "E-Mail geändert, aber Benutzername konnte nicht aktualisiert werden. UserId: {UserId}. Fehlercodes: {ErrorCodes}",
                    UserId,
                    string.Join(", ", setUserNameResult.Errors.Select(e => e.Code)));
                return;
            }

            await SignInManager.RefreshSignInAsync(user);
            message = "Deine neue E-Mail-Adresse wurde erfolgreich bestätigt.";
            _success = true;
        }
        catch (FormatException ex)
        {
            Logger.LogWarning(ex, "Ungültiger Code beim Bestätigen einer E-Mail-Änderung.");
            message = "Der Bestätigungslink ist ungültig oder beschädigt. Bitte fordere einen neuen Link an.";
            _success = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Bestätigen einer E-Mail-Änderung.");
            message = "Die Bestätigung konnte momentan nicht abgeschlossen werden. Bitte versuche es später erneut.";
            _success = false;
        }
        finally
        {
            _isProcessing = false;
        }
    }
}
