        min-height: 100vh;
        padding-bottom: 42px;
    }

    .resend-container {
        max-width: 1120px;
        margin: 0 auto;
    }

    .resend-card {
        width: min(100% - 32px, 720px);
        margin: 48px auto 34px;
        padding: clamp(28px, 5vw, 54px);
        background: rgba(255, 255, 255, .98);
        color: var(--ui-ink);
        border: 1px solid rgba(255,255,255,.65);
        border-radius: 22px;
        box-shadow: 0 28px 90px rgba(16, 24, 40, 0.08);
    }

    .resend-badge {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: fit-content;
        margin: 0 auto 26px;
        padding: 12px 22px;
        border-radius: 999px;
        background: var(--ui-brand-50);
        color: var(--ui-brand-600);
        font-weight: 700;
    }

    .resend-badge i {
        font-size: 21px;
    }

    .resend-heading {
        max-width: 590px;
        margin: 0 auto 38px;
        text-align: center;
    }

    .resend-heading h1 {
        margin: 0;
        color: var(--ui-ink);
        font-size: clamp(28px, 4vw, 42px);
        font-weight: 800;
        line-height: 1.16;
        letter-spacing: -.8px;
    }

    .resend-heading h1 span {
        color: var(--ui-brand);
    }

    .resend-heading-line {
        width: 54px;
        height: 6px;
        margin: 22px auto 20px;
        border-radius: 999px;
        background: var(--ui-brand);
    }

    .resend-heading p {
        margin: 0;
        color: var(--ui-muted);
        font-size: 17px;
        line-height: 1.75;
    }

    .resend-field {
        margin-bottom: 28px;
    }

    .resend-field label {
        display: block;
        margin-bottom: 10px;
        color: var(--ui-ink);
        font-size: 15px;
        font-weight: 750;
    }

    .resend-field label span {
        color: #ef4444;
    }

    .resend-input-wrap {
        display: flex;
        align-items: center;
        gap: 13px;
        min-height: 62px;
        padding: 0 18px;
        border: 1px solid var(--ui-line-strong);
        border-radius: 13px;
        background: #fff;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

    .resend-input-wrap:focus-within {
        border-color: var(--ui-brand);
        box-shadow: 0 0 0 4px rgba(var(--ui-brand-rgb), .12);
    }

    .resend-input-wrap > i {
        color: var(--ui-muted);
