            padding: 28px 20px;
            border-radius: 18px;
        }

        .resend-heading p {
            font-size: 15px;
        }

        .resend-submit {
            min-height: 58px;
            font-size: 15px;
        }

        .resend-page .register-top {
            padding-left: 12px;
            padding-right: 12px;
        }
    }
</style>

@code {
    private string? message;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task OnValidSubmitAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email!);

        // Aus Sicherheitsgründen wird immer dieselbe Nachricht angezeigt.
        if (user is null || await UserManager.IsEmailConfirmedAsync(user))
        {
            message = "Falls ein Konto mit dieser E-Mail-Adresse existiert und noch nicht bestätigt wurde, senden wir einen Bestätigungslink. Bitte prüfe dein Postfach.";
            return;
        }

        var userId = await UserManager.GetUserIdAsync(user);
        var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));

        var baseUrl = Configuration["App:BaseUrl"];
        if (string.IsNullOrWhiteSpace(baseUrl))
        {
            baseUrl = NavigationManager.BaseUri;
        }

        var callbackUrl = QueryHelpers.AddQueryString(
            $"{baseUrl.TrimEnd('/')}/Account/ConfirmEmail",
            new Dictionary<string, string?>
            {
                ["userId"] = userId,
                ["code"] = code
            });

        await EmailSender.SendConfirmationLinkAsync(
            user,
            Input.Email!,
            HtmlEncoder.Default.Encode(callbackUrl));

        message = "Falls ein Konto mit dieser E-Mail-Adresse existiert und noch nicht bestätigt wurde, senden wir einen Bestätigungslink. Bitte prüfe dein Postfach.";
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Bitte gib deine E-Mail-Adresse ein.")]
        [EmailAddress(ErrorMessage = "Bitte gib eine gültige E-Mail-Adresse ein.")]
        public string Email { get; set; } = "";
    }
}
