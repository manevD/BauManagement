@page "/Account/ResendEmailConfirmation"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using BauManagement.Data
@using BauManagement.Services

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject IConfiguration Configuration
@inject ILogger<ResendEmailConfirmation> Logger

@layout BauManagement.Components.Layout.AuthLayout

<PageTitle>Bestätigungs-E-Mail erneut senden – BauManagement</PageTitle>

<div class="register-page resend-page">
    <div class="register-background">
        <div class="register-glow register-glow-1"></div>
        <div class="register-glow register-glow-2"></div>
        <div class="register-grid"></div>
    </div>

    <div class="register-container resend-container">
        <div class="register-top">
            <a href="/" class="register-brand">
                <span class="register-brand-back">←</span>
                <span><strong><span>Bau</span>Management</strong></span>
            </a>

            <div class="register-login-top">
                <span>Schon registriert?</span>
                <a href="/Account/Login">Anmelden →</a>
            </div>
        </div>

        <div class="resend-card">
            <div class="resend-badge">
                <i class="bi bi-envelope-check"></i>
                E-Mail bestätigen
            </div>

            <div class="resend-heading">
                <h1>Bestätigungs-E-Mail <span>erneut senden</span></h1>
                <div class="resend-heading-line"></div>
                <p>
                    Du hast keine Bestätigungs-E-Mail erhalten oder sie ist abgelaufen?
                    Gib deine E-Mail-Adresse ein, um einen neuen Bestätigungslink zu erhalten.
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="resend-status" role="status">
                    <i class="bi bi-info-circle"></i>
                    <span>@message</span>
                </div>
            }

            <EditForm Model="Input"
                      FormName="resend-email-confirmation"
                      OnValidSubmit="OnValidSubmitAsync"
                      method="post">
                <DataAnnotationsValidator />
                <ValidationSummary class="resend-validation" role="alert" />

                <div class="resend-field">
                    <label for="Input.Email">E-Mail-Adresse <span>*</span></label>
                    <div class="resend-input-wrap">
                        <i class="bi bi-envelope"></i>
                        <InputText @bind-Value="Input.Email"
                                   id="Input.Email"
                                   class="resend-input"
                                   autocomplete="email"
                                   aria-required="true"
                                   placeholder="name@example.com" />
                    </div>
                    <ValidationMessage For="() => Input.Email" class="resend-validation-message" />
                    <small>Gib die E-Mail-Adresse ein, mit der du dich registriert hast.</small>
                </div>

                <button type="submit" class="resend-submit">
                    <i class="bi bi-send-fill"></i>
                    Bestätigungs-E-Mail senden
                </button>
            </EditForm>

            <div class="resend-support">
                <i class="bi bi-info-circle"></i>
                <span>Falls du keinen Zugang zu deinem Postfach hast oder weiterhin Probleme bestehen, kontaktiere bitte den Support.</span>
            </div>

            <div class="resend-back">
                <span>Zurück zum Login</span>
                <a href="/Account/Login" class="resend-back-button">
                    <i class="bi bi-chevron-left"></i>
                    Zur Anmeldeseite
                </a>
            </div>
        </div>

        <div class="register-footer">
            <span>© BauManagement – Webolar</span>
            <span>•</span>
            <span>Baustellen. Mitarbeiter. Aufgaben. Alles an einem Ort.</span>
        </div>
    </div>
</div>

<style>
