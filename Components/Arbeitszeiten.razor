    // =========================================================
    // CSV EXPORT
    // =========================================================

    private async Task ExportCsv()
    {
        var monthStart =
            new DateTime(
                CurrentMonth.Year,
                CurrentMonth.Month,
                1);

        var monthEnd =
            monthStart.AddMonths(1);


        var exportEntries =
            await Db.WorkTimeEntries
                .AsNoTracking()
                .Include(x => x.Employee)
                .Where(x =>
                    x.CompanyId == companyId &&
                    x.WorkDate >= monthStart &&
                    x.WorkDate < monthEnd)
                .ToListAsync();


        var csv =
            new StringBuilder();


        // UTF-8 BOM für Excel

        csv.Append('\uFEFF');


        // Header

        csv.AppendLine(
            "Mitarbeiter;Arbeitszeit ohne Pause;Pause;Arbeitstage");


        // GROUP BY EMPLOYEE

        var employeeGroups =
            exportEntries
                .GroupBy(x => x.EmployeeId)
                .Select(group =>
                {
                    var employee =
                        group.First().Employee;

                    var totalWorkTime =
                        TimeSpan.Zero;

                    var totalBreakMinutes =
                        0;

                    var workDays =
                        0;


                    foreach (var entry in group)
                    {
                        totalWorkTime +=
                            GetWorkTime(entry);

                        totalBreakMinutes +=
                            Math.Max(
                                0,
                                entry.BreakMinutes);

                        if (entry.StartTime.HasValue)
                        {
                            workDays++;
                        }
                    }


                    return new
                    {
                        Employee =
                            $"{employee.FirstName} {employee.LastName}"
                                .Trim(),

                        WorkTime =
                            totalWorkTime,

                        BreakTime =
                            TimeSpan.FromMinutes(
                                totalBreakMinutes),

                        WorkDays =
                            workDays
                    };
                })
                .OrderBy(x => x.Employee)
                .ToList();


        foreach (var employee in employeeGroups)
        {
            csv.AppendLine(
                $"{CsvEscape(employee.Employee)};" +
                $"{FormatDuration(employee.WorkTime)};" +
                $"{FormatDuration(employee.BreakTime)};" +
                $"{employee.WorkDays}");
        }


        var fileName =
            $"Arbeitszeiten_{CurrentMonth:yyyy-MM}.csv";


        var bytes =
            Encoding.UTF8.GetBytes(
                csv.ToString());


        var base64 =
            Convert.ToBase64String(
                bytes);


        await JS.InvokeVoidAsync(
            "arbeitszeiten.downloadCsv",
            fileName,
            base64);
    }


    private static string CsvEscape(
        string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return "";
        }

        if (value.Contains(';') ||
            value.Contains('"') ||
            value.Contains('\n') ||
            value.Contains('\r'))
        {
            return
                $"\"{value.Replace("\"", "\"\"")}\"";
        }

        return value;
    }

