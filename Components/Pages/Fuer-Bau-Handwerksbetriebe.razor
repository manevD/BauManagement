@page "/fuer-bau-handwerk"
@layout LandingLayout

@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Für Bau- & Handwerksbetriebe | BauManagement</PageTitle>

<div class="bh-page">

    <nav class="landing-nav container" aria-label="Hauptnavigation">

        <a class="brand" href="/" aria-label="BauManagement Startseite">
            <span class="brand-bau">Bau</span><span class="brand-management">Management</span>
        </a>

        <input type="checkbox" id="bh-mobile-menu" class="bm-mobile-menu-toggle" />

        <label for="bh-mobile-menu" class="bm-mobile-menu-button" aria-label="Menü öffnen">
            <span></span>
            <span></span>
            <span></span>
        </label>

        <div class="landing-nav-menu">
            <a href="/">Startseite</a>
            <a href="/funktionen">Funktionen</a>
            <a href="/preise">Preise</a>

            <a href="/fuer-bau-handwerk" class="nav-b2b nav-active">
                <i class="bi bi-building"></i>
                Für Bau- &amp; Handwerksbetriebe
            </a>

            <div class="bm-mobile-actions">
                <AuthorizeView>
                    <NotAuthorized>
                        <a class="bm-mobile-login" href="Account/Login">
                            Anmelden
                        </a>
                        <a class="bm-mobile-register" href="Account/Register">
                            Kostenlos starten
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </NotAuthorized>
                    <Authorized>
                        <a class="bm-mobile-register" href="/tasks">
                            Zum Dashboard
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>

        <AuthorizeView>
            <Authorized>
                <a class="btn btn-warning fw-semibold px-4 nav-action" href="/tasks">
                    Zum Dashboard
                </a>
            </Authorized>
            <NotAuthorized>
                <div class="landing-nav-actions">
                    <a class="btn btn-primary px-4 nav-login" href="Account/Login">
                        Anmelden
                    </a>
                    <a class="btn btn-primary fw-semibold px-4 nav-action" href="Account/Register">
                        Kostenlos starten
                    </a>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>

<section class="bh-hero">
    <div class="bh-container">
        <div class="bh-hero-grid">
            <div class="bh-hero-content">
                <span class="bh-eyebrow">FÜR BAU- & HANDWERKSBETRIEBE</span>

                <h1>
                    Ihre Baustellen.
                    <br />
                    Ihre Mitarbeiter.
                    <br />
                    <span>Ein klarer Überblick.</span>
                </h1>

                <p class="bh-lead">
                    BauManagement hilft Bau- und Handwerksbetrieben,
                    Mitarbeiter, Baustellen, Einsätze, Aufgaben und Arbeitszeiten
                    zentral zu organisieren – einfach, übersichtlich und digital.
                </p>

                <div class="bh-actions">
                    <a href="Account/Register" class="bh-btn bh-btn-primary">
                        Kostenlos starten
                        <i class="bi bi-arrow-right"></i>
                    </a>
                    <a href="/funktionen" class="bh-btn bh-btn-secondary">
                        Funktionen ansehen
                    </a>
                </div>

                <div class="bh-trust">
                    <span><i class="bi bi-check-circle-fill"></i> Für Bau & Handwerk</span>
                    <span><i class="bi bi-check-circle-fill"></i> Desktop & Smartphone</span>
                    <span><i class="bi bi-check-circle-fill"></i> Klare Teamplanung</span>
                </div>
            </div>

            <div class="bh-hero-visual">
                <div class="bh-glow"></div>
                <div class="bh-dashboard">
                    <div class="bh-dashboard-top">
                        <div>
                            <small>BAUMANAGEMENT</small>
                            <strong>Baustellenübersicht</strong>
                        </div>
                        <span class="bh-live"><i></i> LIVE</span>
                    </div>

                    <div class="bh-dashboard-stats">
                        <div><strong>12</strong><span>Baustellen</span></div>
                        <div><strong>24</strong><span>Mitarbeiter</span></div>
                        <div><strong>18</strong><span>Aufgaben</span></div>
                    </div>

                    <div class="bh-schedule-title">
                        <span>Heutige Einsätze</span>
                        <span>08:00 – 17:00</span>
                    </div>

                    <div class="bh-job">
                        <div class="bh-avatar">MK</div>
                        <div class="bh-job-info">
                            <strong>Marko K.</strong>
                            <span><i class="bi bi-geo-alt"></i> Müller GmbH</span>
                        </div>
                        <b>08:00<small>12:00</small></b>
                    </div>

                    <div class="bh-job">
                        <div class="bh-avatar orange">ST</div>
                        <div class="bh-job-info">
                            <strong>Stefan T.</strong>
                            <span><i class="bi bi-geo-alt"></i> Neubau Weber</span>
                        </div>
                        <b>08:00<small>16:00</small></b>
                    </div>

                    <div class="bh-job">
                        <div class="bh-avatar green">DA</div>
                        <div class="bh-job-info">
                            <strong>Daniel A.</strong>
                            <span><i class="bi bi-geo-alt"></i> Sanierung Schmidt</span>
                        </div>
                        <b>10:00<small>14:00</small></b>
                    </div>

                    <div class="bh-dashboard-footer">
                        <i class="bi bi-calendar3"></i>
                        Alle Einsätze im Chef-Kalender verwalten
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="bh-problem">
    <div class="bh-container">
        <div class="bh-section-head">
            <span class="bh-eyebrow">WENN DER ÜBERBLICK FEHLT</span>
            <h2>Baustellenplanung muss nicht kompliziert sein.</h2>
            <p>
                Wenn Informationen über Excel, Zettel, Telefonate und WhatsApp verteilt sind,
                wird die tägliche Planung schnell unübersichtlich.
            </p>
        </div>

        <div class="bh-problem-grid">
            <div class="bh-problem-card">
                <i class="bi bi-file-earmark-spreadsheet"></i>
                <h3>Zu viele Listen</h3>
                <p>Mitarbeiter, Baustellen und Termine sind nicht an einem zentralen Ort.</p>
            </div>
            <div class="bh-problem-card">
                <i class="bi bi-chat-dots"></i>
                <h3>Ständige Rückfragen</h3>
                <p>Wer arbeitet heute wo? Welche Aufgabe steht noch an? Informationen müssen immer wieder gesucht werden.</p>
            </div>
            <div class="bh-problem-card">
                <i class="bi bi-calendar-x"></i>
                <h3>Schwierige Planung</h3>
                <p>Änderungen bei Einsätzen und Mitarbeitern lassen sich nur schwer übersichtlich koordinieren.</p>
            </div>
        </div>
    </div>
</section>

<section class="bh-solution">
    <div class="bh-container">
        <div class="bh-solution-grid">
            <div>
                <span class="bh-eyebrow">DIE LÖSUNG FÜR IHREN ARBEITSALLTAG</span>
                <h2 style="color:black;">Alles Wichtige an einem Ort.</h2>
                <p>
                    BauManagement bringt Ihre tägliche Organisation in eine zentrale,
                    digitale Oberfläche. So sehen Sie schneller, was geplant ist,
                    wer eingesetzt wird und welche Aufgaben anstehen.
                </p>

                <div class="bh-checks">
                    <div><i class="bi bi-check-circle-fill"></i><span>Baustellen zentral verwalten</span></div>
                    <div><i class="bi bi-check-circle-fill"></i><span>Mitarbeiter und Einsätze planen</span></div>
                    <div><i class="bi bi-check-circle-fill"></i><span>Aufgaben gezielt zuweisen</span></div>
                    <div><i class="bi bi-check-circle-fill"></i><span>Arbeitszeiten digital erfassen</span></div>
                    <div><i class="bi bi-check-circle-fill"></i><span>Urlaubsanträge übersichtlich verwalten</span></div>
                </div>
            </div>

            <div class="bh-feature-panel">
                <div class="bh-feature-panel-icon"><i class="bi bi-buildings"></i></div>
                <small>FÜR IHREN BETRIEB</small>
                <strong>Vom Büro bis zur Baustelle</strong>
                <p>
                    Eine Plattform für Chef, Bauleiter und Mitarbeiter –
                    auf Desktop, Tablet und Smartphone.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="bh-features">
    <div class="bh-container">
        <div class="bh-section-head center">
            <span class="bh-eyebrow">FÜR DEN TÄGLICHEN EINSATZ</span>
            <h2>Was BauManagement für Ihren Betrieb vereinfacht.</h2>
        </div>

        <div class="bh-feature-grid">
            <article>
                <div class="bh-icon orange"><i class="bi bi-buildings"></i></div>
                <h3>Baustellen</h3>
                <p>Alle Baustellen mit den wichtigsten Informationen zentral verwalten.</p>
            </article>

            <article>
                <div class="bh-icon blue"><i class="bi bi-people"></i></div>
                <h3>Mitarbeiter</h3>
                <p>Ihr Team organisieren und Mitarbeiter übersichtlich verwalten.</p>
            </article>

            <article>
                <div class="bh-icon purple"><i class="bi bi-calendar2-week"></i></div>
                <h3>Einsätze & Disposition</h3>
                <p>Planen Sie Mitarbeiter für konkrete Baustellen und Zeiträume.</p>
            </article>

            <article>
                <div class="bh-icon green"><i class="bi bi-calendar3"></i></div>
                <h3>Chef-Kalender</h3>
                <p>Sehen Sie auf einen Blick, wer wann auf welcher Baustelle eingeplant ist.</p>
            </article>

            <article>
                <div class="bh-icon orange"><i class="bi bi-check2-square"></i></div>
                <h3>Aufgaben</h3>
                <p>Aufgaben erstellen, zuweisen und den Status jederzeit im Blick behalten.</p>
            </article>

            <article>
                <div class="bh-icon blue"><i class="bi bi-clock-history"></i></div>
                <h3>Zeiterfassung</h3>
                <p>Arbeitsbeginn, Arbeitsende und erfasste Stunden digital verwalten.</p>
            </article>

            <article>
                <div class="bh-icon red"><i class="bi bi-sun"></i></div>
                <h3>Urlaub</h3>
                <p>Urlaubsanträge digital erfassen und zentral bearbeiten.</p>
            </article>

            <article>
                <div class="bh-icon green"><i class="bi bi-phone"></i></div>
                <h3>Mobil arbeiten</h3>
                <p>Auch unterwegs auf Aufgaben, Einsätze und wichtige Informationen zugreifen.</p>
            </article>
        </div>
    </div>
</section>

<section class="bh-who">
    <div class="bh-container">
        <div class="bh-section-head center">
            <span class="bh-eyebrow">FÜR WELCHE BETRIEBE?</span>
            <h2>Gemacht für Teams, die täglich auf Baustellen arbeiten.</h2>
            <p>
                BauManagement eignet sich besonders für kleine und mittlere Bau-
                und Handwerksbetriebe mit mehreren Mitarbeitern und Baustellen.
            </p>
        </div>

        <div class="bh-trade-list">
            <span><i class="bi bi-check2"></i> Trockenbau</span>
            <span><i class="bi bi-check2"></i> Malerbetriebe</span>
            <span><i class="bi bi-check2"></i> Elektro</span>
            <span><i class="bi bi-check2"></i> SHK</span>
            <span><i class="bi bi-check2"></i> Dachdecker</span>
            <span><i class="bi bi-check2"></i> Innenausbau</span>
            <span><i class="bi bi-check2"></i> Gebäudereinigung</span>
            <span><i class="bi bi-check2"></i> Garten- & Landschaftsbau</span>
        </div>
    </div>
</section>

<section class="bh-workflow">
    <div class="bh-container">
        <div class="bh-section-head center">
            <span class="bh-eyebrow">SO FUNKTIONIERT ES</span>
            <h2>Von der Planung bis zur Arbeitszeit.</h2>
        </div>

        <div class="bh-steps">
            <div class="bh-step">
                <span>01</span>
                <h3>Baustelle anlegen</h3>
                <p>Kunde, Adresse und wichtige Informationen zentral hinterlegen.</p>
            </div>
            <div class="bh-step">
                <span>02</span>
                <h3>Mitarbeiter einteilen</h3>
                <p>Mitarbeiter auswählen und Einsätze im Kalender planen.</p>
            </div>
            <div class="bh-step">
                <span>03</span>
                <h3>Aufgaben verteilen</h3>
                <p>Aufgaben gezielt Mitarbeitern oder Baustellen zuweisen.</p>
            </div>
            <div class="bh-step">
                <span>04</span>
                <h3>Arbeitszeit erfassen</h3>
                <p>Arbeitszeiten digital dokumentieren und übersichtlich verwalten.</p>
            </div>
        </div>
    </div>
</section>

<section class="bh-cta">
    <div class="bh-container">
        <div class="bh-cta-card">
            <span class="bh-eyebrow">BEREIT FÜR MEHR ÜBERBLICK?</span>
            <h2>Bringen Sie Ordnung in Ihre Baustellenplanung.</h2>
            <p>
                Organisieren Sie Mitarbeiter, Baustellen, Einsätze und Aufgaben
                zentral mit BauManagement.
            </p>

            <div class="bh-actions">
                <a href="Account/Register" class="bh-btn bh-btn-primary">
                    Kostenlos starten
                    <i class="bi bi-arrow-right"></i>
                </a>
                <a href="/preise" class="bh-btn bh-btn-secondary">
                    Preise ansehen
                </a>
            </div>
        </div>
    </div>
</section>

</div>
