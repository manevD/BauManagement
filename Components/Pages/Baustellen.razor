@page "/baustellen"

@using Microsoft.EntityFrameworkCore
@using BauManagement.Data
@using CompanyModel = BauManagement.Models.Company
@using BaustelleModel = BauManagement.Models.Baustelle
@inject ICurrentCompanyContext CurrentCompany

@rendermode InteractiveServer

@inject ApplicationDbContext Db

<PageTitle>Baustellen</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Baustellen</h1>
        <p class="text-muted mb-0">
            Projekte und Kundendaten pro Firma verwalten.
        </p>
    </div>

    <button class="btn btn-primary" @onclick="New">
        + Baustelle
    </button>
</div>

@if (editing)
{
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h2 class="h5">
                @(form.Id == Guid.Empty
                    ? "Neue Baustelle"
                    : "Baustelle bearbeiten")
            </h2>

            <EditForm Model="form" OnValidSubmit="Save">

                <div class="row g-3">

                    <!-- Name -->
                    <div class="col-md-6">
                        <label class="form-label">
                            Name *
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="form.Name" />
                    </div>

                    <!-- Kunde -->
                    <div class="col-md-4">
                        <label class="form-label">
                            Kunde
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="form.CustomerName" />
                    </div>

                    <!-- Kunden Telefon -->
                    <div class="col-md-4">
                        <label class="form-label">
                            Kunden-Telefon
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="form.CustomerPhone" />
                    </div>

                    <!-- Adresse -->
                    <div class="col-md-4">
                        <label class="form-label">
                            Adresse
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="form.Address" />
                    </div>

                    <!-- PLZ -->
                    <div class="col-md-3">
                        <label class="form-label">
                            PLZ
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="form.PostalCode" />
                    </div>

                    <!-- Stadt -->
                    <div class="col-md-3">
                        <label class="form-label">
                            Stadt
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="form.City" />
                    </div>

                    <!-- Start -->
                    <div class="col-md-3">
                        <label class="form-label">
                            Start
                        </label>

                        <InputDate class="form-control"
                                   @bind-Value="form.StartDate" />
                    </div>

                    <!-- Ende -->
                    <div class="col-md-3">
                        <label class="form-label">
                            Ende
                        </label>

                        <InputDate class="form-control"
                                   @bind-Value="form.EndDate" />
                    </div>

                    <!-- Beschreibung -->
                    <div class="col-12">
                        <label class="form-label">
                            Beschreibung
                        </label>

                        <InputTextArea class="form-control"
                                       @bind-Value="form.Description" />
                    </div>

                    <!-- Aktiv -->
                    <div class="col-12">

                        <div class="form-check">

                            <InputCheckbox class="form-check-input"
                                           @bind-Value="form.IsActive" />

                            <label class="form-check-label">
                                Aktiv
                            </label>

                        </div>

                    </div>

                </div>

                <div class="mt-3">

                    <button type="submit"
                            class="btn btn-success me-2">
                        Speichern
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="Cancel">
                        Abbrechen
                    </button>

                </div>

            </EditForm>

        </div>
    </div>
}

@if (message is not null)
{
    <div class="alert alert-warning">
        @message
    </div>
}

<div class="card shadow-sm">

    <div class="table-responsive">

        <table class="table table-hover mb-0">

            <thead>
                <tr>
                    <th>Baustelle</th>
                    <th>Firma</th>
                    <th>Adresse</th>
                    <th>Zeitraum</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

                @foreach (var site in sites)
                {
                    <tr>

                        <td>
                            <strong>
                                @site.Name
                            </strong>

                            <br />

                            <small class="text-muted">
                                @site.CustomerName
                            </small>
                        </td>

                        <td>
                            @site.Company.Name
                        </td>

                        <td>
                            @site.Address
                            <br />
                            @site.PostalCode @site.City
                        </td>

                        <td>
                            @site.StartDate?.ToString("dd.MM.yyyy")
                            –
                            @site.EndDate?.ToString("dd.MM.yyyy")
                        </td>

                        <td>

                            <span class="badge @(site.IsActive
                                ? "text-bg-success"
                                : "text-bg-secondary")">

                                @(site.IsActive
                                    ? "Aktiv"
                                    : "Inaktiv")

                            </span>

                        </td>

                        <td class="text-end">

                            <button class="btn btn-sm btn-outline-primary me-1"
                                    @onclick="() => Edit(site)">
                                Bearbeiten
                            </button>

                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => Delete(site)">
                                Löschen
                            </button>

                        </td>

                    </tr>
                }

                @if (!sites.Any())
                {
                    <tr>
                        <td colspan="6"
                            class="text-center text-muted py-4">

                            Noch keine Baustellen angelegt.

                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@code {

    private List<BaustelleModel> sites = [];
    private List<CompanyModel> companies = [];

    private BaustelleModel form = new();

    private bool editing;

    private string? message;


    protected override async Task OnInitializedAsync()
    {
        companies = await Db.Companies
            .AsNoTracking()
            .OrderBy(x => x.Name)
            .ToListAsync();

        await Load();
    }


    private async Task Load()
    {
        sites = await Db.Baustellen
            .Include(x => x.Company)
            .AsNoTracking()
            .OrderBy(x => x.Name)
            .ToListAsync();
    }


    private void New()
    {
        form = new BaustelleModel
        {
            IsActive = true
        };

        editing = true;
        message = null;
    }


    private void Edit(BaustelleModel x)
    {
        form = new BaustelleModel
        {
            Id = x.Id,
            CompanyId = x.CompanyId,
            Name = x.Name,
            Address = x.Address,
            PostalCode = x.PostalCode,
            City = x.City,
            CustomerName = x.CustomerName,
            CustomerPhone = x.CustomerPhone,
            StartDate = x.StartDate,
            EndDate = x.EndDate,
            IsActive = x.IsActive,
            Description = x.Description,
            CreatedAt = x.CreatedAt
        };

        editing = true;
        message = null;
    }


    private async Task Save()
    {
        message = null;
                var id = await CurrentCompany.GetCompanyIdAsync();

        if (!id.HasValue || 
            string.IsNullOrWhiteSpace(form.Name))
        {
            message = "Firma und Baustellenname sind erforderlich.";
            return;
        }
        form.CompanyId = id.Value;

        if (form.StartDate.HasValue &&
            form.EndDate.HasValue &&
            form.EndDate < form.StartDate)
        {
            message = "Das Enddatum muss nach dem Startdatum liegen.";
            return;
        }


        if (form.Id == Guid.Empty)
        {
            form.Id = Guid.NewGuid();

            Db.Baustellen.Add(form);
        }
        else
        {
            Db.Baustellen.Update(form);
        }


        await Db.SaveChangesAsync();

        editing = false;

        await Load();
    }


    private void Cancel()
    {
        editing = false;
        message = null;
    }


    private async Task Delete(BaustelleModel x)
    {
        try
        {
            var site = await Db.Baustellen
                .FirstOrDefaultAsync(b => b.Id == x.Id);

            if (site is null)
                return;

            Db.Baustellen.Remove(site);

            await Db.SaveChangesAsync();

            await Load();
        }
        catch
        {
            message =
                "Baustellen mit zugehörigen Aufgaben oder Einsätzen können nicht gelöscht werden.";
        }
    }
}