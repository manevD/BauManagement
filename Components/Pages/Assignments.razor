@page "/assignments"

@using Microsoft.EntityFrameworkCore
@using BauManagement.Data
@using CompanyModel = BauManagement.Models.Company
@using EmployeeModel = BauManagement.Models.Employee
@using BaustelleModel = BauManagement.Models.Baustelle
@using WorkAssignmentModel = BauManagement.Models.WorkAssignment

@rendermode InteractiveServer

@inject ApplicationDbContext Db

<PageTitle>Disposition</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Disposition</h1>
        <p class="text-muted mb-0">
            Einsätze erscheinen im Chef- und Mitarbeiterkalender aus denselben Daten.
        </p>
    </div>

    <button class="btn btn-primary" @onclick="New">
        + Einsatz
    </button>
</div>

@if (editing)
{
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h2 class="h5">
                @(form.Id == Guid.Empty ? "Neuer Einsatz" : "Einsatz bearbeiten")
            </h2>

            <EditForm Model="form" OnValidSubmit="Save">

                <div class="row g-3">

                    <!-- Firma -->
                    <div class="col-md-4">
                        <label class="form-label">Firma *</label>

                        <InputSelect class="form-select"
                                     @bind-Value="form.CompanyId">

                            <option value="@Guid.Empty">
                                Bitte wählen
                            </option>

                            @foreach (var company in companies)
                            {
                                <option value="@company.Id">
                                    @company.Name
                                </option>
                            }

                        </InputSelect>
                    </div>

                    <!-- Mitarbeiter -->
                    <div class="col-md-4">
                        <label class="form-label">Mitarbeiter *</label>

                        <InputSelect class="form-select"
                                     @bind-Value="form.EmployeeId">

                            <option value="@Guid.Empty">
                                Bitte wählen
                            </option>

                            @foreach (var employee in employees
                                .Where(x => x.CompanyId == form.CompanyId))
                            {
                                <option value="@employee.Id">
                                    @employee.FirstName @employee.LastName
                                </option>
                            }

                        </InputSelect>
                    </div>

                    <!-- Baustelle -->
                    <div class="col-md-4">
                        <label class="form-label">Baustelle *</label>

                        <InputSelect class="form-select"
                                     @bind-Value="form.BaustelleId">

                            <option value="@Guid.Empty">
                                Bitte wählen
                            </option>

                            @foreach (var site in sites
                                .Where(x => x.CompanyId == form.CompanyId))
                            {
                                <option value="@site.Id">
                                    @site.Name
                                </option>
                            }

                        </InputSelect>
                    </div>

                    <!-- Beginn -->
                    <div class="col-md-4">
                        <label class="form-label">Beginn *</label>

                        <InputDate Type="InputDateType.DateTimeLocal"
                                   class="form-control"
                                   @bind-Value="form.Start" />
                    </div>

                    <!-- Ende -->
                    <div class="col-md-4">
                        <label class="form-label">Ende *</label>

                        <InputDate Type="InputDateType.DateTimeLocal"
                                   class="form-control"
                                   @bind-Value="form.End" />
                    </div>

                    <!-- Notiz -->
                    <div class="col-md-4">
                        <label class="form-label">Notiz</label>

                        <InputText class="form-control"
                                   @bind-Value="form.Notes" />
                    </div>

                </div>

                <div class="mt-3">

                    <button type="submit"
                            class="btn btn-success me-2">
                        Speichern
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="Cancel">
                        Abbrechen
                    </button>

                </div>

            </EditForm>

        </div>
    </div>
}

@if (message is not null)
{
    <div class="alert alert-warning">
        @message
    </div>
}

<div class="card shadow-sm">

    <div class="table-responsive">

        <table class="table table-hover mb-0">

            <thead>
                <tr>
                    <th>Zeitraum</th>
                    <th>Mitarbeiter</th>
                    <th>Baustelle</th>
                    <th>Firma</th>
                    <th>Notiz</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

                @foreach (var assignment in assignments)
                {
                    <tr>

                        <td>
                            @assignment.Start.ToString("dd.MM.yyyy HH:mm")
                            <br />
                            – @assignment.End.ToString("dd.MM.yyyy HH:mm")
                        </td>

                        <td>
                            @assignment.Employee.FirstName
                            @assignment.Employee.LastName
                        </td>

                        <td>
                            @assignment.Baustelle.Name
                        </td>

                        <td>
                            @assignment.Company.Name
                        </td>

                        <td>
                            @assignment.Notes
                        </td>

                        <td class="text-end">

                            <button class="btn btn-sm btn-outline-primary me-1"
                                    @onclick="() => Edit(assignment)">
                                Bearbeiten
                            </button>

                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => Delete(assignment)">
                                Löschen
                            </button>

                        </td>

                    </tr>
                }

                @if (!assignments.Any())
                {
                    <tr>
                        <td colspan="6"
                            class="text-center text-muted py-4">
                            Noch keine Einsätze angelegt.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@code {

    private List<WorkAssignmentModel> assignments = [];
    private List<CompanyModel> companies = [];
    private List<EmployeeModel> employees = [];
    private List<BaustelleModel> sites = [];

    private WorkAssignmentModel form = CreateNew();

    private bool editing;

    private string? message;


    protected override async Task OnInitializedAsync()
    {
        companies = await Db.Companies
            .AsNoTracking()
            .OrderBy(x => x.Name)
            .ToListAsync();

        employees = await Db.Employees
            .AsNoTracking()
            .Where(x => x.IsActive)
            .OrderBy(x => x.LastName)
            .ToListAsync();

        sites = await Db.Baustellen
            .AsNoTracking()
            .Where(x => x.IsActive)
            .OrderBy(x => x.Name)
            .ToListAsync();

        await Load();
    }


    private static WorkAssignmentModel CreateNew()
    {
        return new WorkAssignmentModel
        {
            Start = DateTime.Today.AddHours(8),
            End = DateTime.Today.AddHours(16)
        };
    }


    private async Task Load()
    {
        assignments = await Db.WorkAssignments
            .Include(x => x.Company)
            .Include(x => x.Employee)
            .Include(x => x.Baustelle)
            .AsNoTracking()
            .OrderByDescending(x => x.Start)
            .ToListAsync();
    }


    private void New()
    {
        form = CreateNew();
        editing = true;
        message = null;
    }


    private void Edit(WorkAssignmentModel x)
    {
        form = new WorkAssignmentModel
        {
            Id = x.Id,
            CompanyId = x.CompanyId,
            EmployeeId = x.EmployeeId,
            BaustelleId = x.BaustelleId,
            Start = x.Start,
            End = x.End,
            Notes = x.Notes,
            CreatedAt = x.CreatedAt
        };

        editing = true;
        message = null;
    }


    private async Task Save()
    {
        message = null;

        if (form.CompanyId == Guid.Empty ||
            form.EmployeeId == Guid.Empty ||
            form.BaustelleId == Guid.Empty)
        {
            message = "Firma, Mitarbeiter und Baustelle sind erforderlich.";
            return;
        }


        if (form.End <= form.Start)
        {
            message = "Das Ende muss nach dem Beginn liegen.";
            return;
        }


        var employeeExists = employees.Any(x =>
            x.Id == form.EmployeeId &&
            x.CompanyId == form.CompanyId);

        var siteExists = sites.Any(x =>
            x.Id == form.BaustelleId &&
            x.CompanyId == form.CompanyId);


        if (!employeeExists || !siteExists)
        {
            message = "Mitarbeiter und Baustelle müssen zur selben Firma gehören.";
            return;
        }


        if (form.Id == Guid.Empty)
        {
            form.Id = Guid.NewGuid();

            Db.WorkAssignments.Add(form);
        }
        else
        {
            var assignment = await Db.WorkAssignments
                .FirstOrDefaultAsync(x => x.Id == form.Id);

            if (assignment is null)
            {
                message = "Einsatz wurde nicht gefunden.";
                return;
            }

            assignment.CompanyId = form.CompanyId;
            assignment.EmployeeId = form.EmployeeId;
            assignment.BaustelleId = form.BaustelleId;
            assignment.Start = form.Start;
            assignment.End = form.End;
            assignment.Notes = form.Notes;
        }


        await Db.SaveChangesAsync();

        editing = false;

        await Load();
    }


    private void Cancel()
    {
        editing = false;
        message = null;
    }


    private async Task Delete(WorkAssignmentModel x)
    {
        var assignment = await Db.WorkAssignments
            .FirstOrDefaultAsync(a => a.Id == x.Id);

        if (assignment is null)
            return;

        Db.WorkAssignments.Remove(assignment);

        await Db.SaveChangesAsync();

        await Load();
    }
}