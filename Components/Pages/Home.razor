<!-- =========================================================
     INTRO
========================================================= -->

<section class="intro-section py-5 py-lg-6">

    <div class="container">

        <div class="section-heading text-center mx-auto">

            <span class="section-eyebrow">
                ALLES AN EINEM ORT
            </span>

            <h2>

                Schluss mit Zetteln, WhatsApp
                <br class="d-none d-md-block" />
                und Excel-Listen.

            </h2>

            <p>

                Mit BauManagement organisierst du deine Baustellen,
                Mitarbeiter, Aufgaben, Einsätze und Arbeitszeiten
                zentral – übersichtlich, digital und jederzeit erreichbar.

            </p>

        </div>

    </div>

</section>



<!-- =========================================================
     FEATURES
========================================================= -->

<section id="funktionen" class="features-section py-5 py-lg-6">

    <div class="container">

        <div class="section-heading text-center mx-auto">

            <span class="section-eyebrow">
                DEINE WICHTIGSTEN FUNKTIONEN
            </span>

            <h2>
                Alles, was du für deine Baustellen brauchst.
            </h2>

            <p>

                Eine zentrale Lösung für die tägliche Organisation
                deines Bau- oder Handwerksbetriebs.

            </p>

        </div>


        <div class="row g-4 mt-3">


            <!-- BAUSTELLEN -->

            <div class="col-md-6 col-lg-4">

                <div class="feature-card">

                    <div class="feature-icon orange">

                        <i class="bi bi-buildings"></i>

                    </div>

                    <h3>
                        Baustellenverwaltung
                    </h3>

                    <p>

                        Verwalte alle Baustellen zentral mit Adresse,
                        Kunde, Kontaktdaten, Zeitraum, Beschreibung
                        und zugeordneten Mitarbeitern.

                    </p>

                    <span class="feature-link">

                        Baustellen immer griffbereit

                        <i class="bi bi-arrow-right"></i>

                    </span>

                </div>

            </div>


            <!-- MITARBEITER -->

            <div class="col-md-6 col-lg-4">

                <div class="feature-card">

                    <div class="feature-icon blue">

                        <i class="bi bi-people"></i>

                    </div>

                    <h3>
                        Mitarbeiterverwaltung
                    </h3>

                    <p>

                        Mitarbeiter anlegen, bearbeiten und verwalten.
                        Mit Kontaktinformationen, Position,
                        Status und eigenen Benutzerzugängen.

                    </p>

                    <span class="feature-link">

                        Dein Team zentral verwalten

                        <i class="bi bi-arrow-right"></i>

                    </span>

                </div>

            </div>


            <!-- EINSÄTZE -->

            <div class="col-md-6 col-lg-4">

                <div class="feature-card">

                    <div class="feature-icon purple">

                        <i class="bi bi-calendar2-week"></i>

                    </div>

                    <h3>
                        Einsätze & Disposition
                    </h3>

                    <p>

                        Plane Mitarbeiter für konkrete Baustellen
                        mit Start- und Endzeit. Behalte alle Einsätze
                        übersichtlich im Blick.

                    </p>

                    <span class="feature-link">

                        Mitarbeiter richtig einsetzen

                        <i class="bi bi-arrow-right"></i>

                    </span>

                </div>

            </div>


            <!-- CHEF KALENDER -->

            <div class="col-md-6 col-lg-4">

                <div class="feature-card">

                    <div class="feature-icon green">

                        <i class="bi bi-calendar3"></i>

                    </div>

                    <h3>
                        Chef-Kalender
                    </h3>

                    <p>

                        Sieh auf einen Blick, welcher Mitarbeiter
                        wann auf welcher Baustelle eingeplant ist.
                        Einsätze lassen sich direkt organisieren.

                    </p>

                    <span class="feature-link">

                        Planung auf einen Blick

                        <i class="bi bi-arrow-right"></i>

                    </span>

                </div>

            </div>


            <!-- AUFGABEN -->

            <div class="col-md-6 col-lg-4">

                <div class="feature-card">

                    <div class="feature-icon orange">

                        <i class="bi bi-check2-square"></i>

                    </div>

                    <h3>
                        Aufgabenverwaltung
                    </h3>

                    <p>

                        Erstelle Aufgaben und ordne sie den richtigen
                        Mitarbeitern und Baustellen zu. Fortschritt
                        und Status bleiben jederzeit sichtbar.

                    </p>

                    <span class="feature-link">

                        Aufgaben klar verteilen

                        <i class="bi bi-arrow-right"></i>

                    </span>

                </div>

            </div>


            <!-- ZEITERFASSUNG -->

            <div class="col-md-6 col-lg-4">

                <div class="feature-card">

                    <div class="feature-icon orange">

                        <i class="bi bi-clock-history"></i>

                    </div>

                    <h3>
                        Zeiterfassung
                    </h3>

                    <p>

                        Arbeitszeiten digital erfassen und den Überblick
                        behalten. Arbeitsbeginn, Arbeitsende und
                        erfasste Stunden zentral verwalten.

                    </p>

                    <span class="feature-link">

                        Arbeitszeit digital erfassen

                        <i class="bi bi-arrow-right"></i>

                    </span>

                </div>

            </div>


            <!-- URLAUB -->

            <div class="col-md-6 col-lg-4">

                <div class="feature-card">

                    <div class="feature-icon red">

                        <i class="bi bi-sun"></i>

                    </div>

                    <h3>
                        Urlaubsverwaltung
                    </h3>

                    <p>

                        Mitarbeiter können Urlaub digital beantragen.
                        Admins und Chefs sehen Anträge und können
                        diese direkt genehmigen oder ablehnen.

                    </p>

                    <span class="feature-link">

                        Urlaub einfach organisieren

                        <i class="bi bi-arrow-right"></i>

                    </span>

                </div>

            </div>

            <!-- LIVE SEARCH -->

            <div class="col-md-6 col-lg-4">

                <div class="feature-card">

                    <div class="feature-icon blue">

                        <i class="bi bi-search"></i>

                    </div>

                    <h3>
                        Schnelle Live-Suche
                    </h3>

                    <p>

                        Mitarbeiter, Baustellen und Aufgaben schnell
                        finden – mit Live-Suche und übersichtlichen
                        Listen ohne komplizierte Navigation.

                    </p>

                    <span class="feature-link">

                        Informationen sofort finden

                        <i class="bi bi-arrow-right"></i>

                    </span>

                </div>

            </div>


            <!-- MOBILE -->

            <div class="col-md-6 col-lg-4">

                <div class="feature-card">

                    <div class="feature-icon green">

                        <i class="bi bi-phone"></i>

                    </div>

                    <h3>
                        Desktop & Mobile
                    </h3>

                    <p>

                        Die Oberfläche ist für Desktop, Tablet und
                        Smartphone optimiert. Mitarbeiter können ihre
                        Aufgaben auch direkt unterwegs nutzen.

                    </p>

                    <span class="feature-link">

                        Büro und Baustelle verbinden

                        <i class="bi bi-arrow-right"></i>

                    </span>

                </div>

            </div>

        </div>

    </div>

</section>



