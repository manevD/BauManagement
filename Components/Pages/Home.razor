@page "/"
@layout LandingLayout

@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>BauManagement – Baustellenplanung für Bau & Handwerk</PageTitle>



<!-- =========================================================
     HERO
========================================================= -->

<section class="landing-hero text-white">

    <nav class="landing-nav container" aria-label="Hauptnavigation">

        <a class="brand" href="/" aria-label="BauManagement Startseite">
            <span class="brand-bau">Bau</span><span class="brand-management" style="color:#ff9f45;">Management</span>
        </a>

        <input type="checkbox" id="bm-mobile-menu" class="bm-mobile-menu-toggle" />

        <label for="bm-mobile-menu" class="bm-mobile-menu-button" aria-label="Menü öffnen">
            <span></span>
            <span></span>
            <span></span>
        </label>

        <div class="landing-nav-menu">
            <a href="/funktionen">Funktionen</a>
            <a href="/preise">Preise</a>
            <a href="/fuer-bau-handwerk" class="nav-b2b">
                <i class="bi bi-building"></i>
                Für Bau- & Handwerksbetriebe
            </a>

            <a href="/datenschutz">Datenschutzerklärung</a>
            <a href="/impressum">Impressum</a>

            <div class="bm-mobile-actions">
                <AuthorizeView>
                    <NotAuthorized>
                                          <a class="btn btn-primary nav-login" href="Account/Login">
                            Anmelden
                        </a>
                           <a class="btn btn-primary fw-semibold nav-action"  href="Account/Register">
                            Kostenlos starten
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </NotAuthorized>
                    <Authorized>
                        <a class="bm-mobile-register" href="/tasks">
                            Zum Dashboard
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>



    </nav>


    <div class="container py-5 py-lg-6">

        <div class="row align-items-center g-5">

            <!-- HERO TEXT -->

            <div class="col-lg-7">

                <span class="hero-eyebrow">
                    BAUSTELLENPLANUNG FÜR BAU & HANDWERK
                </span>

                <h3 class="hero-title mt-3">

                    Wer arbeitet heute
                    <br />

                    auf welcher Baustelle?
                    <br />

                    <span>Mit BauManagement sehen Sie es sofort.</span>

                </h3>


                <p class="hero-description mt-4">

                    BauManagement hilft Bau- und Handwerksbetrieben dabei, Mitarbeiter,
                    Baustellen, Einsätze, Aufgaben und Arbeitszeiten zentral
                    zu organisieren – einfach, übersichtlich und digital.

                </p>


                <AuthorizeView>

                    <Authorized>

                        <div class="d-flex flex-wrap gap-3 mt-4">

                            <a class="btn btn-warning btn-lg px-4 fw-semibold"
                               href="/tasks">

                                Zum Dashboard

                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>


                            <a class="btn btn-hero-link btn-lg"
                               href="/funktionen">

                                So funktioniert BauManagement

                                <i class="bi bi-chevron-down ms-2"></i>

                            </a>

                        </div>


                        <div class="hero-trust mt-4">

                            <span>
                                <i class="bi bi-check-circle-fill"></i>
                                Baustellen
                            </span>

                            <span>
                                <i class="bi bi-check-circle-fill"></i>
                                Mitarbeiter
                            </span>

                            <span>
                                <i class="bi bi-check-circle-fill"></i>
                                Aufgaben
                            </span>

                            <span>
                                <i class="bi bi-check-circle-fill"></i>
                                Zeiterfassung
                            </span>

                        </div>

                    </Authorized>


                    <NotAuthorized>

                        <div class="d-flex flex-wrap gap-3 mt-4">

                            <a class="btn btn-primary btn-lg px-4 fw-semibold"
                               href="Account/Register">

                                Kostenlos starten

                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>


                            <a class="btn btn-hero-link btn-lg"
                               href="/funktionen">

                                So funktioniert BauManagement

                                <i class="bi bi-chevron-down ms-2"></i>

                            </a>

                        </div>


                        <div class="hero-trust mt-4">

                            <span>
                                <i class="bi bi-check-circle-fill"></i>
                                Keine Kreditkarte erforderlich
                            </span>

                            <span>
                                <i class="bi bi-check-circle-fill"></i>
                                Einfach einzurichten
                            </span>

                            <span>
                                <i class="bi bi-check-circle-fill"></i>
                                Für Bau & Handwerk
                            </span>

                        </div>

                    </NotAuthorized>

                </AuthorizeView>

            </div>


            <!-- HERO DASHBOARD PREVIEW -->

            <div class="col-lg-5">

                <div class="dashboard-preview">

                    <div class="preview-top">

                        <div>

                            <small>
                                HEUTE
                            </small>

                            <strong>
                                Baustellenübersicht
                            </strong>

                        </div>


                        <span class="live-badge">

                            <span></span>

                            Live

                        </span>

                    </div>


                    <!-- STATS -->

                    <div class="preview-stats">

                        <div class="preview-stat">

                            <div class="preview-stat-icon orange">

                                <i class="bi bi-buildings"></i>

                            </div>

                            <div>

                                <strong>12</strong>

                                <small>
                                    Baustellen
                                </small>

                            </div>

                        </div>


                        <div class="preview-stat">

                            <div class="preview-stat-icon blue">

                                <i class="bi bi-people"></i>

                            </div>

                            <div>

                                <strong>24</strong>

                                <small>
                                    Mitarbeiter
                                </small>

                            </div>

                        </div>


                        <div class="preview-stat">

                            <div class="preview-stat-icon green">

                                <i class="bi bi-check2-square"></i>

                            </div>

                            <div>

                                <strong>18</strong>

                                <small>
                                    Aufgaben
                                </small>

                            </div>

                        </div>

                    </div>


                    <!-- ASSIGNMENTS -->

                    <div class="preview-section-title">

                        <span>
                            Heutige Einsätze
                        </span>

                        <span>
                            08:00 – 17:00
                        </span>

                    </div>


                    <div class="preview-assignment">

                        <div class="preview-avatar">
                            MK
                        </div>

                        <div class="preview-assignment-content">

                            <strong>
                                Marko K.
                            </strong>

                            <span>

                                <i class="bi bi-geo-alt"></i>

                                Müller GmbH

                            </span>

                        </div>

                        <div class="preview-time">

                            08:00

                            <small>
                                12:00
                            </small>

                        </div>

                    </div>


                    <div class="preview-assignment">

                        <div class="preview-avatar orange">
                            ST
                        </div>

                        <div class="preview-assignment-content">

                            <strong>
                                Stefan T.
                            </strong>

                            <span>

                                <i class="bi bi-geo-alt"></i>

                                Neubau Weber

                            </span>

                        </div>

                        <div class="preview-time">

                            08:00

                            <small>
                                16:00
                            </small>

                        </div>

                    </div>


                    <div class="preview-assignment">

                        <div class="preview-avatar green">
                            DA
                        </div>

                        <div class="preview-assignment-content">

                            <strong>
                                Daniel A.
                            </strong>

                            <span>

                                <i class="bi bi-geo-alt"></i>

                                Sanierung Schmidt

                            </span>

                        </div>

                        <div class="preview-time">

                            10:00

                            <small>
                                14:00
                            </small>

                        </div>

                    </div>


                    <!-- TIME -->

                    <div class="preview-time-row">

                        <div>

                            <i class="bi bi-clock-history"></i>

                            <span>
                                Arbeitszeit heute
                            </span>

                        </div>

                        <strong>
                            06:42 h
                        </strong>

                    </div>


                    <div class="preview-footer">

                        <i class="bi bi-calendar3"></i>

                        Alle Einsätze im Chef-Kalender verwalten

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =========================================================
     INTRO
========================================================= -->

<section class="intro-section py-5 py-lg-6">

    <div class="container">

        <div class="section-heading text-center mx-auto">

            <span class="section-eyebrow">
                WENIGER CHAOS. MEHR ÜBERBLICK.
            </span>

            <h2>

                Schluss mit Excel, Zetteln
                <br class="d-none d-md-block" />
                und unübersichtlichen WhatsApp-Nachrichten.

            </h2>

            <p>

                Mit BauManagement organisieren Sie Ihre Baustellen,
                Mitarbeiter, Aufgaben, Einsätze und Arbeitszeiten
                zentral – übersichtlich, digital und jederzeit erreichbar.

            </p>

        </div>

    </div>

</section>



<!-- =========================================================
     DIGITALE ZEITERFASSUNG
========================================================= -->

<section class="time-section py-5 py-lg-6">

    <div class="container">

        <div class="row align-items-center g-5">


            <!-- TEXT -->

            <div class="col-lg-6">

                <span class="section-eyebrow">
                    DIGITALE ZEITERFASSUNG
                </span>

                <h2 style="color:black;">
                    Arbeitszeiten einfach und digital erfassen.
                </h2>

                <p class="text-muted mt-3">

                    Keine Zettel und keine manuellen Listen.
                    Mitarbeiter erfassen ihre Arbeitszeiten direkt digital,
                    während Sie als Chef jederzeit den Überblick behalten.

                </p>


                <div class="time-features mt-4">


                    <div class="time-feature">

                        <div class="time-feature-icon">

                            <i class="bi bi-play-circle"></i>

                        </div>

                        <div>

                            <strong style="color:black">
                                Arbeitsbeginn erfassen
                            </strong>

                            <span>
                                Arbeitszeit direkt beim Arbeitsbeginn erfassen.
                            </span>

                        </div>

                    </div>


                    <div class="time-feature">

                        <div class="time-feature-icon">

                            <i class="bi bi-stop-circle"></i>

                        </div>

                        <div>

                            <strong style="color:black">
                                Arbeitsende erfassen
                            </strong>

                            <span>
                                Arbeitszeit am Ende des Arbeitstags beenden.
                            </span>

                        </div>

                    </div>


                    <div class="time-feature">

                        <div class="time-feature-icon">

                            <i class="bi bi-clock"></i>

                        </div>

                        <div>

                            <strong style="color:black">
                                Arbeitsstunden im Überblick
                            </strong>

                            <span>
                                Erfasste Arbeitszeiten übersichtlich darstellen.
                            </span>

                        </div>

                    </div>


                    <div class="time-feature">

                        <div class="time-feature-icon">

                            <i class="bi bi-bar-chart"></i>

                        </div>

                        <div>

                            <strong style="color:black">
                                Auswertungen
                            </strong>

                            <span>
                                Arbeitszeiten nach Mitarbeiter
                                und Zeitraum auswerten.
                            </span>

                        </div>

                    </div>


                </div>

            </div>


            <!-- PREVIEW -->

            <div class="col-lg-6">

                <div class="time-dashboard">


                    <div class="time-dashboard-header">

                        <div>

                            <small>
                                ARBEITSZEIT
                            </small>

                            <strong>
                                Heute
                            </strong>

                        </div>


                        <span class="time-status">

                            <span></span>

                            Aktiv

                        </span>

                    </div>


                    <div class="time-main">

                        <span class="time-label">
                            Aktuelle Arbeitszeit
                        </span>

                        <strong class="time-value">
                            06:42
                        </strong>

                        <span class="time-location">

                            <i class="bi bi-geo-alt"></i>

                            Baustelle Müller GmbH

                        </span>

                    </div>


                    <div class="time-progress">

                        <div class="time-progress-top">

                            <span>
                                Arbeitszeit heute
                            </span>

                            <strong>
                                06:42 / 08:00
                            </strong>

                        </div>


                        <div class="time-progress-bar">

                            <span style="width:84%;"></span>

                        </div>

                    </div>


                    <div class="time-summary">


                        <div>

                            <small>
                                Beginn
                            </small>

                            <strong>
                                07:18
                            </strong>

                        </div>


                        <div>

                            <small>
                                Pause
                            </small>

                            <strong>
                                00:30
                            </strong>

                        </div>


                        <div>

                            <small>
                                Ende
                            </small>

                            <strong>
                                15:30
                            </strong>

                        </div>


                    </div>


                    <div class="time-action">

                        <button class="btn btn-primary w-100">

                            <i class="bi bi-stop-circle me-2"></i>

                            Arbeitszeit beenden

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =========================================================
     ROLLEN
========================================================= -->

<section class="roles-section py-5 py-lg-6">

    <div class="container">

        <div class="section-heading text-center mx-auto">

            <span class="section-eyebrow">
                FÜR CHEFS & MITARBEITER
            </span>

            <h2>
                Jeder sieht genau das, was er für seine Arbeit braucht.
            </h2>

            <p>

                Unterschiedliche Rollen sorgen dafür, dass
                jeder Benutzer die passenden Funktionen erhält.

            </p>

        </div>


        <div class="row g-4 mt-2">


            <!-- CHEF -->

            <div class="col-md-6">

                <div class="role-card featured-role">

                    <div class="role-icon">

                        <i class="bi bi-person-workspace"></i>

                    </div>

                    <span>
                        CHEF
                    </span>

                    <h3>
                        Planung & Kontrolle
                    </h3>

                    <p>

                        Behalten Sie Mitarbeiter, Einsätze,
                        Baustellen, Aufgaben und Urlaubsanträge
                        zentral im Überblick.

                    </p>

                </div>

            </div>


            <!-- MITARBEITER -->

            <div class="col-md-6">

                <div class="role-card">

                    <div class="role-icon">

                        <i class="bi bi-person"></i>

                    </div>

                    <span>
                        MITARBEITER
                    </span>

                    <h3>
                        Aufgaben & Einsätze im Fokus
                    </h3>

                    <p>

                        Mitarbeiter sehen ihre eigenen Aufgaben und Einsätze
                        und können den Aufgabenstatus direkt aktualisieren.

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     MOBILE
========================================================= -->

<section class="mobile-section py-5 py-lg-6">

    <div class="container">

        <div class="row align-items-center g-5">


            <!-- MOBILE SCREENSHOT -->

            <div class="col-lg-6 order-2 order-lg-1">

                <div class="mobile-image-preview">

                    <div class="mobile-image-glow"></div>

                    <img src="images/mobile-preview.png"
                         alt="BauManagement auf dem Smartphone"
                         class="mobile-preview-image" />

                </div>

            </div>


            <!-- TEXT -->

            <div class="col-lg-6 order-1 order-lg-2">

                <span class="section-eyebrow">
                    AUF DESKTOP, TABLET & SMARTPHONE
                </span>

                <h2 class="mt-2">

                    Ihre Baustelle ist nicht im Büro?
                    Kein Problem.

                </h2>

                <p class="text-muted mt-3">

                    BauManagement funktioniert auf Smartphone, Tablet und Desktop –
                    damit Ihre Mitarbeiter auch unterwegs Zugriff haben.

                </p>


                <div class="check-list mt-4">

                    <div>

                        <i class="bi bi-check-circle-fill"></i>

                        Aufgaben unterwegs ansehen

                    </div>


                    <div>

                        <i class="bi bi-check-circle-fill"></i>

                        Aufgabenstatus direkt aktualisieren

                    </div>


                    <div>

                        <i class="bi bi-check-circle-fill"></i>

                        Arbeitszeiten unterwegs erfassen

                    </div>


                    <div>

                        <i class="bi bi-check-circle-fill"></i>

                        Optimierte Darstellung auf allen Geräten

                    </div>


                    <div>

                        <i class="bi bi-check-circle-fill"></i>

                        Eine Plattform für Büro und Baustelle

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =========================================================
     FINAL CTA
========================================================= -->

<section class="final-cta py-5 py-lg-6">

    <div class="container">

        <div class="final-cta-card text-center">

            <div class="final-cta-icon">

                <i class="bi bi-buildings"></i>

            </div>


            <span class="section-eyebrow">

                BRINGEN SIE ORDNUNG IN IHRE BAUSTELLEN

            </span>


            <h2>
                Behalten Sie Ihre Baustellen und Mitarbeiter im Griff.
            </h2>


            <p>

                Planen Sie Mitarbeiter, Baustellen, Einsätze und Aufgaben zentral
                und behalten Sie Ihre Arbeitszeiten jederzeit im Blick.

            </p>


            <a href="Account/Register"
               class="btn btn-primary btn-lg px-5 fw-semibold">

                Kostenlos starten

                <i class="bi bi-arrow-right ms-2"></i>

            </a>


            <small>

                Keine Kreditkarte erforderlich ·
                Zahlung wird später aktiviert

            </small>

        </div>

    </div>

</section>



