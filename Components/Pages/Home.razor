<script>
(function () {
    const stage = document.querySelector('.bm-3d-stage');
    const device = document.getElementById('bm3dDevice');
    const eyebrow = document.getElementById('bm3dEyebrow');
    const title = document.getElementById('bm3dTitle');
    const copy = document.getElementById('bm3dText');
    const bars = document.querySelectorAll('.bm-3d-progress span');
    const leftWord = document.querySelector('.bm-word-left');
    const rightWord = document.querySelector('.bm-word-right');
    
    if (!stage || !device) return;

    const scenes = [
        ['DIGITALE BAUSTELLENPLANUNG', 'Alles im Blick.', 'Baustellen, Mitarbeiter und Einsätze in einer einzigen übersichtlichen Ansicht.'],
        ['MITARBEITER & EINSÄTZE', 'Wer arbeitet wo?', 'Sehen Sie sofort, welcher Mitarbeiter wann auf welcher Baustelle eingeplant ist.'],
        ['CHEF-KALENDER', 'Planung ohne Chaos.', 'Einsätze, Zeiten und Aufgaben werden zentral geplant und übersichtlich dargestellt.'],
        ['BAUMANAGEMENT DIGITAL', 'Mehr Überblick. Weniger Aufwand.', 'Vom Büro bis zur Baustelle: myBauManagement verbindet Ihre tägliche Organisation.']
    ];

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let pointerX = 0, pointerY = 0, targetX = 0, targetY = 0, ticking = false;
    let currentScene = -1;

    const clamp = (val, min, max) => Math.min(Math.max(val, min), max);

    function updatePointer(e) {
        if (reduceMotion || window.innerWidth < 992) return;
        const rect = device.getBoundingClientRect();
        targetX = clamp((e.clientX - (rect.left + rect.width / 2)) / rect.width, -0.5, 0.5);
        targetY = clamp((e.clientY - (rect.top + rect.height / 2)) / rect.height, -0.5, 0.5);
        if (!ticking) {
            ticking = true;
            requestAnimationFrame(animatePointer);
        }
    }

    function animatePointer() {
        pointerX += (targetX - pointerX) * 0.1;
        pointerY += (targetY - pointerY) * 0.1;
        device.style.setProperty('--pointer-rx', (pointerY * -6).toFixed(2) + 'deg');
        device.style.setProperty('--pointer-ry', (pointerX * 8).toFixed(2) + 'deg');
        ticking = Math.abs(targetX - pointerX) > 0.001 || Math.abs(targetY - pointerY) > 0.001;
        if (ticking) requestAnimationFrame(animatePointer);
    }

    stage.addEventListener('pointermove', updatePointer, { passive: true });
    stage.addEventListener('pointerleave', () => { targetX = 0; targetY = 0; }, { passive: true });

    let scrollFrame = 0;

    function render() {
        const rect = stage.getBoundingClientRect();
        const maxScroll = stage.offsetHeight - window.innerHeight;
        if (maxScroll <= 0) return;

        const p = clamp(-rect.top / maxScroll, 0, 1);
        const isMobile = window.innerWidth < 992;

        // Custom easing for smooth transitions
        const ease = p * p * (3 - 2 * p);

        // Adjust parameters per breakpoint
        const moveX = isMobile ? (ease * -10) : (ease * -35);
        const moveY = isMobile ? (30 - ease * 60) : (50 - ease * 120);
        const rx = isMobile ? (8 - ease * 12) : (12 - ease * 20);
        const ry = isMobile ? (-10 + ease * 20) : (-22 + ease * 44);
        const rz = isMobile ? 0 : (-2 + ease * 4);
        const baseScale = isMobile ? 0.85 : 0.72;
        const scale = baseScale + Math.sin(p * Math.PI) * (isMobile ? 0.12 : 0.22);

        device.style.transform = `translate3d(${moveX}px, ${moveY}px, 0) rotateX(calc(${rx}deg + var(--pointer-rx, 0deg))) rotateY(calc(${ry}deg + var(--pointer-ry, 0deg))) rotateZ(${rz}deg) scale(${scale})`;
        device.classList.toggle('deep', p > 0.25);

        if (leftWord && rightWord) {
            const word = clamp(p / 0.4, 0, 1);
            const wordEase = 1 - Math.pow(1 - word, 3);
            const wordDist = isMobile ? 12 : 22;
            leftWord.style.transform = `translate3d(${wordEase * wordDist}vw, -90%, 0) rotateY(${(1 - wordEase) * 25}deg)`;
            rightWord.style.transform = `translate3d(${-wordEase * wordDist}vw, 10%, 0) rotateY(${(1 - wordEase) * -25}deg)`;
            leftWord.style.opacity = rightWord.style.opacity = String(0.15 + wordEase * 0.75);
        }

        let sceneIdx;

        if (p < 0.22) {
            sceneIdx = 0;
        } else if (p < 0.47) {
            sceneIdx = 1;
        } else if (p < 0.72) {
            sceneIdx = 2;
        } else {
            sceneIdx = 3;
        }
        if (sceneIdx !== currentScene) {
            currentScene = sceneIdx;
            eyebrow.textContent = scenes[sceneIdx][0];
            title.textContent = scenes[sceneIdx][1];
            copy.textContent = scenes[sceneIdx][2];
            bars.forEach((bar, index) => bar.classList.toggle('active', index === sceneIdx));
        }

        scrollFrame = 0;
    }

    function requestRender() {
        if (!scrollFrame) scrollFrame = requestAnimationFrame(render);
    }

    window.addEventListener('scroll', requestRender, { passive: true });
    window.addEventListener('resize', requestRender, { passive: true });
    render();
})();
</script>

