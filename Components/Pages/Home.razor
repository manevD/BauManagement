                            <span>
                                <i class="bi bi-check-circle-fill"></i>
                                Mitarbeiter
                            </span>

                            <span>
                                <i class="bi bi-check-circle-fill"></i>
                                Aufgaben
                            </span>

                            <span>
                                <i class="bi bi-check-circle-fill"></i>
                                Zeiterfassung
                            </span>

                        </div>

                    </Authorized>


                    <NotAuthorized>

                        <div class="d-flex flex-wrap gap-3 mt-4">

                            <a class="btn btn-warning btn-lg px-4 fw-semibold"
