@page "/"
@layout LandingLayout

@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>BauManagement – Digitale Baustellenorganisation für Bau & Handwerk</PageTitle>


<!-- =========================================================
     HERO
========================================================= -->

<section class="landing-hero text-white">

    <nav class="container d-flex align-items-center justify-content-between py-4">

        <a class="brand text-white text-decoration-none" href="/">
            Bau<span>Management</span>
        </a>

        <AuthorizeView>

            <Authorized>

                <a class="btn btn-warning fw-semibold px-4"
                   href="/tasks">
                    Zum Dashboard
                </a>

            </Authorized>

            <NotAuthorized>

                <div class="d-flex gap-2">

                    <a class="btn btn-outline-light px-4"
                       href="Account/Login">
                        Anmelden
                    </a>

                    <a class="btn btn-warning fw-semibold px-4"
                       href="Account/Register">
                        Kostenlos starten
                    </a>

                </div>

            </NotAuthorized>

        </AuthorizeView>

