    // =========================================================
    // MONTH
    // =========================================================

    private async Task PreviousMonth()
    {
        CurrentMonth =
            CurrentMonth.AddMonths(-1);

        await Load();
    }


    private async Task NextMonth()
    {
        CurrentMonth =
            CurrentMonth.AddMonths(1);

        await Load();
    }


    // =========================================================
    // CHANGE MONTH
    // =========================================================

    private async Task ChangeMonth(
        ChangeEventArgs e)
    {
        if (!int.TryParse(
                e.Value?.ToString(),
                out var month))
        {
            return;
        }


        CurrentMonth =
            new DateTime(
                CurrentMonth.Year,
                month,
                1);


        await Load();
    }


    // =========================================================
    // CHANGE YEAR
    // =========================================================

    private async Task ChangeYear(
        ChangeEventArgs e)
    {
        if (!int.TryParse(
                e.Value?.ToString(),
                out var year))
        {
            return;
        }


        CurrentMonth =
            new DateTime(
                year,
                CurrentMonth.Month,
                1);


        await Load();
    }


    // =========================================================
    // TODAY
    // =========================================================

    private async Task GoToday()
    {
        CurrentMonth =
            new DateTime(
                DateTime.Today.Year,
                DateTime.Today.Month,
                1);

        await Load();
    }


    // =========================================================
    // WEEKEND
    // =========================================================

    private static bool IsWeekend(
        DateTime day)
    {
        return day.DayOfWeek ==
                   DayOfWeek.Saturday ||
               day.DayOfWeek ==
                   DayOfWeek.Sunday;
    }


    // =========================================================
    // CLOSE
    // =========================================================

    private void CloseVacation()
    {
        editingVacation = false;

        formError = null;
    }


    // =========================================================
    // INITIALS
    // =========================================================

    private static string EmployeeInitials(
        Employee employee)
    {
        var first =
            employee.FirstName?
                .FirstOrDefault() ?? 'M';

        var last =
            employee.LastName?
                .FirstOrDefault() ?? 'A';

        return
            $"{first}{last}"
                .ToUpperInvariant();
    }

