@page "/mitarbeiter-urlaub"

@attribute [Authorize(Roles = "Admin,Chef")]

@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using BauManagement.Data
@using BauManagement.Models
@using System.Globalization

@inject ApplicationDbContext Db
@inject ICurrentCompanyContext CurrentCompany

<PageTitle>Mitarbeiter Urlaub</PageTitle>


<div class="vacation-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="vacation-header">

        <div>
            <h3>Mitarbeiter Urlaub</h3>

            <p class="text-muted mb-0">
                Urlaubsplanung und Abwesenheiten aller Mitarbeiter
            </p>

        </div>


        <div class="d-flex align-items-center gap-2">

            @if (PendingVacationsCount > 0)
            {
                <button class="pending-vacation-button"
                        type="button"
                        @onclick="OpenPendingVacations">

                    <span class="pending-vacation-icon">
                        !
                    </span>

                    <span>
                        <strong>
                            Nicht genehmigte Urlaubsanträge
                        </strong>

                        <small>
                            @PendingVacationsCount Antrag@(PendingVacationsCount == 1 ? "" : "e")
                        </small>
                    </span>

                    <span class="pending-vacation-count">
                        @PendingVacationsCount
                    </span>

                </button>
            }


            <button class="btn btn-primary"
                    @onclick="NewVacation">

                + Urlaub hinzufügen

            </button>

        </div>

    </div>


    <!-- =========================================================
         MESSAGE
         ========================================================= -->

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-@messageType">
            @message
        </div>
    }


    <!-- =========================================================
         CALENDAR NAVIGATION
         ========================================================= -->

    <div class="card modern-card mb-4">

        <div class="card-body">

            <div class="vacation-toolbar">

                <!-- LEFT -->

                <div class="d-flex align-items-center gap-2">

                    <button class="btn btn-light"
                            type="button"
                            title="Vorheriger Monat"
                            @onclick="PreviousMonth">

                        ‹

                    </button>


                    <button class="btn btn-light"
                            type="button"
                            title="Nächster Monat"
                            @onclick="NextMonth">

                        ›

                    </button>


                    <button class="btn btn-outline-primary"
                            type="button"
                            @onclick="GoToday">

                        Heute

                    </button>

                </div>


                <!-- MONTH / YEAR -->

                <div class="vacation-date-selector">

                    <select class="form-select"
                            value="@CurrentMonth.Month"
                            @onchange="ChangeMonth">

                        @for (var month = 1; month <= 12; month++)
                        {
                            <option value="@month">
                                @CultureInfo.GetCultureInfo("de-DE").DateTimeFormat.GetMonthName(month)
                            </option>
                        }

                    </select>


                    <select class="form-select"
                            value="@CurrentMonth.Year"
                            @onchange="ChangeYear">

                        @foreach (var year in YearOptions)
                        {
                            <option value="@year">
                                @year
                            </option>
                        }

                    </select>

                </div>


                <!-- TITLE -->

                <div class="vacation-month-title">

                    @CurrentMonth.ToString(
                        "MMMM yyyy",
                        CultureInfo.GetCultureInfo("de-DE"))

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         LEGEND
         ========================================================= -->

    <div class="vacation-legend mb-3">

        <div class="legend-item">

            <span class="legend-color legend-pending"></span>

            <span>
                Nicht genehmigt
            </span>

        </div>


        <div class="legend-item">

            <span class="legend-color legend-approved"></span>

            <span>
                Genehmigt
            </span>

        </div>


        <div class="legend-item">

            <span class="legend-color legend-rejected"></span>

            <span>
                Abgelehnt
            </span>

        </div>

    </div>


    <!-- =========================================================
         CALENDAR
         ========================================================= -->

    <div class="card modern-card overflow-hidden">

        <div class="vacation-calendar-wrapper">

            <div class="vacation-calendar">

                <!-- =================================================
                     HEADER
                     ================================================= -->

                <div class="vacation-grid vacation-grid-header">

                    <div class="vacation-employee-header">
                        Mitarbeiter
                    </div>


                    <div class="vacation-days-header">

                        @foreach (var day in Days)
                        {
                            <div class="vacation-day-header
                                        @(IsWeekend(day) ? "weekend" : "")
                                        @(day.Date == DateTime.Today ? "today" : "")">

                                <div class="day-number">
                                    @day.Day
                                </div>

                                <div class="day-name">
                                    @day.ToString(
                                        "ddd",
                                        CultureInfo.GetCultureInfo("de-DE"))
                                </div>

                            </div>
                        }

                    </div>

                </div>


                <!-- =================================================
                     EMPLOYEES
                     ================================================= -->

                @foreach (var employee in employees)
                {
                    <div class="vacation-grid employee-vacation-row"
                         @key="employee.Id">

                        <!-- EMPLOYEE -->

                        <div class="vacation-employee-cell">

                            <div class="vacation-avatar">
                                @EmployeeInitials(employee)
                            </div>

                            <div>

                                <strong>
                                    @employee.FirstName @employee.LastName
                                </strong>

                                @if (!string.IsNullOrWhiteSpace(employee.Position))
                                {
                                    <small class="d-block text-muted">
                                        @employee.Position
                                    </small>
                                }

                            </div>

                        </div>


                        <!-- DAYS -->

                        <div class="vacation-days">

                            @foreach (var day in Days)
                            {
                                var vacation =
                                    GetVacationForDay(
                                        employee.Id,
                                        day);

                                <div class="vacation-day
                                            @(IsWeekend(day) ? "weekend" : "")
                                            @(day.Date == DateTime.Today ? "today" : "")">

                                    @if (vacation is not null)
                                    {
                                        var isStart =
                                            vacation.StartDate.Date == day.Date;

                                        var isEnd =
                                            vacation.EndDate.Date == day.Date;


                                        <button type="button"
                                                class="@GetVacationCssClass(vacation)
                                                       @(isStart ? "vacation-start" : "")
                                                       @(isEnd ? "vacation-end" : "")"
                                                title="@VacationTooltip(vacation)"
                                                @onclick="() => EditVacation(vacation)">

                                            @if (isStart)
                                            {
                                                <span>
                                                    Urlaub
                                                </span>
                                            }

                                        </button>
                                    }

                                </div>
                            }

                        </div>

                    </div>
                }


                <!-- =================================================
                     NO EMPLOYEES
                     ================================================= -->

                @if (employees.Count == 0)
                {
                    <div class="text-center text-muted py-5">

                        Keine aktiven Mitarbeiter vorhanden.

                    </div>
                }

            </div>

        </div>

    </div>

</div>


<!-- =============================================================
     PENDING VACATIONS MODAL
     ============================================================= -->

@if (showPendingVacations)
{
    <div class="vacation-modal-backdrop"
         @onclick="ClosePendingVacations">

        <div class="vacation-modal pending-modal"
             @onclick:stopPropagation="true">

            <div class="vacation-modal-header">

                <div>

                    <span class="eyebrow text-warning">
                        GENEHMIGUNG
                    </span>

                    <h2 class="h4 mb-1">
                        Nicht genehmigte Urlaubsanträge
                    </h2>

                    <p class="text-muted small mb-0">
                        Diese Urlaubsanträge warten auf die Genehmigung.
                    </p>

                </div>

                <button class="btn-close"
                        type="button"
                        @onclick="ClosePendingVacations">
                </button>

            </div>


            <div class="vacation-modal-body">

                @if (pendingVacations.Count == 0)
                {
                    <div class="text-center py-4 text-muted">

                        Keine offenen Urlaubsanträge.

                    </div>
                }
                else
                {
                    <div class="pending-list">

                        @foreach (var vacation in pendingVacations)
                        {
                            <div class="pending-item">

                                <div class="pending-item-main">

                                    <div class="vacation-avatar">
                                        @if (vacation.Employee is not null)
                                        {
                                            @EmployeeInitials(vacation.Employee)
                                        }
                                        else
                                        {
                                            <text>MA</text>
                                        }
                                    </div>


                                    <div>

                                        <strong>
                                            @vacation.Employee?.FirstName
                                            @vacation.Employee?.LastName
                                        </strong>

                                        <div class="pending-date">

                                            @vacation.StartDate.ToString("dd.MM.yyyy")
                                            –
                                            @vacation.EndDate.ToString("dd.MM.yyyy")

                                        </div>


                                        @if (!string.IsNullOrWhiteSpace(vacation.Notes))
                                        {
                                            <small class="text-muted">
                                                @vacation.Notes
                                            </small>
                                        }

                                    </div>

                                </div>


                                <div class="pending-item-actions">

                                    <button class="btn btn-success btn-sm"
                                            type="button"
                                            @onclick="() => ApproveVacation(vacation.Id)">

                                        ✓ Genehmigen

                                    </button>


                                    <button class="btn btn-outline-danger btn-sm"
                                            type="button"
                                            @onclick="() => RejectVacation(vacation.Id)">

                                        ✕ Ablehnen

                                    </button>


                                    <button class="btn btn-light btn-sm"
                                            type="button"
                                            @onclick="() => EditPendingVacation(vacation)">

                                        Bearbeiten

                                    </button>

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>


            <div class="vacation-modal-footer">

                <button type="button"
                        class="btn btn-light"
                        @onclick="ClosePendingVacations">

                    Schließen

                </button>

            </div>

        </div>

    </div>
}


<!-- =============================================================
     VACATION MODAL
     ============================================================= -->

@if (editingVacation)
{
    <div class="vacation-modal-backdrop"
         @onclick="CloseVacation">

        <div class="vacation-modal"
             @onclick:stopPropagation="true">

            <div class="vacation-modal-header">

                <div>

                    <span class="eyebrow text-primary">
                        URLAUB
                    </span>

                    <h2 class="h4 mb-1">

                        @(vacationForm.Id == Guid.Empty
                            ? "Urlaub hinzufügen"
                            : "Urlaub bearbeiten")

                    </h2>

                    <p class="text-muted small mb-0">
                        Urlaubszeitraum für einen Mitarbeiter verwalten.
                    </p>

                </div>


                <button class="btn-close"
                        type="button"
                        @onclick="CloseVacation">
                </button>

            </div>


            <EditForm Model="vacationForm"
                      OnValidSubmit="SaveVacation">

                <DataAnnotationsValidator />


                <div class="vacation-modal-body">

                    <!-- STATUS -->

                    @if (vacationForm.Id != Guid.Empty)
                    {
                        <div class="vacation-status-box mb-4">

                            <div>

                                <small class="text-muted d-block">
                                    Status
                                </small>

                                <strong>
                                    @GetStatusText(vacationForm.Status)
                                </strong>

                            </div>


                            <span class="@GetStatusBadgeClass(vacationForm.Status)">
                                @GetStatusText(vacationForm.Status)
                            </span>

                        </div>
                    }


                    <!-- MITARBEITER -->

                    <div class="mb-3">

                        <label class="form-label">
                            Mitarbeiter *
                        </label>

                        <InputSelect class="form-select"
                                     @bind-Value="vacationForm.EmployeeId">

                            <option value="@Guid.Empty">
                                Mitarbeiter auswählen
                            </option>

                            @foreach (var employee in employees)
                            {
                                <option value="@employee.Id">

                                    @employee.FirstName @employee.LastName

                                    @if (!string.IsNullOrWhiteSpace(employee.Position))
                                    {
                                        <text> – @employee.Position</text>
                                    }

                                </option>
                            }

                        </InputSelect>

                    </div>


                    <!-- DATUM -->

                    <div class="row g-3">

    <!-- VON -->

    <div class="col-md-6">

        <label class="form-label">
            Von *
        </label>

        <InputDate class="form-control"
                   @bind-Value="vacationForm.StartDate"
                   min="@MinVacationDate" />

    </div>


    <!-- BIS -->

    <div class="col-md-6">

        <label class="form-label">
            Bis *
        </label>

        <InputDate class="form-control"
                   @bind-Value="vacationForm.EndDate"
                   min="@MinVacationEndDate" />

    </div>

</div>


                    <!-- NOTIZ -->

                    <div class="mt-3">

                        <label class="form-label">
                            Notiz
                        </label>

                        <InputTextArea class="form-control"
                                       rows="4"
                                       @bind-Value="vacationForm.Notes"
                                       placeholder="z. B. Sommerurlaub, Familienurlaub..." />

                    </div>


                    @if (!string.IsNullOrWhiteSpace(formError))
                    {
                        <div class="alert alert-warning mt-3 mb-0">
                            @formError
                        </div>
                    }

                </div>


                <!-- FOOTER -->

                <div class="vacation-modal-footer">

                    @if (vacationForm.Id != Guid.Empty)
                    {
                        <button type="button"
                                class="btn btn-outline-danger me-auto"
                                @onclick="DeleteVacation">

                            Löschen

                        </button>


                        @if (vacationForm.Status == VacationStatus.Pending)
                        {
                            <button type="button"
                                    class="btn btn-danger"
                                    @onclick="RejectCurrentVacation">

                                ✕ Ablehnen

                            </button>


                            <button type="button"
                                    class="btn btn-success"
                                    @onclick="ApproveCurrentVacation">

                                ✓ Genehmigen

                            </button>
                        }
                        else if (vacationForm.Status == VacationStatus.Approved)
                        {
                            <button type="button"
                                    class="btn btn-outline-warning"
                                    @onclick="SetPendingCurrentVacation">

                                Genehmigung zurücknehmen

                            </button>
                        }

                    }


                    <button type="button"
                            class="btn btn-light"
                            @onclick="CloseVacation">

                        Abbrechen

                    </button>


                    <button type="submit"
                            class="btn btn-primary">

                        @(vacationForm.Id == Guid.Empty
                            ? "Urlaub speichern"
                            : "Änderungen speichern")

                    </button>

                </div>

            </EditForm>

        </div>

    </div>
}


@code {

    // =========================================================
    // DATA
    // =========================================================

    private Guid companyId;

    private List<Employee> employees = [];

    private List<EmployeeVacation> vacations = [];

    private List<EmployeeVacation> pendingVacations = [];

    private EmployeeVacation vacationForm = new();

    private bool editingVacation;

    private bool showPendingVacations;
    private string MinVacationDate =>
    DateTime.UtcNow.Date
        .ToString("yyyy-MM-dd");

private string MinVacationEndDate =>
    vacationForm.StartDate.Date < DateTime.UtcNow.Date
        ? DateTime.UtcNow.Date.ToString("yyyy-MM-dd")
        : vacationForm.StartDate.Date.ToString("yyyy-MM-dd");

    private DateTime CurrentMonth =
        new DateTime(
            DateTime.Today.Year,
            DateTime.Today.Month,
            1);


    private string? message;

    private string messageType = "success";

    private string? formError;


    // =========================================================
    // YEAR OPTIONS
    // =========================================================

    private IEnumerable<int> YearOptions
    {
        get
        {
            var currentYear = DateTime.Today.Year;

            return Enumerable.Range(
                currentYear - 5,
                11);
        }
    }


    // =========================================================
    // PENDING COUNT
    // =========================================================

    private int PendingVacationsCount =>
        pendingVacations.Count;


    // =========================================================
    // DAYS
    // =========================================================

    private IEnumerable<DateTime> Days
    {
        get
        {
            var daysInMonth =
                DateTime.DaysInMonth(
                    CurrentMonth.Year,
                    CurrentMonth.Month);

            for (var day = 1; day <= daysInMonth; day++)
            {
                yield return new DateTime(
                    CurrentMonth.Year,
                    CurrentMonth.Month,
                    day);
            }
        }
    }


    // =========================================================
    // INITIALIZE
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        var company =
            await CurrentCompany.GetCompanyIdAsync();

        if (!company.HasValue)
        {
            message = "Keine Firma gefunden.";
            messageType = "danger";
            return;
        }

        companyId = company.Value;

        await Load();
    }


    // =========================================================
    // LOAD
    // =========================================================

    private async Task Load()
    {
        message = null;
        formError = null;


        // EMPLOYEES

        employees =
            await Db.Employees
                .AsNoTracking()
                .Where(x =>
                    x.CompanyId == companyId &&
                    x.IsActive)
                .OrderBy(x => x.FirstName)
                .ThenBy(x => x.LastName)
                .ToListAsync();


        // MONTH

        var monthStart =
            CurrentMonth.Date;

        var monthEnd =
            CurrentMonth.Date.AddMonths(1);


        vacations =
            await Db.EmployeeVacations
                .AsNoTracking()
                .Include(x => x.Employee)
                .Where(x =>
                    x.CompanyId == companyId &&
                    x.StartDate < monthEnd &&
                    x.EndDate >= monthStart)
                .OrderBy(x => x.StartDate)
                .ToListAsync();


        // ALL PENDING

        pendingVacations =
            await Db.EmployeeVacations
                .AsNoTracking()
                .Include(x => x.Employee)
                .Where(x =>
                    x.CompanyId == companyId &&
                    x.Status == VacationStatus.Pending)
                .OrderBy(x => x.StartDate)
                .ThenBy(x => x.Employee!.LastName)
                .ToListAsync();
    }


    // =========================================================
    // GET VACATION FOR DAY
    // =========================================================

    private EmployeeVacation? GetVacationForDay(
        Guid employeeId,
        DateTime day)
    {
        return vacations
            .Where(x =>
                x.EmployeeId == employeeId &&
                x.StartDate.Date <= day.Date &&
                x.EndDate.Date >= day.Date)
            .OrderByDescending(x =>
                x.Status == VacationStatus.Approved)
            .ThenBy(x => x.StartDate)
            .FirstOrDefault();
    }


    // =========================================================
    // CSS CLASS
    // =========================================================

    private static string GetVacationCssClass(
        EmployeeVacation vacation)
    {
        return vacation.Status switch
        {
            VacationStatus.Approved =>
                "vacation-block vacation-approved",

            VacationStatus.Rejected =>
                "vacation-block vacation-rejected",

            _ =>
                "vacation-block vacation-pending"
        };
    }


    // =========================================================
    // STATUS TEXT
    // =========================================================

    private static string GetStatusText(
        VacationStatus status)
    {
        return status switch
        {
            VacationStatus.Approved =>
                "Genehmigt",

            VacationStatus.Rejected =>
                "Abgelehnt",

            _ =>
                "Nicht genehmigt"
        };
    }


    // =========================================================
    // STATUS BADGE
    // =========================================================

    private static string GetStatusBadgeClass(
        VacationStatus status)
    {
        return status switch
        {
            VacationStatus.Approved =>
                "status-badge status-approved",

            VacationStatus.Rejected =>
                "status-badge status-rejected",

            _ =>
                "status-badge status-pending"
        };
    }


    // =========================================================
    // TOOLTIP
    // =========================================================

    private string VacationTooltip(
        EmployeeVacation vacation)
    {
        var employee =
            vacation.Employee is not null
                ? $"{vacation.Employee.FirstName} {vacation.Employee.LastName}"
                : "Mitarbeiter";


        var text =
            $"{employee}: " +
            $"{vacation.StartDate:dd.MM.yyyy} – " +
            $"{vacation.EndDate:dd.MM.yyyy}";


        text +=
            $" | {GetStatusText(vacation.Status)}";


        if (!string.IsNullOrWhiteSpace(vacation.Notes))
        {
            text +=
                $" | {vacation.Notes}";
        }


        return text;
    }


    // =========================================================
    // NEW VACATION
    // =========================================================

   private void NewVacation()
{
    formError = null;

    var tomorrow =
        DateTime.UtcNow.Date.AddDays(1);

    vacationForm =
        new EmployeeVacation
        {
            Id = Guid.Empty,

            CompanyId =
                companyId,

            EmployeeId =
                employees.Count == 1
                    ? employees[0].Id
                    : Guid.Empty,

            StartDate =
                tomorrow,

            EndDate =
                tomorrow,

            Status =
                VacationStatus.Pending,

            CreatedAt =
                DateTime.UtcNow
        };

    editingVacation = true;
}

    // =========================================================
    // EDIT VACATION
    // =========================================================

    private void EditVacation(
        EmployeeVacation vacation)
    {
        formError = null;

        vacationForm =
            new EmployeeVacation
            {
                Id =
                    vacation.Id,

                CompanyId =
                    vacation.CompanyId,

                EmployeeId =
                    vacation.EmployeeId,

                StartDate =
                    vacation.StartDate,

                EndDate =
                    vacation.EndDate,

                Notes =
                    vacation.Notes,

                Status =
                    vacation.Status,

                ApprovedAt =
                    vacation.ApprovedAt,

                CreatedAt =
                    vacation.CreatedAt
            };

        editingVacation = true;
    }


    // =========================================================
    // EDIT PENDING
    // =========================================================

    private void EditPendingVacation(
        EmployeeVacation vacation)
    {
        ClosePendingVacations();

        EditVacation(vacation);
    }


    // =========================================================
    // SAVE VACATION
    // =========================================================

    private async Task SaveVacation()
    {
        formError = null;


        var currentCompany =
            await CurrentCompany.GetCompanyIdAsync();

        if (!currentCompany.HasValue)
        {
            formError =
                "Keine Firma gefunden.";

            return;
        }

        companyId =
            currentCompany.Value;


        if (vacationForm.EmployeeId ==
            Guid.Empty)
        {
            formError =
                "Bitte einen Mitarbeiter auswählen.";

            return;
        }

// =====================================================
// DATE VALIDATION
// =====================================================

var today =
    DateTime.UtcNow.Date;


// VON darf nicht in der Vergangenheit liegen

if (vacationForm.StartDate.Date < today)
{
    formError =
        "Urlaub kann nur für zukünftige Tage beantragt werden.";

    return;
}


// BIS darf nicht vor VON liegen

if (vacationForm.EndDate.Date <
    vacationForm.StartDate.Date)
{
    formError =
        "Das Enddatum darf nicht vor dem Startdatum liegen.";

    return;
}


        var employeeExists =
            await Db.Employees
                .AnyAsync(x =>
                    x.Id ==
                        vacationForm.EmployeeId &&
                    x.CompanyId ==
                        companyId &&
                    x.IsActive);

        if (!employeeExists)
        {
            formError =
                "Der ausgewählte Mitarbeiter wurde nicht gefunden.";

            return;
        }


        // =====================================================
        // NEW
        // =====================================================

        if (vacationForm.Id ==
            Guid.Empty)
        {
            vacationForm.Id =
                Guid.NewGuid();

            vacationForm.CompanyId =
                companyId;

            vacationForm.StartDate =
                vacationForm.StartDate.Date;

            vacationForm.EndDate =
                vacationForm.EndDate.Date;

            vacationForm.Notes =
                string.IsNullOrWhiteSpace(
                    vacationForm.Notes)
                    ? null
                    : vacationForm.Notes.Trim();

            vacationForm.Status =
                VacationStatus.Pending;

            vacationForm.CreatedAt =
                DateTime.UtcNow;

            Db.EmployeeVacations.Add(
                vacationForm);
        }
        else
        {
            // =================================================
            // EXISTING
            // =================================================

            var existing =
                await Db.EmployeeVacations
                    .FirstOrDefaultAsync(x =>
                        x.Id ==
                            vacationForm.Id &&
                        x.CompanyId ==
                            companyId);

            if (existing is null)
            {
                formError =
                    "Urlaub wurde nicht gefunden.";

                return;
            }


            existing.EmployeeId =
                vacationForm.EmployeeId;

            existing.StartDate =
                vacationForm.StartDate.Date;

            existing.EndDate =
                vacationForm.EndDate.Date;

            existing.Notes =
                string.IsNullOrWhiteSpace(
                    vacationForm.Notes)
                    ? null
                    : vacationForm.Notes.Trim();
        }


        await Db.SaveChangesAsync();


        editingVacation = false;


        message =
            "Urlaub wurde erfolgreich gespeichert.";

        messageType =
            "success";


        await Load();
    }


    // =========================================================
    // APPROVE
    // =========================================================

    private async Task ApproveVacation(
        Guid vacationId)
    {
        var vacation =
            await Db.EmployeeVacations
                .FirstOrDefaultAsync(x =>
                    x.Id == vacationId &&
                    x.CompanyId == companyId);

        if (vacation is null)
        {
            return;
        }


        vacation.Status =
            VacationStatus.Approved;

        vacation.ApprovedAt =
            DateTime.UtcNow;


        await Db.SaveChangesAsync();


        editingVacation = false;


        message =
            "Urlaub wurde genehmigt.";

        messageType =
            "success";


        await Load();
    }


