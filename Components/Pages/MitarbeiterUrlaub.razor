    // =========================================================
    // DELETE
    // =========================================================

    private async Task DeleteVacation()
    {
        formError = null;


        if (vacationForm.Id ==
            Guid.Empty)
        {
            return;
        }


        var currentCompany =
            await CurrentCompany.GetCompanyIdAsync();

        if (!currentCompany.HasValue)
        {
            formError =
                "Keine Firma gefunden.";

            return;
        }

        companyId =
            currentCompany.Value;


        var vacation =
            await Db.EmployeeVacations
                .FirstOrDefaultAsync(x =>
                    x.Id ==
                        vacationForm.Id &&
                    x.CompanyId ==
                        companyId);


        if (vacation is null)
        {
            formError =
                "Urlaub wurde nicht gefunden.";

            return;
        }


        Db.EmployeeVacations.Remove(
            vacation);

        await Db.SaveChangesAsync();


        editingVacation = false;


        message =
            "Urlaub wurde gelöscht.";

        messageType =
            "success";


        await Load();
    }


