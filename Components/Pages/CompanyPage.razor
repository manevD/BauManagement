@page "/company"
@attribute [Authorize]
@rendermode InteractiveServer

@using BauManagement.Data
@using BauManagement.Models
@using BauManagement.Services
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext Db
@inject ICurrentCompanyContext CurrentCompany
@inject CompanyCancellationService CancellationService
@inject StripeService StripeService
@inject NavigationManager Navigation

<PageTitle>Mein Unternehmen</PageTitle>

@if (company is null)
{
    <div class="alert alert-warning">
        Für dieses Konto wurde keine Firma gefunden.
    </div>
}
else
{
    <div class="page-hero mb-4">

        <div>
            <h3>Mein Unternehmen</h3>

            <p class="text-muted mb-0">
                Stammdaten und Paket deiner Firma verwalten.
            </p>
        </div>

        <div class="company-monogram">
            @company.Name[..1].ToUpper()
        </div>

    </div>


    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-@messageType">
            @message
        </div>
    }


    <div class="row g-4">

        <!-- ===================================================== -->
        <!-- FIRMENDATEN -->
        <!-- ===================================================== -->

        <div class="col-xl-8">

            <div class="card modern-card">

                <div class="card-body p-4 p-lg-5">

                    <h2 class="h4 mb-4">
                        Firmendaten
                    </h2>

                    <EditForm Model="company"
                              OnValidSubmit="SaveCompany">

                        <div class="row g-3">

                            <div class="col-12">

                                <label class="form-label">
                                    Firmenname
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="company.Name" />

                            </div>


                            <div class="col-md-7">

                                <label class="form-label">
                                    Adresse
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="company.Address" />

                            </div>


                            <div class="col-md-2">

                                <label class="form-label">
                                    PLZ
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="company.PostalCode" />

                            </div>


                            <div class="col-md-3">

                                <label class="form-label">
                                    Ort
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="company.City" />

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Telefon
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="company.Phone" />

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    E-Mail
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="company.Email" />

                            </div>

                        </div>

                        <br />

                        <button class="btn btn-sm btn-primary me-1"
                                type="submit">

                            Änderungen speichern

                        </button>

                    </EditForm>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- SUBSCRIPTION -->
        <!-- ===================================================== -->

        <div class="col-xl-4">

            <div class="card modern-card">

                <div class="card-body p-4">

                    <span class="eyebrow text-primary">
                        AKTIVER PLAN
                    </span>


                    <h2 class="h3 mt-2">
                        @PlanTitle(company.SubscriptionPlan)
                    </h2>


                    <p class="text-muted mb-3">
                        @PlanLimit(company.SubscriptionPlan) Mitarbeiter
                    </p>


                    <!-- ================================================= -->
                    <!-- TRIAL -->
                    <!-- ================================================= -->

                    @if (company.SubscriptionStatus ==
                         SubscriptionStatus.Trial)
                    {
                        @if (company.TrialEndDate <= DateTime.UtcNow)
                        {
                            <!-- TRIAL ABGELAUFEN -->

                            <div class="subscription-status danger">

                                <div class="subscription-status-icon">
                                    <i class="bi bi-clock-history"></i>
                                </div>

                                <div>

                                    <strong>
                                        Testphase abgelaufen
                                    </strong>

                                    <div class="small text-muted mt-1">
                                        Deine kostenlose Testphase ist beendet.
                                        Um myBauManagement weiter zu nutzen,
                                        wähle bitte ein Paket.
                                    </div>

                                </div>

                            </div>


                            <div class="mt-3 p-3 rounded-3 border bg-light">

                                <div class="fw-semibold mb-1">
                                    Weiter mit myBauManagement
                                </div>

                                <div class="small text-muted mb-3">
                                    Wähle dein gewünschtes Paket.
                                    Die Zahlung erfolgt sicher über Stripe.
                                </div>


                                <div class="d-flex gap-2 flex-wrap">

                                    <button type="button"
                                            class="btn btn-primary btn-sm"
                                            @onclick="StartCheckout"
                                            disabled="@paymentRunning">

                                        @if (paymentRunning)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                            <span>Weiterleitung zu Stripe...</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-credit-card me-2"></i>
                                            <span>Jetzt bezahlen</span>
                                        }

                                    </button>

                                </div>

                            </div>
                        }
                        else
                        {
                            <!-- TRIAL NOCH AKTIV -->

                            <div class="subscription-status trial">

                                <div class="subscription-status-icon">
                                    <i class="bi bi-clock"></i>
                                </div>

                                <div>

                                    <strong class="eyebrow text-primary">
                                        Kostenloser Testzeitraum
                                    </strong>

                                    <div class="small text-muted">
                                        @TrialText
                                    </div>

                                    <div class="small text-muted mt-1">
                                        Ende:
                                        @company.TrialEndDate
                                            .ToLocalTime()
                                            .ToString("dd.MM.yyyy HH:mm")
                                    </div>

                                </div>

                            </div>
                        }
                    }


                    <!-- ================================================= -->
                    <!-- ACTIVE -->
                    <!-- ================================================= -->

                    @if (company.SubscriptionStatus ==
                         SubscriptionStatus.Active)
                    {
                        <div class="subscription-status active">

                            <div class="subscription-status-icon">
                                <i class="bi bi-check-lg"></i>
                            </div>

                            <div>

                                <strong>
                                    Abonnement aktiv
                                </strong>

                                @if (company.CurrentPeriodEnd.HasValue)
                                {
                                    <div class="small text-muted">
                                        Nächste Abrechnung:
                                        @company.CurrentPeriodEnd
                                            .Value
                                            .ToLocalTime()
                                            .ToString("dd.MM.yyyy")
                                    </div>
                                }

                            </div>

                        </div>


                        <div class="small text-muted mt-3">
                            Dein Abonnement wird monatlich automatisch
                            verlängert und abgerechnet, bis du es kündigst.
                        </div>
                    }


                    <!-- ================================================= -->
                    <!-- PAST DUE -->
                    <!-- ================================================= -->

                    @if (company.SubscriptionStatus ==
                         SubscriptionStatus.PastDue)
                    {
                        <div class="subscription-status danger">

                            <div class="subscription-status-icon">
                                <i class="bi bi-exclamation-triangle"></i>
                            </div>

                            <div>

                                <strong>
                                    Zahlung erforderlich
                                </strong>

                                <div class="small text-muted">
                                    Die letzte Zahlung konnte nicht
                                    verarbeitet werden.
                                    Bitte überprüfe deine Zahlungsdaten
                                    bei Stripe.
                                </div>

                            </div>

                        </div>
                    }


                    <!-- ================================================= -->
                    <!-- CANCELLED -->
                    <!-- ================================================= -->

                    @if (company.SubscriptionStatus ==
                         SubscriptionStatus.Cancelled)
                    {
                        <div class="subscription-status danger">

                            <div class="subscription-status-icon">
                                <i class="bi bi-x-lg"></i>
                            </div>

                            <div>

                                <strong>
                                    Abonnement gekündigt
                                </strong>

                                <div class="small text-muted">
                                    Dein Abonnement ist nicht mehr aktiv.
                                    Wähle ein Paket, um die Software
                                    wieder zu aktivieren.
                                </div>

                            </div>

                        </div>


                        <div class="mt-3">

                            <button type="button"
                                    class="btn btn-primary btn-sm"
                                    @onclick="StartCheckout"
                                    disabled="@paymentRunning">

                                @if (paymentRunning)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Weiterleitung zu Stripe...</span>
                                }
                                else
                                {
                                    <i class="bi bi-credit-card me-2"></i>
                                    <span>Abonnement neu starten</span>
                                }

                            </button>

                        </div>
                    }


                    <hr class="my-4" />


                    <!-- ================================================= -->
                    <!-- PLAN WECHSELN -->
                    <!-- ================================================= -->

                    <div id="paket-auswaehlen"></div>

                    <label class="form-label">
                        Paket auswählen
                    </label>


                    <InputSelect class="form-select"
                                 @bind-Value="selectedPlan">

                        @foreach (var plan in
                                 Enum.GetValues<SubscriptionPlan>())
                        {
                            <option value="@plan">

                                @PlanTitle(plan)
                                –
                                @PlanLimit(plan)
                                Mitarbeiter

                            </option>
                        }

                    </InputSelect>


                    <br />


                    <button class="btn btn-sm btn-primary me-1"
                            @onclick="ChangePlan"
                            disabled="@planChanging">

                        @if (planChanging)
                        {
                            <span>
                                Wird geändert...
                            </span>
                        }
                        else
                        {
                            <span>
                                Paket ändern
                            </span>
                        }

                    </button>


                    @if (company.SubscriptionStatus ==
                         SubscriptionStatus.Trial)
                    {
                        <div class="small text-muted mt-3">

                            Während der Testphase wird keine Zahlung
                            ausgelöst. Nach Ablauf der Testphase muss ein
                            aktives Paket abgeschlossen werden.

                        </div>
                    }
                    else if (company.SubscriptionStatus ==
                             SubscriptionStatus.Active)
                    {
                        <div class="small text-muted mt-3">

                            Bei einer Änderung wird die Preisänderung von
                            Stripe automatisch entsprechend der laufenden
                            Abrechnungsperiode berechnet.

                        </div>
                    }
                    else
                    {
                        <div class="small text-muted mt-3">

                            Wähle dein gewünschtes Paket und starte dein
                            Abonnement erneut über Stripe.

                        </div>
                    }

                </div>

            </div>


            <!-- ===================================================== -->
            <!-- KÜNDIGUNG -->
            <!-- ===================================================== -->

            @if (company.SubscriptionStatus ==
                 SubscriptionStatus.Active)
            {
                <div class="card danger-card mt-4">

                    <div class="card-body p-4">

                        <h2 class="h6 mb-3">
                            Kündigung
                        </h2>


                        <p class="small text-muted mb-3">

                            Wenn du dein Abonnement kündigst, wird die
                            nächste monatliche Zahlung nicht mehr ausgeführt.
                            Dein Zugang bleibt bis zum Ende der bereits
                            bezahlten Abrechnungsperiode bestehen.

                        </p>


                        @if (!confirmCancellation)
                        {
                            <button class="btn btn-outline-danger btn-sm"
                                    @onclick="StartCancellation">

                                Abonnement kündigen

                            </button>
                        }
                        else
                        {
                            <div class="cancellation-confirm">

                                <div class="cancellation-confirm-icon">
                                    <i class="bi bi-exclamation-triangle"></i>
                                </div>

                                <div>

                                    <strong>
                                        Abonnement wirklich kündigen?
                                    </strong>

                                    <p class="mb-0">

                                        Dein Abonnement wird zum Ende der
                                        aktuellen Abrechnungsperiode beendet.
                                        Bis dahin kannst du die Software
                                        weiterhin nutzen.

                                    </p>

                                </div>

                            </div>


                            <div class="d-flex gap-2 flex-wrap mt-3">

                                <button class="btn btn-danger btn-sm"
                                        @onclick="CancelCompany"
                                        disabled="@cancellationRunning">

                                    @if (cancellationRunning)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Wird gekündigt...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle me-2"></i>
                                        <span>Abonnement kündigen</span>
                                    }

                                </button>


                                <button class="btn btn-link btn-sm"
                                        @onclick="CancelCancellation"
                                        disabled="@cancellationRunning">

                                    Abbrechen

                                </button>

                            </div>
                        }

                    </div>

                </div>
            }

        </div>

    </div>
}


@code {

    private Models.Company? company;

    private Guid companyId;

    private bool confirmCancellation;

    private bool planChanging;

    private bool paymentRunning;

    private bool cancellationRunning;

    private string? message;

    private string messageType = "success";

    private SubscriptionPlan selectedPlan;


    // ============================================================
    // LOAD
    // ============================================================

    protected override async Task OnInitializedAsync()
    {
        var id =
            await CurrentCompany.GetCompanyIdAsync();

        if (!id.HasValue)
            return;

        companyId = id.Value;

        company =
            await Db.Companies
                .SingleOrDefaultAsync(
                    x => x.Id == companyId);

        if (company is not null)
        {
            selectedPlan =
                company.SubscriptionPlan;
        }
    }


    // ============================================================
    // SAVE COMPANY
    // ============================================================

    private async Task SaveCompany()
    {
        if (company is null)
            return;

        if (string.IsNullOrWhiteSpace(
                company.Name))
        {
            message =
                "Der Firmenname ist erforderlich.";

            messageType = "warning";

            return;
        }

        await Db.SaveChangesAsync();

        message =
            "Deine Änderungen wurden gespeichert.";

        messageType = "success";
    }


    // ============================================================
    // START STRIPE CHECKOUT
    // ============================================================

    private async Task StartCheckout()
    {
        if (company is null)
            return;


        // ========================================================
        // TRIAL EXPIRED
        // ========================================================

        var trialExpired =
            company.SubscriptionStatus ==
                SubscriptionStatus.Trial
            &&
            company.TrialEndDate <= DateTime.UtcNow;


        // ========================================================
        // CANCELLED
        // ========================================================

        var cancelled =
            company.SubscriptionStatus ==
                SubscriptionStatus.Cancelled;


        // ========================================================
        // ONLY THESE TWO STATES MAY START CHECKOUT
        // ========================================================

        if (!trialExpired && !cancelled)
        {
            message =
                "Für dieses Konto kann derzeit kein neues Abonnement gestartet werden.";

            messageType = "warning";

            return;
        }


        if (string.IsNullOrWhiteSpace(
                company.StripeCustomerId))
        {
            message =
                "Für dieses Konto wurde kein Stripe-Kunde gefunden. " +
                "Bitte kontaktiere den Support.";

            messageType = "danger";

            return;
        }


        paymentRunning = true;

        message = null;


        try
        {
            var session =
                await StripeService.CreateCheckoutSessionAsync(
                    company,
                    company.StripeCustomerId,
                    selectedPlan);


            var checkoutUrl =
                StripeService.GetCheckoutUrl(session);


            Navigation.NavigateTo(
                checkoutUrl,
                forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            message =
                "Die Zahlung konnte nicht gestartet werden. " +
                "Bitte versuche es erneut.";

            messageType = "danger";

            paymentRunning = false;
        }
    }


    // ============================================================
    // CHANGE PLAN
    // ============================================================

    private async Task ChangePlan()
    {
        if (company is null)
            return;


        if (selectedPlan ==
            company.SubscriptionPlan)
        {
            message =
                "Du verwendest bereits dieses Paket.";

            messageType = "warning";

            return;
        }


        // ========================================================
        // ONLY ACTIVE SUBSCRIPTIONS CAN CHANGE PLAN DIRECTLY
        // ========================================================

        if (company.SubscriptionStatus !=
            SubscriptionStatus.Active)
        {
            message =
                "Das Paket kann nur bei einem aktiven Abonnement direkt geändert werden.";

            messageType = "warning";

            return;
        }


        if (string.IsNullOrWhiteSpace(
                company.StripeSubscriptionId))
        {
            message =
                "Für dieses Konto wurde kein Stripe-Abonnement gefunden.";

            messageType = "danger";

            return;
        }


        planChanging = true;

        message = null;


        try
        {
            var oldPlan =
                company.SubscriptionPlan;


            await StripeService.ChangeSubscriptionPlanAsync(
                company,
                selectedPlan);


            company.SubscriptionPlan =
                selectedPlan;


            company.StripePriceId =
                StripeService.GetPriceId(
                    selectedPlan);


            await Db.SaveChangesAsync();


            message =
                $"Dein Paket wurde von " +
                $"{PlanTitle(oldPlan)} auf " +
                $"{PlanTitle(selectedPlan)} geändert.";

            messageType = "success";
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            message =
                "Das Paket konnte nicht geändert werden. " +
                "Bitte versuche es erneut.";

            messageType = "danger";
        }
        finally
        {
            planChanging = false;
        }
    }


    // ============================================================
    // START CANCELLATION
    // ============================================================

    private void StartCancellation()
    {
        confirmCancellation = true;
    }


    // ============================================================
    // CANCEL CANCELLATION
    // ============================================================

    private void CancelCancellation()
    {
        confirmCancellation = false;
    }


    // ============================================================
    // CANCEL COMPANY
    // ============================================================

    private async Task CancelCompany()
    {
        if (company is null)
            return;


        cancellationRunning = true;


        try
        {
            // ====================================================
            // STRIPE
            // CancelAtPeriodEnd = true
            // ====================================================

            await StripeService.CancelSubscriptionAsync(
                company);


            /*
             * IMPORTANT:
             *
             * Do NOT immediately deactivate/delete the company here.
             *
             * Stripe keeps the subscription active until
             * CurrentPeriodEnd.
             *
             * The webhook will handle the final cancellation.
             */


            confirmCancellation = false;

            message =
                "Dein Abonnement wurde gekündigt. " +
                "Du kannst die Software bis zum Ende der " +
                "bezahlten Abrechnungsperiode weiter nutzen.";

            messageType = "success";
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            message =
                "Die Kündigung konnte nicht durchgeführt werden.";

            messageType = "danger";
        }
        finally
        {
            cancellationRunning = false;
        }
    }


    // ============================================================
    // TRIAL TEXT
    // ============================================================

    private string TrialText
    {
        get
        {
            if (company is null)
                return "";

            var remaining =
                company.TrialEndDate -
                DateTime.UtcNow;


            if (remaining.TotalSeconds <= 0)
            {
                return "Der Testzeitraum ist abgelaufen.";
            }


            var days =
                remaining.Days;

            var hours =
                remaining.Hours;


            if (days > 0)
            {
                return
                    $"Noch {days} Tage und " +
                    $"{hours} Stunden kostenlos.";
            }


            if (hours > 0)
            {
                return
                    $"Noch {hours} Stunden kostenlos.";
            }


            return "Der Testzeitraum endet heute.";
        }
    }


    // ============================================================
    // PLAN TITLE
    // ============================================================

    private static string PlanTitle(
        SubscriptionPlan plan)
    {
        return plan switch
        {
            SubscriptionPlan.S =>
                "S – Starter",

            SubscriptionPlan.M =>
                "M – Team",

            SubscriptionPlan.L =>
                "L – Business",

            SubscriptionPlan.XL =>
                "XL – Profi",

            _ =>
                plan.ToString()
        };
    }


    // ============================================================
    // PLAN LIMIT
    // ============================================================

    private static string PlanLimit(
        SubscriptionPlan plan)
    {
        return plan switch
        {
            SubscriptionPlan.S =>
                "Bis 5",

            SubscriptionPlan.M =>
                "Bis 10",

            SubscriptionPlan.L =>
                "Bis 20",

            SubscriptionPlan.XL =>
                "Über 20",

            _ =>
                ""
        };
    }
}