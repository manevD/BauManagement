@page "/company"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ApplicationDbContext Db
@inject ICurrentCompanyContext CurrentCompany
@inject CompanyCancellationService CancellationService
@inject NavigationManager Navigation

<PageTitle>Mein Unternehmen</PageTitle>

@if (company is null)
{
    <div class="alert alert-warning">Für dieses Konto wurde keine Firma gefunden.</div>
}
else
{
    <div class="page-hero mb-4"><div><h3>Mein Unternehmen</h3><p class="text-muted mb-0">Stammdaten und Paket deiner Firma verwalten.</p></div><div class="company-monogram">@company.Name[..1].ToUpper()</div></div>
    @if (!string.IsNullOrEmpty(message)) { <div class="alert alert-@messageType">@message</div> }
    <div class="row g-4"><div class="col-xl-8"><div class="card modern-card"><div class="card-body p-4 p-lg-5"><h2 class="h4 mb-4">Firmendaten</h2><EditForm Model="company" OnValidSubmit="Save"><div class="row g-3"><div class="col-12"><label class="form-label">Firmenname</label><InputText class="form-control" @bind-Value="company.Name" /></div><div class="col-md-7"><label class="form-label">Adresse</label><InputText class="form-control" @bind-Value="company.Address" /></div><div class="col-md-2"><label class="form-label">PLZ</label><InputText class="form-control" @bind-Value="company.PostalCode" /></div><div class="col-md-3"><label class="form-label">Ort</label><InputText class="form-control" @bind-Value="company.City" /></div><div class="col-md-6"><label class="form-label">Telefon</label><InputText class="form-control" @bind-Value="company.Phone" /></div><div class="col-md-6"><label class="form-label">E-Mail</label><InputText class="form-control" @bind-Value="company.Email" /></div></div><button class="btn btn-primary mt-4 px-4" type="submit">Änderungen speichern</button></EditForm></div></div></div>
    <div class="col-xl-4"><div class="card modern-card"><div class="card-body p-4"><span class="eyebrow text-primary">AKTIVER PLAN</span><h2 class="h3 mt-2">@PlanTitle(company.SubscriptionPlan)</h2><p class="text-muted">@PlanLimit(company.SubscriptionPlan) Mitarbeiter</p><EditForm Model="company" OnValidSubmit="Save"><label class="form-label">Paket wechseln</label><InputSelect class="form-select" @bind-Value="company.SubscriptionPlan">@foreach (var plan in Enum.GetValues<SubscriptionPlan>()) { <option value="@plan">@PlanTitle(plan) – @PlanLimit(plan)</option> }</InputSelect><button class="btn btn-outline-primary w-100 mt-3" type="submit">Paket speichern</button></EditForm></div></div><div class="card danger-card mt-4"><div class="card-body p-4"><h2 class="h6">Kündigung</h2><p class="small text-muted">Die Kündigung löscht deine Firma und alle Baustellen, Mitarbeiter, Einsätze und Aufgaben endgültig.</p>@if (!confirmCancellation) { <button class="btn btn-outline-danger btn-sm" @onclick="() => confirmCancellation = true">Kündigung starten</button> } else { <p class="small fw-semibold text-danger">Diese Aktion kann nicht rückgängig gemacht werden.</p><button class="btn btn-danger btn-sm me-2" @onclick="CancelCompany">Endgültig löschen</button><button class="btn btn-link btn-sm" @onclick="() => confirmCancellation = false">Abbrechen</button> }</div></div></div></div>
}

@code {
    private Models.Company? company; private Guid companyId; private bool confirmCancellation; private string? message; private string messageType = "success";
    protected override async Task OnInitializedAsync() { var id = await CurrentCompany.GetCompanyIdAsync(); if (id.HasValue) { companyId = id.Value; company = await Db.Companies.SingleOrDefaultAsync(x => x.Id == companyId); } }
    private async Task Save() { if (company is null || string.IsNullOrWhiteSpace(company.Name)) { message = "Der Firmenname ist erforderlich."; messageType = "warning"; return; } await Db.SaveChangesAsync(); message = "Deine Änderungen wurden gespeichert."; messageType = "success"; }
    private async Task CancelCompany() { if (company is null) return; await CancellationService.CancelAsync(companyId); Navigation.NavigateTo("/Account/Logout", true); }
    private static string PlanTitle(SubscriptionPlan p) => p switch { SubscriptionPlan.S => "S – Starter", SubscriptionPlan.M => "M – Team", SubscriptionPlan.L => "L – Business", _ => "XL – Profi" };
    private static string PlanLimit(SubscriptionPlan p) => p switch { SubscriptionPlan.S => "Bis 5", SubscriptionPlan.M => "Bis 10", SubscriptionPlan.L => "Bis 20", _ => "Über 20" };
}
