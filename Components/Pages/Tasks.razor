    // =========================================================
    // NEW
    // =========================================================

    private void New()
    {
        if (!isAdmin)
        {
            return;
        }


        form = new WorkTaskModel
        {
            Id = Guid.Empty,
            CompanyId = companyId,
            BaustelleId = Guid.Empty,
            EmployeeId = null,
            Title = "",
            Description = null,
            Status = WorkTaskStatus.Open,
            DueDate = null,
            CreatedAt = DateTime.UtcNow
        };


        siteSearchText = "";
        showSiteDropdown = false;
        employeeSearchText = "";
        showEmployeeDropdown = false;

        editing = true;

        formError = null;

        message = null;
    }


    // =========================================================
    // EDIT
    // =========================================================

    private void Edit(WorkTaskModel task)
    {
        if (!isAdmin)
        {
            return;
        }


        form = new WorkTaskModel
        {
            Id = task.Id,
            CompanyId = task.CompanyId,
            BaustelleId = task.BaustelleId,
            EmployeeId = task.EmployeeId,
            Title = task.Title,
            Description = task.Description,
            Status = task.Status,
            DueDate = task.DueDate,
            CreatedAt = task.CreatedAt
        };


        var site = sites.FirstOrDefault(s => s.Id == task.BaustelleId);
        siteSearchText = site?.Name ?? "";
        showSiteDropdown = false;

        var emp = employees.FirstOrDefault(e => e.Id == task.EmployeeId);
        employeeSearchText = emp != null ? $"{emp.FirstName} {emp.LastName}" : "";
        showEmployeeDropdown = false;

        editing = true;

        formError = null;

        message = null;
    }


    // =========================================================
    // SAVE
    // =========================================================

    private async Task Save()
    {
        if (!isAdmin)
        {
            return;
        }


        formError = null;

        message = null;


        if (form.BaustelleId == Guid.Empty)
        {
            formError = "Bitte eine Baustelle auswählen.";

            return;
        }


        if (string.IsNullOrWhiteSpace(form.Title))
        {
            formError = "Der Titel ist erforderlich.";

            return;
        }


        form.CompanyId = companyId;


        var siteExists = await Db.Baustellen
            .AnyAsync(x => x.Id == form.BaustelleId && x.CompanyId == companyId && x.IsActive);


        if (!siteExists)
        {
            formError = "Die ausgewählte Baustelle wurde nicht gefunden.";

            return;
        }


        if (form.EmployeeId.HasValue)
        {
            var employeeExists = await Db.Employees
                .AnyAsync(x => x.Id == form.EmployeeId.Value && x.CompanyId == companyId && x.IsActive);


            if (!employeeExists)
            {
                formError = "Der ausgewählte Mitarbeiter wurde nicht gefunden.";

                return;
            }
        }


        form.Title = form.Title.Trim();

        form.Description = string.IsNullOrWhiteSpace(form.Description) ? null : form.Description.Trim();


        if (form.Id == Guid.Empty)
        {
            form.Id = Guid.NewGuid();

            form.CreatedAt = DateTime.UtcNow;


            Db.WorkTasks.Add(form);
        }
        else
        {
            var existing = await Db.WorkTasks
                .FirstOrDefaultAsync(x => x.Id == form.Id && x.CompanyId == companyId);


            if (existing is null)
            {
                formError = "Aufgabe wurde nicht gefunden.";

                return;
            }


            existing.BaustelleId = form.BaustelleId;

            existing.EmployeeId = form.EmployeeId;

            existing.Title = form.Title;

            existing.Description = form.Description;

            existing.Status = form.Status;

            existing.DueDate = form.DueDate;
        }


        await Db.SaveChangesAsync();


        editing = false;


        message = "Aufgabe wurde gespeichert.";

        messageType = "success";


        await LoadTasks();
    }


    // =========================================================
    // DELETE
    // =========================================================

    private async Task Delete(WorkTaskModel task)
    {
        if (!isAdmin)
        {
            return;
        }


        var existing = await Db.WorkTasks
            .FirstOrDefaultAsync(x => x.Id == task.Id && x.CompanyId == companyId);


        if (existing is null)
        {
            return;
        }


        Db.WorkTasks.Remove(existing);


        await Db.SaveChangesAsync();


        message = "Aufgabe wurde gelöscht.";

        messageType = "success";


        await LoadTasks();
    }


    // =========================================================
    // STATUS MODAL
    // =========================================================

    private void OpenStatus(WorkTaskModel task)
    {
        if (isAdmin)
        {
            return;
        }


        if (currentEmployee is null || task.EmployeeId != currentEmployee.Id)
        {
            return;
        }


        statusTask = task;

        selectedStatus = task.Status;

        changingStatus = true;
    }


    private void CloseStatus()
    {
        changingStatus = false;

        statusTask = null;
    }


    // =========================================================
    // SAVE STATUS
    // =========================================================

    private async Task SaveStatus()
    {
        if (isAdmin)
        {
            return;
        }


        if (statusTask is null || currentEmployee is null)
        {
            return;
        }


        var task = await Db.WorkTasks
            .FirstOrDefaultAsync(x =>
                x.Id == statusTask.Id &&
                x.CompanyId == companyId &&
                x.EmployeeId == currentEmployee.Id);


        if (task is null)
        {
            message = "Aufgabe wurde nicht gefunden.";

            messageType = "danger";


            CloseStatus();

            return;
        }


        task.Status = selectedStatus;


        await Db.SaveChangesAsync();


        changingStatus = false;

        statusTask = null;


        message = "Status wurde geändert.";

        messageType = "success";


        await LoadTasks();
    }


    // =========================================================
    // CANCEL
    // =========================================================

    private void Cancel()
    {
        editing = false;

        formError = null;

        showSiteDropdown = false;

        showEmployeeDropdown = false;
    }


    // =========================================================
    // MESSAGE
    // =========================================================

    private void ClearMessage()
    {
        message = null;
    }


    // =========================================================
    // PAGINATION
    // =========================================================

    private void GoToPage(int page)
    {
        if (page < 1 || page > TotalPages)
        {
            return;
        }


        CurrentPage = page;
    }


    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }


    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }


    // =========================================================
    // HELPERS
    // =========================================================

    private static string StatusText(WorkTaskStatus status)
    {
        return status switch
        {
            WorkTaskStatus.Open => "Offen",
            WorkTaskStatus.InProgress => "In Arbeit",
            WorkTaskStatus.Completed => "Erledigt",
            _ => "Storniert"
        };
    }


    private static string StatusBadgeClass(WorkTaskStatus status)
    {
        return status switch
        {
            WorkTaskStatus.Open => "task-status task-status-open",
            WorkTaskStatus.InProgress => "task-status task-status-progress",
            WorkTaskStatus.Completed => "task-status task-status-completed",
            _ => "task-status task-status-cancelled"
        };
    }


    private static string DueDateClass(DateTime date)
    {
        if (date.Date < DateTime.Today)
        {
            return "task-due task-due-overdue";
        }


        if (date.Date == DateTime.Today)
        {
            return "task-due task-due-today";
        }


        return "task-due";
    }


    private static string EmployeeInitials(EmployeeModel employee)
    {
        var first = employee.FirstName?.FirstOrDefault() ?? 'M';

        var last = employee.LastName?.FirstOrDefault() ?? 'A';


        return $"{first}{last}".ToUpperInvariant();
    }

