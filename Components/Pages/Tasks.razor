@page "/tasks"

@attribute [Authorize]

@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@using BauManagement.Data
@using BauManagement.Models

@using EmployeeModel = BauManagement.Models.Employee
@using BaustelleModel = BauManagement.Models.Baustelle
@using WorkTaskModel = BauManagement.Models.WorkTask
@using WorkTaskStatus = BauManagement.Models.TaskStatus

@inject ApplicationDbContext Db
@inject ICurrentCompanyContext CurrentCompany
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager


<PageTitle>Aufgaben</PageTitle>


<div class="tasks-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="employee-header mb-4">

        <div>

            <h3>Aufgaben</h3>

            <p class="text-muted mb-0">

                @if (isAdmin)
                {
                    <text>
                        Alle Aufgaben der Firma verwalten.
                    </text>
                }
                else
                {
                    <text>
                        Meine zugewiesenen Aufgaben.
                    </text>
                }

            </p>

        </div>


        @if (isAdmin)
        {
            <button class="btn btn-primary px-4"
                    type="button"
                    @onclick="New">

                + Aufgabe hinzufügen

            </button>
        }

    </div>


    <!-- =========================================================
         MESSAGE
         ========================================================= -->

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-@messageType alert-dismissible">

            @message

            <button type="button"
                    class="btn-close"
                    @onclick="ClearMessage">
            </button>

        </div>
    }


    <!-- =========================================================
         SEARCH (LIVE SEARCH ZA SITE - ADMIN I MITARBEITER)
         ========================================================= -->

    <div class="card modern-card mb-4">

        <div class="card-body p-3">

            <div class="input-group search-box">

                <span class="input-group-text">
                    ⌕
                </span>

                <input class="form-control"
                       value="@search"
                       @oninput="OnSearch"
                       placeholder="@(isAdmin ? "Aufgaben live suchen – Aufgabe, Mitarbeiter, Baustelle oder Beschreibung" : "Meine Aufgaben live suchen – Aufgabe, Baustelle oder Beschreibung")"
                       autocomplete="off" />

            </div>

        </div>

    </div>


<!-- =============================================================
     ADMIN CREATE / EDIT FORM
     ============================================================= -->

@if (editing && isAdmin)
{
    <div class="card modern-card mb-4 task-inline-form">
        <div class="card-body p-4 p-lg-5">

            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h2 class="h4 mb-1">
                        @(form.Id == Guid.Empty
                            ? "Neue Aufgabe anlegen"
                            : "Aufgabe bearbeiten")
                    </h2>
                    <p class="text-muted small mb-0">
                        Baustelle, Mitarbeiter und Aufgabendetails festlegen.
                    </p>
                </div>

                <button type="button"
                        class="btn-close"
                        @onclick="Cancel">
                </button>
            </div>

            <EditForm Model="form" OnValidSubmit="Save">
                <DataAnnotationsValidator />

                <div class="row g-4">

                    <div class="col-md-6">
                        <label class="form-label">Baustelle *</label>

                        <div class="live-search-wrapper">
                            <input class="form-control"
                                   value="@siteSearchText"
                                   @oninput="OnSiteSearchInput"
                                   @focus="() => showSiteDropdown = true"
                                   placeholder="Baustelle suchen..."
                                   autocomplete="off" />

                            @if (showSiteDropdown)
                            {
                                <div class="live-search-results">
                                    @if (FilteredSites.Any())
                                    {
                                        @foreach (var site in FilteredSites.Take(8))
                                        {
                                            <button type="button"
                                                    class="live-search-result"
                                                    @onclick="() => SelectSite(site)">
                                                <div class="live-search-avatar site-avatar">
                                                    @Initials(site)
                                                </div>
                                                <div class="live-search-content">
                                                    <div class="live-search-title">
                                                        @site.Name
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(site.City))
                                                    {
                                                        <div class="live-search-subtitle">
                                                            @site.City
                                                        </div>
                                                    }
                                                    else if (!string.IsNullOrWhiteSpace(site.Address))
                                                    {
                                                        <div class="live-search-subtitle">
                                                            @site.Address
                                                        </div>
                                                    }
                                                </div>
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <div class="live-search-empty">
                                            Keine Baustelle gefunden.
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        @if (form.BaustelleId != Guid.Empty)
                        {
                            <div class="selected-info">
                                <span class="selected-check">✓</span>
                                <span>@SelectedSiteName</span>
                                <button type="button"
                                        class="selected-remove"
                                        @onclick="ClearSite"
                                        title="Auswahl entfernen">
                                    ×
                                </button>
                            </div>
                        }
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Mitarbeiter</label>

                        <div class="live-search-wrapper">
                            <input class="form-control"
                                   value="@employeeSearchText"
                                   @oninput="OnEmployeeSearchInput"
                                   @focus="() => showEmployeeDropdown = true"
                                   placeholder="Mitarbeiter suchen..."
                                   autocomplete="off" />

                            @if (showEmployeeDropdown)
                            {
                                <div class="live-search-results">
                                    <button type="button"
                                            class="live-search-result"
                                            @onclick="SelectNoEmployee">
                                        <div class="live-search-avatar">
                                            –
                                        </div>
                                        <div class="live-search-content">
                                            <div class="live-search-title">
                                                Nicht zugewiesen
                                            </div>
                                            <div class="live-search-subtitle">
                                                Keine Zuordnung
                                            </div>
                                        </div>
                                    </button>

                                    @if (FilteredEmployees.Any())
                                    {
                                        @foreach (var employee in FilteredEmployees.Take(8))
                                        {
                                            <button type="button"
                                                    class="live-search-result"
                                                    @onclick="() => SelectEmployee(employee)">
                                                <div class="live-search-avatar">
                                                    @Initials(employee)
                                                </div>
                                                <div class="live-search-content">
                                                    <div class="live-search-title">
                                                        @employee.FirstName @employee.LastName
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(employee.Position))
                                                    {
                                                        <div class="live-search-subtitle">
                                                            @employee.Position
                                                        </div>
                                                    }
                                                    else if (!string.IsNullOrWhiteSpace(employee.Phone))
                                                    {
                                                        <div class="live-search-subtitle">
                                                            @employee.Phone
                                                        </div>
                                                    }
                                                </div>
                                            </button>
                                        }
                                    }
                                    else if (!string.IsNullOrWhiteSpace(employeeSearchText))
                                    {
                                        <div class="live-search-empty">
                                            Kein Mitarbeiter gefunden.
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        @if (form.EmployeeId.HasValue)
                        {
                            <div class="selected-info">
                                <span class="selected-check">✓</span>
                                <span>@SelectedEmployeeName</span>
                                <button type="button"
                                        class="selected-remove"
                                        @onclick="ClearEmployee"
                                        title="Auswahl entfernen">
                                    ×
                                </button>
                            </div>
                        }
                    </div>

                    <div class="col-md-8">
                        <label class="form-label">Titel *</label>
                        <InputText class="form-control"
                                   @bind-Value="form.Title"
                                   placeholder="Aufgabe eingeben..." />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Fällig am</label>
                        <InputDate class="form-control"
                                   @bind-Value="form.DueDate" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Status</label>
                        <InputSelect class="form-select"
                                     @bind-Value="form.Status">
                            @foreach (var statusValue in Enum.GetValues<WorkTaskStatus>())
                            {
                                <option value="@statusValue">
                                    @StatusText(statusValue)
                                </option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Beschreibung</label>
                        <InputTextArea class="form-control"
                                       rows="4"
                                       @bind-Value="form.Description"
                                       placeholder="Beschreibung der Aufgabe..." />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(formError))
                    {
                        <div class="col-12">
                            <div class="alert alert-warning mb-0">
                                @formError
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary px-4">
                        @(form.Id == Guid.Empty
                            ? "Aufgabe speichern"
                            : "Änderungen speichern")
                    </button>

                    <button type="button"
                            class="btn btn-light"
                            @onclick="Cancel">
                        Abbrechen
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}




    @if (isAdmin)
    {
        <!-- =========================================================
             ADMIN / CHEF TABLE
             ========================================================= -->

        <div class="card modern-card overflow-hidden tasks-desktop">

            <div class="table-responsive">

                <table class="table table-modern align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Aufgabe</th>
                            <th>Baustelle</th>
                            <th>Mitarbeiter</th>
                            <th>Fällig</th>
                            <th>Status</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (PagedTasks.Any())
                        {
                            @foreach (var task in PagedTasks)
                            {
                                <tr @key="task.Id">

                                    <td>
                                        <div class="task-title-cell">
                                            <div class="fw-semibold">
                                                @task.Title
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(task.Description))
                                            {
                                                <small class="text-muted task-description">
                                                    @task.Description
                                                </small>
                                            }
                                        </div>
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @(task.Baustelle?.Name ?? "–")
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(task.Baustelle?.City))
                                        {
                                            <small class="text-muted">
                                                @task.Baustelle.City
                                            </small>
                                        }
                                    </td>

                                    <td>
                                        @if (task.Employee is not null)
                                        {
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="employee-avatar">
                                                    @EmployeeInitials(task.Employee)
                                                </div>

                                                <div>
                                                    <div class="fw-semibold">
                                                        @task.Employee.FirstName @task.Employee.LastName
                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(task.Employee.Position))
                                                    {
                                                        <small class="text-muted">
                                                            @task.Employee.Position
                                                        </small>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Nicht zugewiesen
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (task.DueDate.HasValue)
                                        {
                                            <div class="@DueDateClass(task.DueDate.Value)">
                                                @task.DueDate.Value.ToString("dd.MM.yyyy")
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">–</span>
                                        }
                                    </td>

                                    <td>
                                        <span class="@StatusBadgeClass(task.Status)">
                                            @StatusText(task.Status)
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <button type="button"
                                                class="btn btn-sm btn-primary me-1"
                                                @onclick="() => Edit(task)">
                                            Bearbeiten
                                        </button>

                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                @onclick="() => Delete(task)">
                                            Löschen
                                        </button>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="empty-state">
                                        <div class="empty-state-icon">⌕</div>

                                        @if (string.IsNullOrWhiteSpace(search))
                                        {
                                            <h6>Noch keine Aufgaben</h6>
                                            <p class="text-muted mb-0">
                                                Lege die erste Aufgabe an.
                                            </p>
                                        }
                                        else
                                        {
                                            <h6>Keine Aufgabe gefunden</h6>
                                            <p class="text-muted mb-0">
                                                Versuche einen anderen Suchbegriff.
                                            </p>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <!-- ADMIN PAGINATION -->
            @if (FilteredTasks.Any())
            {
                <div class="pagination-container">

                    <div class="text-muted small">
                        @{
                            var totalResults = FilteredTasks.Count();
                            var from = ((CurrentPage - 1) * PageSize) + 1;
                            var to = Math.Min(CurrentPage * PageSize, totalResults);
                        }

                        @from–@to von @totalResults Aufgaben
                    </div>

                    @if (TotalPages > 1)
                    {
                        <div class="d-flex align-items-center gap-1">

                            <button type="button"
                                    class="btn btn-sm btn-light"
                                    disabled="@(CurrentPage <= 1)"
                                    @onclick="PreviousPage">
                                ‹
                            </button>

                            @for (var page = 1; page <= TotalPages; page++)
                            {
                                var pageNumber = page;

                                <button type="button"
                                        class="btn btn-sm @(CurrentPage == pageNumber ? "btn-primary" : "btn-light")"
                                        @onclick="() => GoToPage(pageNumber)">
                                    @pageNumber
                                </button>
                            }

                            <button type="button"
                                    class="btn btn-sm btn-light"
                                    disabled="@(CurrentPage >= TotalPages)"
                                    @onclick="NextPage">
                                ›
                            </button>

                        </div>
                    }

                </div>
            }
        </div>
    }
    else
    {
        <!-- =========================================================
             MITARBEITER - CARD VIEW
             ========================================================= -->

        <div class="employee-task-cards">

            @if (PagedTasks.Any())
            {
                @foreach (var task in PagedTasks)
                {
                    <div class="employee-task-card" @key="task.Id">

                        <div class="employee-task-card-header">

                            <div class="employee-task-main">
                                <div class="employee-task-label">
                                    AUFGABE
                                </div>

                                <h4>@task.Title</h4>

                                @if (!string.IsNullOrWhiteSpace(task.Description))
                                {
                                    <p>@task.Description</p>
                                }
                            </div>

                            <span class="@StatusBadgeClass(task.Status)">
                                @StatusText(task.Status)
                            </span>

                        </div>

                        <div class="employee-task-details">

                            <div class="employee-task-detail">
                                <div class="employee-task-icon">
                                    <i class="bi bi-building"></i>
                                </div>

                                <div>
                                    <span>Baustelle</span>
                                    <strong>
                                        @(task.Baustelle?.Name ?? "–")
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(task.Baustelle?.City))
                                    {
                                        <small>@task.Baustelle.City</small>
                                    }
                                </div>
                            </div>

                            <div class="employee-task-detail">
                                <div class="employee-task-icon">
                                    <i class="bi bi-calendar-event"></i>
                                </div>

                                <div>
                                    <span>Fällig am</span>

                                    @if (task.DueDate.HasValue)
                                    {
                                        <strong class="@DueDateClass(task.DueDate.Value)">
                                            @task.DueDate.Value.ToString("dd.MM.yyyy")
                                        </strong>
                                    }
                                    else
                                    {
                                        <strong>Kein Termin</strong>
                                    }
                                </div>
                            </div>

                        </div>

                        <div class="employee-task-footer">
                            <button type="button"
                                    class="btn btn-primary w-100"
                                    @onclick="() => OpenStatus(task)">
                                <i class="bi bi-arrow-repeat me-2"></i>
                                Status ändern
                            </button>
                        </div>

                    </div>
                }

                @if (TotalPages > 1)
                {
                    <div class="employee-task-pagination">

                        <button type="button"
                                class="btn btn-sm"
                                disabled="@(CurrentPage <= 1)"
                                @onclick="PreviousPage">
                            ‹ Zurück
                        </button>

                        <span class="small text-muted">
                            Seite @CurrentPage von @TotalPages
                        </span>

                        <button type="button"
                                class="btn btn-sm"
                                disabled="@(CurrentPage >= TotalPages)"
                                @onclick="NextPage">
                            Weiter ›
                        </button>

                    </div>
                }
            }
            else
            {
                <div class="employee-task-empty">
                    <div class="employee-task-empty-icon">
                        <i class="bi bi-check2-square"></i>
                    </div>

                    @if (string.IsNullOrWhiteSpace(search))
                    {
                        <h5>Keine Aufgaben</h5>
                        <p>
                            Du hast aktuell keine zugewiesenen Aufgaben.
                        </p>
                    }
                    else
                    {
                        <h5>Keine Aufgabe gefunden</h5>
                        <p>
                            Versuche einen anderen Suchbegriff.
                        </p>
                    }
                </div>
            }

        </div>
    }

</div>


<!-- =============================================================
     EMPLOYEE STATUS MODAL
     ============================================================= -->

@if (changingStatus && !isAdmin)
{
    <div class="task-modal-backdrop"
         @onclick="CloseStatus">

        <div class="task-modal task-status-modal"
             @onclick:stopPropagation="true">

            <div class="task-modal-header">

                <div>
                    <h2>
                        Status ändern
                    </h2>


                    @if (statusTask is not null)
                    {
                        <p class="text-muted mb-0">

                            @statusTask.Title

                        </p>
                    }

                </div>


                <button class="btn-close"
                        type="button"
                        @onclick="CloseStatus">
                </button>

            </div>


            <div class="task-modal-body">

                <label class="form-label">
                    Neuer Status
                </label>


                <select class="form-select"
                        @bind="selectedStatus">

                    @foreach (var status in Enum.GetValues<WorkTaskStatus>())
                    {
                        <option value="@status">

                            @StatusText(status)

                        </option>
                    }

                </select>

            </div>


            <div class="task-modal-footer">

                <button type="button"
                        class="btn btn-light"
                        @onclick="CloseStatus">

                    Abbrechen

                </button>


                <button type="button"
                        class="btn btn-primary"
                        @onclick="SaveStatus">

                    Status speichern

                </button>

            </div>

        </div>

    </div>
}


@code {

    // =========================================================
    // DATA
    // =========================================================

    private Guid companyId;

    private EmployeeModel? currentEmployee;

    private bool isAdmin;

    private List<WorkTaskModel> tasks = [];

    private List<EmployeeModel> employees = [];

    private List<BaustelleModel> sites = [];


    // =========================================================
    // FORM
    // =========================================================

    private WorkTaskModel form = new();

    private bool editing;

    private string? formError;


    // =========================================================
    // MODAL LIVE SEARCH STATE
    // =========================================================

    private string siteSearchText = "";

    private bool showSiteDropdown = false;

    private string employeeSearchText = "";

    private bool showEmployeeDropdown = false;


    private IEnumerable<BaustelleModel> FilteredSites =>
        sites.Where(x =>
            string.IsNullOrWhiteSpace(siteSearchText) ||
            $"{x.Name} {x.City}".Contains(siteSearchText.Trim(), StringComparison.OrdinalIgnoreCase));


    private IEnumerable<EmployeeModel> FilteredEmployees =>
        employees.Where(x =>
            string.IsNullOrWhiteSpace(employeeSearchText) ||
            $"{x.FirstName} {x.LastName}".Contains(employeeSearchText.Trim(), StringComparison.OrdinalIgnoreCase));


    // =========================================================
    // MESSAGE
    // =========================================================

    private string? message;

    private string messageType = "success";


    // =========================================================
    // SEARCH
    // =========================================================

    private string search = "";


    // =========================================================
    // PAGINATION
    // =========================================================

    private const int PageSize = 10;

    private int CurrentPage = 1;


    // =========================================================
    // STATUS
    // =========================================================

    private bool changingStatus;

    private WorkTaskModel? statusTask;

    private WorkTaskStatus selectedStatus;


    // =========================================================
    // FILTERED TASKS
    // =========================================================

    private IEnumerable<WorkTaskModel> FilteredTasks =>
        tasks.Where(x =>
            string.IsNullOrWhiteSpace(search)

            ||

            (
                $"{x.Title} " +
                $"{x.Description} " +
                $"{x.Baustelle?.Name} " +
                $"{x.Baustelle?.City} " +
                $"{x.Employee?.FirstName} " +
                $"{x.Employee?.LastName} " +
                $"{x.DueDate:dd.MM.yyyy} " +
                $"{StatusText(x.Status)}"
            )
            .Contains(
                search.Trim(),
                StringComparison.OrdinalIgnoreCase));


    // =========================================================
    // PAGED TASKS
    // =========================================================

    private IEnumerable<WorkTaskModel> PagedTasks =>
        FilteredTasks
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize);


    // =========================================================
    // TOTAL PAGES
    // =========================================================

    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(FilteredTasks.Count() / (double)PageSize));


    // =========================================================
    // INITIALIZE
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        var id = await CurrentCompany.GetCompanyIdAsync();


        if (!id.HasValue)
        {
            message = "Keine Firma gefunden.";

            messageType = "danger";

            return;
        }


        companyId = id.Value;


        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();


        var user = await UserManager.GetUserAsync(authState.User);


        if (user is null)
        {
            message = "Benutzer wurde nicht gefunden.";

            messageType = "danger";

            return;
        }


        // =====================================================
        // ADMIN / CHEF
        // =====================================================

        isAdmin = await UserManager.IsInRoleAsync(user, "Admin") || await UserManager.IsInRoleAsync(user, "Chef");


        // =====================================================
        // MITARBEITER
        // =====================================================

        if (!isAdmin)
        {
            currentEmployee = await Db.Employees
                .AsNoTracking()
                .FirstOrDefaultAsync(x =>
                    x.CompanyId == companyId &&
                    x.ApplicationUserId == user.Id &&
                    x.IsActive);


            if (currentEmployee is null)
            {
                message = "Für dein Benutzerkonto wurde kein Mitarbeiter gefunden.";

                messageType = "danger";

                return;
            }
        }


        // =====================================================
        // ADMIN DATA
        // =====================================================

        if (isAdmin)
        {
            await LoadEmployeesAndSites();
        }


        await LoadTasks();
    }


    // =========================================================
    // LOAD EMPLOYEES / SITES
    // =========================================================

    private async Task LoadEmployeesAndSites()
    {
        employees = await Db.Employees
            .AsNoTracking()
            .Where(x => x.CompanyId == companyId && x.IsActive)
            .OrderBy(x => x.LastName)
            .ThenBy(x => x.FirstName)
            .ToListAsync();


        sites = await Db.Baustellen
            .AsNoTracking()
            .Where(x => x.CompanyId == companyId && x.IsActive)
            .OrderBy(x => x.Name)
            .ToListAsync();
    }


    // =========================================================
    // LOAD TASKS
    // =========================================================

    private async Task LoadTasks()
    {
        IQueryable<WorkTaskModel> query = Db.WorkTasks
            .Include(x => x.Baustelle)
            .Include(x => x.Employee)
            .Where(x => x.CompanyId == companyId);


        // =====================================================
        // MITARBEITER:
        // NUR EIGENE AUFGABEN
        // =====================================================

        if (!isAdmin)
        {
            if (currentEmployee is null)
            {
                tasks = [];

                return;
            }


    query = query.Where(x =>
        x.EmployeeId == currentEmployee.Id &&
        x.Status != WorkTaskStatus.Completed);      
        }


        tasks = await query
            .AsNoTracking()
            .OrderBy(x => x.Status)
            .ThenBy(x => x.DueDate)
            .ThenBy(x => x.Title)
            .ToListAsync();


        if (CurrentPage > TotalPages)
        {
            CurrentPage = TotalPages;
        }


        if (CurrentPage < 1)
        {
            CurrentPage = 1;
        }
    }


