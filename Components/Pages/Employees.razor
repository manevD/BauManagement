@page "/mitarbeiter"

@attribute [Authorize]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using BauManagement.Data
@using BauManagement.Models

@inject ApplicationDbContext Db
@inject ICurrentCompanyContext CurrentCompany
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager

<PageTitle>Mitarbeiter</PageTitle>


<!-- =========================================================
     HEADER
     ========================================================= -->

<div class="employee-header mb-4">

    <div>

        <h3>
            Mitarbeiter
        </h3>

        <p class="text-muted mb-0">
            @employees.Count von @limit Mitarbeiterplätzen belegt
        </p>

    </div>


    <button class="btn btn-primary px-4"
            disabled="@(employees.Count >= limit)"
            @onclick="New">

        + Mitarbeiter hinzufügen

    </button>

</div>


<!-- =========================================================
     SEARCH
     ========================================================= -->

<div class="card modern-card mb-4">

    <div class="card-body p-3">

        <div class="input-group search-box">

            <span class="input-group-text">
                ⌕
            </span>

            <input class="form-control"
                   value="@search"
                   @oninput="OnSearch"
                   placeholder="Mitarbeiter live suchen – Name, E-Mail, Position oder Telefon"
                   autocomplete="off" />

        </div>

    </div>

</div>


<!-- =========================================================
     MESSAGE
     ========================================================= -->

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-@messageType">
        @message
    </div>
}


<!-- =========================================================
     FORM
     ========================================================= -->

@if (showForm)
{
    <div class="card modern-card mb-4">

        <div class="card-body p-4 p-lg-5">

            <div class="d-flex justify-content-between">

                <div>

                    <h2 class="h4">

                        @(form.Id == Guid.Empty
                            ? "Neuen Mitarbeiter anlegen"
                            : "Mitarbeiter bearbeiten")

                    </h2>

                    <p class="text-muted small mb-0">

                        Ein Benutzerkonto ermöglicht dem Mitarbeiter
                        den Login mit seiner E-Mail-Adresse.

                    </p>

                </div>


                <button class="btn-close"
                        type="button"
                        @onclick="CloseForm">
                </button>

            </div>


            <EditForm Model="form"
                      OnValidSubmit="Save">

                <DataAnnotationsValidator />


                <div class="row g-3 mt-2">


                    <!-- VORNAME -->

                    <div class="col-md-6">

                        <label class="form-label">
                            Vorname *
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="form.FirstName" />

                    </div>


                    <!-- NACHNAME -->

                    <div class="col-md-6">

                        <label class="form-label">
                            Nachname *
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="form.LastName" />

                    </div>


                    <!-- POSITION -->

                    <div class="col-md-4">

                        <label class="form-label">
                            Position
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="form.Position"
                                   placeholder="z. B. Monteur" />

                    </div>


                    <!-- TELEFON -->

                    <div class="col-md-4">

                        <label class="form-label">
                            Telefon
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="form.Phone" />

                    </div>


                    <!-- EMAIL -->

                    <div class="col-md-4">

                        <label class="form-label">
                            E-Mail / Benutzername *
                        </label>

                        <InputText class="form-control"
                                   type="email"
                                   @bind-Value="form.Email"
                                   placeholder="name@firma.de" />

                    </div>


                    <!-- PASSWORD -->

                    @if (form.Id == Guid.Empty)
                    {
                        <div class="col-md-6">

                            <label class="form-label">
                                Start-Passwort *
                            </label>

                            <InputText class="form-control"
                                       type="password"
                                       @bind-Value="initialPassword"
                                       placeholder="Mindestens 6 Zeichen" />

                            <div class="form-text">

                                Dieses Passwort wird für den ersten Login verwendet.

                            </div>

                        </div>
                    }


                    <!-- ACTIVE -->

                    <div class="col-12">

                        <div class="form-check">

                            <InputCheckbox class="form-check-input"
                                           @bind-Value="form.IsActive" />

                            <label class="form-check-label">

                                Mitarbeiter ist aktiv

                            </label>

                        </div>

                    </div>

                </div>


                <!-- BUTTONS -->

                <div class="mt-4">

                    <button class="btn btn-primary me-2"
                            type="submit">

                        Mitarbeiter speichern

                    </button>


                    <button class="btn btn-light"
                            type="button"
                            @onclick="CloseForm">

                        Abbrechen

                    </button>

                </div>

            </EditForm>

        </div>

    </div>
}


<!-- =========================================================
     EMPLOYEE TABLE
     ========================================================= -->

<div class="card modern-card overflow-hidden">

    <div class="table-responsive">

        <table class="table table-modern align-middle mb-0">

            <thead>

                <tr>

                    <th>
                        Mitarbeiter
                    </th>

                    <th>
                        Position
                    </th>

                    <th>
                        Kontakt
                    </th>

                    <th>
                        Zugang
                    </th>

                    <th>
                        Status
                    </th>

                    <th></th>

                </tr>

            </thead>


            <tbody>

                @foreach (var employee in PagedEmployees)
                {
                    <tr>

                        <!-- EMPLOYEE -->

                        <td>

                            <div class="d-flex align-items-center gap-3">

                                <span class="employee-avatar">

                                    @Initials(employee)

                                </span>


                                <div>

                                    <strong>

                                        @employee.FirstName
                                        @employee.LastName

                                    </strong>


                                    <small class="d-block text-muted">

                                        Seit

                                        @employee.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")

                                    </small>

                                </div>

                            </div>

                        </td>


                        <!-- POSITION -->

                        <td>

                            @employee.Position

                        </td>


                        <!-- CONTACT -->

                        <td>

                            @employee.Email


                            @if (!string.IsNullOrWhiteSpace(employee.Phone))
                            {
                                <br />

                                <small class="text-muted">

                                    @employee.Phone

                                </small>
                            }

                        </td>


                        <!-- LOGIN -->

                        <td>

                            @if (!string.IsNullOrWhiteSpace(
                                employee.ApplicationUserId))
                            {
                                <span class="badge text-bg-success-subtle text-success-emphasis">

                                    Login aktiv

                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">

                                    Kein Login

                                </span>
                            }

                        </td>


                        <!-- STATUS -->

                        <td>

                            <span class="status-dot @(employee.IsActive
                                ? "active"
                                : "inactive")">
                            </span>


                            @(employee.IsActive
                                ? "Aktiv"
                                : "Inaktiv")

                        </td>


                        <!-- ACTIONS -->

                        <td class="text-end">

                            <button class="btn btn-sm btn-primary me-1"
                                    @onclick="() => Edit(employee)">

                                Bearbeiten

                            </button>


                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => Delete(employee)">

                                Löschen

                            </button>

                        </td>

                    </tr>
                }


                <!-- NO RESULTS -->

                @if (!FilteredEmployees.Any())
                {
                    <tr>

                        <td colspan="6"
                            class="text-center text-muted py-5">

                            Kein Mitarbeiter gefunden.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>


    <!-- =====================================================
         PAGINATION
         ===================================================== -->

    @if (TotalPages > 1)
    {
        <div class="daily-pagination">

            <!-- RESULT INFO -->

            <div class="daily-pagination-info">

                @{
                    var totalResults = FilteredEmployees.Count();

                    var from =
                        ((CurrentPage - 1) * PageSize) + 1;

                    var to =
                        Math.Min(
                            CurrentPage * PageSize,
                            totalResults);
                }

                @if (totalResults > 0)
                {
                    <span>
                        @from–@to von @totalResults Mitarbeiter
                    </span>
                }

            </div>


            <!-- PAGE CONTROLS -->

            <div class="d-flex align-items-center gap-1">


                <!-- PREVIOUS -->

                <button type="button"
                        class="btn btn-sm btn-light"
                        disabled="@(CurrentPage <= 1)"
                        @onclick="PreviousPage">

                    ‹ Zurück

                </button>


                <!-- PAGE NUMBERS -->

                @for (var page = 1; page <= TotalPages; page++)
                {
                    var pageNumber = page;

                    <button type="button"
                            class="btn btn-sm @(CurrentPage == pageNumber
                                ? "btn-primary"
                                : "btn-light")"
                            @onclick="() => GoToPage(pageNumber)">

                        @pageNumber

                    </button>
                }


                <!-- NEXT -->

                <button type="button"
                        class="btn btn-sm btn-light"
                        disabled="@(CurrentPage >= TotalPages)"
                        @onclick="NextPage">

                    Weiter ›

                </button>

            </div>

        </div>
    }

</div>


@code {

    // =========================================================
    // DATA
    // =========================================================

    private List<Employee> employees = [];

    private Employee form = new();

    private Guid companyId;

    private int limit;

    private bool showForm;

    private string search = "";

    private string initialPassword = "";

    private string messageType = "warning";

    private string? message;


    // =========================================================
    // PAGINATION
    // =========================================================

    private const int PageSize = 10;

    private int CurrentPage = 1;


    // =========================================================
    // LIVE SEARCH
    // =========================================================

    private IEnumerable<Employee> FilteredEmployees =>employees.Where(x =>string.IsNullOrWhiteSpace(search) || $"{x.FirstName} {x.LastName} {x.Email} {x.Position} {x.Phone}".Contains(search.Trim(),StringComparison.OrdinalIgnoreCase));


    // =========================================================
    // PAGED EMPLOYEES
    // =========================================================

    private IEnumerable<Employee> PagedEmployees =>
        FilteredEmployees
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize);


    // =========================================================
    // TOTAL PAGES
    // =========================================================

    private int TotalPages =>Math.Max(1,(int)Math.Ceiling(FilteredEmployees.Count() /(double)PageSize));


    // =========================================================
    // SEARCH
    // =========================================================

    private void OnSearch(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? "";

        // Bei neuer Suche immer auf Seite 1

        CurrentPage = 1;
    }


    // =========================================================
    // GO TO PAGE
    // =========================================================

    private void GoToPage(int page)
    {
        if (page < 1)
            page = 1;

        if (page > TotalPages)
            page = TotalPages;

        CurrentPage = page;
    }


    // =========================================================
    // PREVIOUS PAGE
    // =========================================================

    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }


    // =========================================================
    // NEXT PAGE
    // =========================================================

    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }


    // =========================================================
    // INITIALIZE
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        var id = await CurrentCompany.GetCompanyIdAsync();

        if (!id.HasValue)
        {
            message = "Keine Firma gefunden.";
            messageType = "danger";
            return;
        }


        companyId = id.Value;


        var company = await Db.Companies
            .AsNoTracking()
            .SingleOrDefaultAsync(
                x => x.Id == companyId);


        if (company is null)
        {
            message = "Firma wurde nicht gefunden.";
            messageType = "danger";
            return;
        }


        limit = company.SubscriptionPlan switch
        {
            SubscriptionPlan.S => 5,
            SubscriptionPlan.M => 10,
            SubscriptionPlan.L => 20,
            _ => 200
        };


        await Load();
    }


    // =========================================================
    // LOAD
    // =========================================================

    private async Task Load()
    {
        employees = await Db.Employees

            .AsNoTracking()

            .Where(x =>
                x.CompanyId == companyId)

            .OrderBy(x => x.LastName)

            .ThenBy(x => x.FirstName)

            .ToListAsync();


        // Nach Reload sicherstellen,
        // dass aktuelle Seite noch existiert

        if (CurrentPage > TotalPages)
        {
            CurrentPage = TotalPages;
        }

        if (CurrentPage < 1)
        {
            CurrentPage = 1;
        }
    }


    // =========================================================
    // NEW
    // =========================================================

    private async Task New()
    {
        var id = await CurrentCompany.GetCompanyIdAsync();

        if (!id.HasValue)
        {
            message = "Keine Firma gefunden.";
            messageType = "danger";
            return;
        }


        companyId = id.Value;


        if (employees.Count >= limit)
        {
            message =
                "Dein aktuelles Paket hat die Mitarbeitergrenze erreicht.";

            messageType = "warning";

            return;
        }


        form = new Employee
        {
            Id = Guid.Empty,

            CompanyId = companyId,

            IsActive = true
        };


        initialPassword = "";

        showForm = true;

        message = null;
    }


    // =========================================================
    // EDIT
    // =========================================================

    private async Task Edit(Employee employee)
    {
        var id = await CurrentCompany.GetCompanyIdAsync();

        if (!id.HasValue)
        {
            message = "Keine Firma gefunden.";
            messageType = "danger";
            return;
        }


        companyId = id.Value;


        if (employee.CompanyId != companyId)
        {
            message = "Zugriff verweigert.";
            messageType = "danger";
            return;
        }


        form = new Employee
        {
            Id = employee.Id,

            CompanyId = companyId,

            FirstName = employee.FirstName,

            LastName = employee.LastName,

            Phone = employee.Phone,

            Email = employee.Email,

            Position = employee.Position,

            IsActive = employee.IsActive,

            CreatedAt = employee.CreatedAt,

            ApplicationUserId =
                employee.ApplicationUserId
        };


        initialPassword = "";

        showForm = true;

        message = null;
    }


    // =========================================================
    // SAVE
    // =========================================================

    private async Task Save()
    {
        message = null;


        // =====================================================
        // CURRENT COMPANY
        // =====================================================

        var id =
            await CurrentCompany.GetCompanyIdAsync();

        if (!id.HasValue)
        {
            message = "Keine Firma gefunden.";
            messageType = "danger";
            return;
        }


        companyId = id.Value;


        // =====================================================
        // VALIDATION
        // =====================================================

        if (string.IsNullOrWhiteSpace(form.FirstName) ||
            string.IsNullOrWhiteSpace(form.LastName) ||
            string.IsNullOrWhiteSpace(form.Email))
        {
            message =
                "Vorname, Nachname und E-Mail sind erforderlich.";

            messageType = "warning";

            return;
        }


        form.FirstName =
            form.FirstName.Trim();

        form.LastName =
            form.LastName.Trim();

        form.Email =
            form.Email.Trim().ToLowerInvariant();


        // =====================================================
        // NEW EMPLOYEE
        // =====================================================

        if (form.Id == Guid.Empty)
        {
            var currentEmployeeCount =
                await Db.Employees
                    .CountAsync(x =>
                        x.CompanyId == companyId);


            if (currentEmployeeCount >= limit)
            {
                message =
                    "Die Mitarbeitergrenze deines Pakets ist erreicht.";

                messageType = "warning";

                return;
            }


            // =================================================
            // PASSWORD
            // =================================================

            if (string.IsNullOrWhiteSpace(initialPassword) ||
                initialPassword.Length < 6)
            {
                message =
                    "Bitte ein Start-Passwort mit mindestens 6 Zeichen vergeben.";

                messageType = "warning";

                return;
            }


            // =================================================
            // EMAIL CHECK
            // =================================================

            var existingUser =
                await UserManager.FindByEmailAsync(
                    form.Email);


            if (existingUser is not null)
            {
                message =
                    "Diese E-Mail-Adresse wird bereits verwendet.";

                messageType = "warning";

                return;
            }


            // =================================================
            // CREATE USER
            // =================================================

            var user = new ApplicationUser
            {
                UserName = form.Email,

                Email = form.Email,

                EmailConfirmed = true,

                CompanyId = companyId
            };


            var result =await UserManager.CreateAsync(user,initialPassword);


            if (!result.Succeeded)
            {
                message =string.Join(" ",result.Errors.Select(x => x.Description));

                messageType = "danger";

                return;
            }


            // =================================================
            // ROLE
            // =================================================

            if (!await RoleManager.RoleExistsAsync(
                "Mitarbeiter"))
            {
                var roleResult =
                    await RoleManager.CreateAsync(
                        new IdentityRole(
                            "Mitarbeiter"));


                if (!roleResult.Succeeded)
                {
                    await UserManager.DeleteAsync(
                        user);

                    message ="Die Rolle 'Mitarbeiter' konnte nicht erstellt werden: " +string.Join(" ",roleResult.Errors.Select(x => x.Description));

                    messageType = "danger";

                    return;
                }
            }


            var userRoleResult = await UserManager.AddToRoleAsync(user,"Mitarbeiter");


            if (!userRoleResult.Succeeded)
            {
                await UserManager.DeleteAsync(user);

                message ="Die Rolle 'Mitarbeiter' konnte nicht zugewiesen werden: " +string.Join( " ",userRoleResult.Errors.Select(x => x.Description));

                messageType = "danger";

                return;
            }


            // =================================================
            // CREATE EMPLOYEE
            // =================================================

            form.Id = Guid.NewGuid();

            form.CompanyId = companyId;

            form.ApplicationUserId = user.Id;

            form.CreatedAt = DateTime.UtcNow;


            Db.Employees.Add(form);

            await Db.SaveChangesAsync();


            message =
                "Mitarbeiter wurde erfolgreich erstellt. " +
                "Der Mitarbeiter wurde automatisch der Rolle " +
                "'Mitarbeiter' zugewiesen und kann sich jetzt " +
                "mit seiner E-Mail-Adresse anmelden.";

            messageType = "success";


            showForm = false;

            initialPassword = "";


            await Load();

            return;
        }


        // =====================================================
        // UPDATE EXISTING EMPLOYEE
        // =====================================================

        var existingEmployee =
            await Db.Employees
                .FirstOrDefaultAsync(x =>
                    x.Id == form.Id &&
                    x.CompanyId == companyId);


        if (existingEmployee is null)
        {
            message =
                "Mitarbeiter wurde nicht gefunden.";

            messageType = "danger";

            return;
        }


        // =====================================================
        // UPDATE EMPLOYEE
        // =====================================================

        existingEmployee.FirstName =
            form.FirstName;

        existingEmployee.LastName =
            form.LastName;

        existingEmployee.Phone =
            form.Phone;

        existingEmployee.Email =
            form.Email;

        existingEmployee.Position =
            form.Position;

        existingEmployee.IsActive =
            form.IsActive;


        await Db.SaveChangesAsync();


        // =====================================================
        // UPDATE LOGIN
        // =====================================================

        if (!string.IsNullOrWhiteSpace(
            existingEmployee.ApplicationUserId))
        {
            var user =
                await UserManager.FindByIdAsync(
                    existingEmployee.ApplicationUserId);


            if (user is not null)
            {
                if (user.CompanyId != companyId)
                {
                    message =
                        "Zugriff auf diesen Benutzer wurde verweigert.";

                    messageType = "danger";

                    return;
                }


                user.Email =
                    form.Email;

                user.UserName =
                    form.Email;


                await UserManager.UpdateAsync(
                    user);
            }
        }


        message =
            "Mitarbeiter wurde gespeichert.";

        messageType = "success";


        showForm = false;

        initialPassword = "";


        await Load();
    }


    // =========================================================
    // CLOSE FORM
    // =========================================================

    private void CloseForm()
    {
        showForm = false;

        message = null;

        initialPassword = "";

        form = new Employee();
    }


    // =========================================================
    // DELETE
    // =========================================================

    private async Task Delete(Employee employee)
    {
        var id =
            await CurrentCompany.GetCompanyIdAsync();

        if (!id.HasValue)
        {
            message = "Keine Firma gefunden.";
            messageType = "danger";
            return;
        }


        companyId = id.Value;


        var employeeFromDb =
            await Db.Employees
                .FirstOrDefaultAsync(x =>
                    x.Id == employee.Id &&
                    x.CompanyId == companyId);


        if (employeeFromDb is null)
        {
            message =
                "Mitarbeiter wurde nicht gefunden.";

            messageType = "danger";

            return;
        }


        var applicationUserId =
            employeeFromDb.ApplicationUserId;


        // =====================================================
        // DELETE EMPLOYEE
        // =====================================================

        Db.Employees.Remove(
            employeeFromDb);

        await Db.SaveChangesAsync();


        // =====================================================
        // DELETE IDENTITY USER
        // =====================================================

        if (!string.IsNullOrWhiteSpace(
            applicationUserId))
        {
            var user =
                await UserManager.FindByIdAsync(
                    applicationUserId);


            if (user is not null)
            {
                if (user.CompanyId == companyId)
                {
                    await UserManager.DeleteAsync(
                        user);
                }
            }
        }


        message =
            "Mitarbeiter wurde gelöscht.";

        messageType = "success";


        await Load();
    }


    // =========================================================
    // INITIALS
    // =========================================================

    private static string Initials(
        Employee employee)
    {
        var first =
            employee.FirstName
                .FirstOrDefault();

        var last =
            employee.LastName
                .FirstOrDefault();

        return $"{first}{last}"
            .ToUpperInvariant();
    }

}